    Nova: {
        Name: Взрыв кольца
        Description: Создаёт вокруг вас ударную волну, урон которой зависит от используемого магического оружия
    }

    Berserk: {
        Name: Берсерк
        Description: Вы наносите на 150% больше урона в ближнем бою, но каждый полученный удар наносит вам на 5 единиц больше урона
    }

    RainOfArrows: {
        Name: Залп
        Description: После небольшой задержки выпускает в сторону курсора шквал снарядов, тип которых зависит от используемого стрелкового оружия
    }

    MoltenShield: {
        Name: Расплавленный панцирь
        Description: Даёт временный запас здоровья, поглощающий 75% входящего урона вплоть до своего разрушения
    }

    BloodSiphon: {
        Name: Кровавое вытягивание здоровья
        Description: Поглощает все стаки дебаффа «{$Buffs.BloodclotDebuff.DisplayName}» на враге, восстанавливая 3 единицы здоровья за каждый стак. Максимум 30 стаков
    }

    FetidCarapace: {
        Name: Зловонный панцирь
        Description: Призывает несколько вращающихся вокруг вас снарядов, защищающих от врагов и их снарядов
    }

    Fireball: {
        Name: Огненный шар
        Description: Выпускает мощный взрывающийся огненный шар, способный воспламенить врагов
    }

    IceBolt: {
        Name: Ледяной заряд
        Description: Выпускает ледяной заряд, накладывающий дебафф «{$BuffName.Chilled}» на любого поражённого врага
    }

    FlameSage: {
        Name: Огненный мудрец
        Description:
            '''
            Призывает огненного стража, отвлекающего внимание врагов на себя
            Одновременно может существовать не более двух стражей
            '''
    }

    Swarm: {
        Name: Рой вредителей
        Description: Призывает временное существо, сражающееся на вашей стороне и автоматически атакующее врагов
    }
}

SkillSpecials: {
    OneLine: Можно выбрать только одну специализацию умения

    FireNova: {
        Name: Огненная вспышка
        Description: Создаёт ауру пламени, урон которой зависит от урона магического оружия в руках и накладывает дебафф «{$BuffName.OnFire}»
    }

    IceNova: {
        Name: Ледяная волна
        Description: Создаёт ледяную волну, урон которой зависит от урона магического оружия в руках и накладывает дебафф «{$BuffName.Chilled}»
    }

    LightningNova: {
        Name: Громовой разряд
        Description:
            '''
            Создаёт электрический импульс, урон которого зависит от урона магического оружия в руках
            Поражает врагов в более широком радиусе и накладывает дебафф «{$Buffs.ShockDebuff.DisplayName}»
            '''
    }

    NaturesBarrage: {
        Name: Залп природы
        Description: Пропитывает наконечники стрел ядом, отравляющим врагов
    }

    ExplosiveVolley: {
        Name: Взрывной залп
        Description: Стрелы взрываются, поражая значительно большую область
    }

    PiercingPrecision: {
        Name: Пробивающая точность
        Description: Заменяет шквал отложенным залпом с увеличенным пробиванием брони
    }

    Flamethrower: {
        Name: Огнемёт
        Description: Призывает огненного стража, наносящего непрерывный урон врагам в небольшом радиусе
    }

    MoltenSentinel: {
        Name: Раскалённый страж
        Description: Призывает огненного стража, наносящего непрерывный урон врагам вокруг себя
    }

    VolatileConstruct: {
        Name: Нестабильная конструкция
        Description: Призывает огненного стража, который взрывается через {0} секунды, нанося дополнительный урон, зависящий от оставшегося здоровья
    }

    AntlionSwarm: {
        Name: Летучие муравьиные львы
        Description: Снижает максимальное количество насекомых вдвое, но они начинают летать и наносят больше урона
    }

    LocustBrood: {
        Name: Выводок саранчи
        Description: Удваивает количество насекомых; все они появляются одновременно в виде яиц и вылупляются через некоторое время
    }

    GlacialAntlions: {
        Name: Леденящие муравьиные львы
        Description: Муравьиные львы наносят 100% урона холодом
    }

    Inferno: {
        Name: Инферно
        Description: Огненные шары всегда накладывают дебафф «{$Buffs.IgnitedDebuff.DisplayName}»
    }

    FrostfireMeteor: {
        Name: Метеоры морозного пламени
        Description: Огненные шары заменяются направляемыми метеорами, наносящими урон [mechanic/shift=0;2:Cold::холодом] и [mechanic/shift=1;2:Fire::огнём]
    }

    ShadowflamePyre: {
        Name: Погребальное теневое пламя
        Description: Теперь огненный шар летит по дуге, оставляя за собой погребальное теневое пламя, наносящее урон [mechanic/shift=0;2:Chaos::хаосом] и [mechanic/shift=1;2:Fire::огнём], и накладывает дебафф «{$Buffs.EverburningShadowflameDebuff.DisplayName}»
    }
}

Subworlds: {
    DefaultMining: "[i:1] Можно добывать только факелы и верёвки"
    DefaultPlacing: "[i:2] Можно размещать только факелы и верёвки"
    AllMining: "[i:1] Можно добывать что угодно"
    Entering: Переход в:
    Exiting: Возвращение в родной мир

    CultistDomain: {
        DisplayName: Далёкая Темница
        Description: Найдите 4 фрагмента древней скрижали, чтобы призвать Культиста.
        Mining: "[i:1] Можно добывать факелы, верёвки и фрагменты древней скрижали"
        Placing: "{$DefaultPlacing}"
    }

    DestroyerDomain: {
        DisplayName: Порождённый город
        Description: Соберите механические приводы, необходимые для создания механического чипа, чтобы призвать Уничтожителя.
        Mining: "[i:1] Можно добывать факелы, верёвки и эбонит [i:61]"
        Placing: "{$DefaultPlacing}"
    }

    EmpressDomain: {
        DisplayName: Сверкающее плато
        Description: Пробейтесь сквозь волны сверкающих, ликующих врагов, чтобы бросить вызов Императрице света.
        Mining: "{$DefaultMining}"
        Placing: "{$DefaultPlacing}"
    }

    FishronDomain: {
        DisplayName: Трюфельные пруды
        Description: Уничтожьте светящиеся грибы в глубинах, чтобы призвать величественного и ненасытного Герцога Рыброна.
        Mining: "[i:1] Можно добывать факелы, верёвки и ростки трюфеля"
        Placing: "{$DefaultPlacing}"
    }

    GolemDomain: {
        DisplayName: Храм истоков
        Description: Спуститесь в самый первый храм яхщеров и одолейте Голема.
        Mining: "{$DefaultMining}"
        Placing: "{$DefaultPlacing}"
    }

    MoonLordDomain: {
        DisplayName: Лунные миазмы
        Description: Поднимитесь из глубоких недр земли, чтобы одолеть Лунного лорда.
        Mining: "{$AllMining}, но предметы не выпадают"
        Placing: "{$DefaultPlacing}"
    }

    PlanteraDomain: {
        DisplayName: Дремлющие джунгли
        Description: Следуйте за цветами, чтобы отыскать Плантеру.
        Mining: "{$AllMining}"
        Placing: "{$DefaultPlacing}"
    }

    PrimeDomain: {
        DisplayName: Глубинные механизмы
        Description: Пройдите через четыре величественных зала этого механизма и бросьте вызов Скелетрону Прайму.
        Mining: "{$DefaultMining}"
        Placing: "{$DefaultPlacing}"
    }

    QueenSlimeDomain: {
        DisplayName: Возносящиеся пустоты
        Description: Найдите проход сквозь хрупкие кристаллы во владения Королевы слизней.
        Mining: "[i:1] Можно добывать факелы, верёвки и хрупкий кристалл [i:PathOfTerraria/BrittleCrystalItem]"
        Placing: "{$DefaultPlacing}"
    }

    TwinsDomain: {
        DisplayName: Лаборатория бездны
        Description: Взобравшись через искажение, отыщите скрытый в механизме рычаг, чтобы бросить вызов Близнецам.
        Mining: "{$DefaultMining}"
        Placing: "{$DefaultPlacing}"
    }

    BrainDomain: {
        DisplayName: Восходящие ступени над багрянцем
        Description: Войдите в портал на вершине величественной лестницы, чтобы сразиться с Мозгом Ктулху.
        Mining: "{$DefaultMining}"
        Placing: "{$DefaultPlacing}"
        Extra: "[i:53] Таинственная сила дарует вам три дополнительных прыжка в воздухе"
    }

    DeerclopsDomain: {
        DisplayName: Мрачные ледяные пустоши
        Description: Следуйте за светом к поверхности, где правит Циклоп-олень.
        Mining: "[i:1] Можно добывать факелы, верёвки и тонкий лёд"
        Placing: "{$DefaultPlacing}"
    }

    EaterDomain: {
        DisplayName: Гноящиеся расщелины
        Description: Спуститесь в расщелины, прорубая себе путь сквозь миазмы, чтобы покорить Пожирателя миров.
        Mining: "[i:1] Можно добывать факелы, верёвки и фиолетовые светящиеся миазмы"
        Placing: "{$DefaultPlacing}"
    }

    EyeDomain: {
        DisplayName: Обитель плоти
        Description: Проберитесь к месту упокоения Глаза Ктулху и одолейте его.
        Mining: "{$DefaultMining}"
        Placing: "{$DefaultPlacing}"
    }

    KingSlimeDomain: {
        DisplayName: Пропитанное слизью убежище
        Description: Проберитесь сквозь слизь и камни к роскошной арене Короля слизней.
        Mining: "{$DefaultMining}"
        Placing: "{$DefaultPlacing}"
    }

    QueenBeeDomain: {
        DisplayName: Роскошные ульи
        Description: Соберите сгустки королевского мёда в ульях Королевы пчёл, создайте из них королевское желе и используйте его, чтобы выманить её.
        Mining: "[i:1] Можно добывать факелы, верёвки и сгустки королевского желе [i:PathOfTerraria/RoyalJellyClump]"
        Placing: "{$DefaultPlacing}"
    }

    SkeletronDomain: {
        DisplayName: Темница оборванных проводов
        Description: Исследуйте коварную темницу, чтобы избавить Скелетрона от его собственного проклятия.
        Mining: "{$DefaultMining}"
        Placing: "{$DefaultPlacing}"
    }

    WallOfFleshDomain: {
        DisplayName: Преисподняя
        Description: Преодолейте лаву, пепел и плоть, чтобы перерезать верёвку, удерживающую Куклу вуду гида, и окончательно разрушить магические узы Стены плоти.
        Mining: "[i:1] Можно добывать факелы, верёвки и любые платформы [i:94]"
        Placing: "[i:2] Можно размещать факелы, верёвки и любые платформы [i:94]"
    }

    DesertArea: {
        DisplayName: Выжженная солнцем пустыня
        Description: Исследуйте раскалённые пески, чтобы бросить вызов Пожирателю солнца.
        Mining: "{$DefaultMining}"
        Placing: "{$DefaultPlacing}"
    }

    ForestArea: {
        DisplayName: Заросшая роща
        Description: Исследуйте гигантские деревья, лишённые солнечного света, и одолейте Старейшего Хранителя рощи.
        Mining: "{$DefaultMining}"
        Placing: "{$DefaultPlacing}"
    }

    RavencrestSubworld: {
        DisplayName: Вороний Пик
        Description: Общайтесь с жителями, выполняйте задания, закупайтесь у различных торговцев и не забудьте перебить гоблинов по пути.
        Mining: "{$DefaultMining}"
        Placing: "{$DefaultPlacing}"
    }

    SwampArea: {
        DisplayName: Поросшее мхом болото
        Description: Прыгайте по плавающим объектам, пробирайтесь сквозь рои злобных насекомых и исследуйте густые кроны деревьев, чтобы сразиться с Болотным боссом.
        Mining: "{$DefaultMining}"
        Placing: "{$DefaultPlacing}"
    }

    InfernalRealm: {
        DisplayName: Адское царство
        Description: Вы обнаружили исток адских разломов. Одолейте правителя этого дьявольского царства!
        Mining: "{$DefaultMining}"
        Placing: "{$DefaultPlacing}"
    }
}

