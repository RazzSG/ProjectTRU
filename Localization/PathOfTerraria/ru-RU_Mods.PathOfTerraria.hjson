Configs: {
    DeveloperConfig: {
        DisplayName: Настройки для разработчиков [i:509]

        DrawUIBorders: {
            Label: Отображать границы интерфейса
            Tooltip: Отображает рамки вокруг элементов интерфейса, что помогает отладить их расположение.
        }

        SaveSubworlds: {
            Label: Сохранение подмиров
            Tooltip: Если эта настройка включена, данные подмиров сохраняются. Полезно для их тестирования.
        }

        LogFilterRejections: {
            Label: Лог отклонённых предметов фильтром
            Tooltip:
                '''
                Если эта настройка включена, каждый предмет, отклонённый активным фильтром, будет выводить сообщение в чат
                и записываться в Mod.Logger с указанием фильтра, предмета и причины отклонения.
                Только для отладочных сборок.
                '''
        }
    }

    UIConfig: {
        DisplayName: Настройки интерфейса
        Headers.UI: Интерфейс

        DisplayRichTooltipsInHotbar: {
            Label: Расширенное описание на панели быстрого доступа
            Tooltip: Если эта настройка включена, при наведении на предметы на панели быстрого доступа будет отображаться полное описание, а не только их названия.
        }

        PreventExpBarClicking: {
            Label: Отключить нажатие по шкале опыта
            Tooltip:
                '''
                Если эта настройка включена, меню повышения уровня нельзя открыть нажатием на шкалу опыта — только с помощью горячей клавиши.
                Это полезно, если вы случайно открываете это меню, пытаясь взаимодействовать с другими элементами интерфейса.
                '''
        }

        UseVirtualBag: {
            Label: Использовать мешок хранения
            Tooltip: Позволяет использовать мешок хранения во владениях для более удобного управления инвентарём.
        }

        ShowLootBeams: {
            Label: Отображать лучи над добычей
            Tooltip: Если эта настройка включена, правила подсветки фильтра предметов будут отображать световые лучи над подходящими выпавшими предметами.
        }
    }

    GameplayConfig: {
        DisplayName: Настройки игрового процесса
        Headers.Gameplay: Игровой процесс

        NearbyAuras: {
            Label: Ауры поблизости
            Tooltip:
                '''
                Если эта настройка включена, вокруг миньонов будет отображаться аура при использовании пассивного навыка «Аура урона миньонов».
                В будущем эта настройка может повлиять и на другие ауры.
                '''
        }
    }
}

