Quests: {
    Popups: {
        Line1: Откройте Книгу заданий, чтобы увидеть прогресс и этапы текущих заданий.
        Line2: Книга заданий всегда находится рядом с картой в инвентаре.
        Line3: Вы также можете нажать {0}, чтобы открыть Книгу заданий.
        NoKey: (Не назначено — по умолчанию L)
        NewQuest: Новое задание:
    }

    Bring: {
        Collect: Собрать
        GiveItTo: и отдать {0}
    }

    Skip: Пропустить?
    Sure: Уверены?
    TalkTo: Поговорить с {0}{r0:Гаррик=Гарриком;Пайра Когврайт=Пайрой Когврайт;Траин Железнорук=Траином Железноруком;Аларик=Алариком;Моргана=Морганой;Элара=Эларой;Элдрик=Элдриком;Старик=Стариком;Райн=Райной;Портной=Портным}
    GiveThem: " и отдать:"
    Exploration.Ice: Исследовать снега ({0}%)
    Or: " или "

    Quest: {
        BlacksmithStartQuest: {
            Name: Ковка нового клинка
            Description: ""
            Kill.Zombies: Убить зомби ({0}/{1})
        }

         KingSlimeQuest: {
            Name: Свержение Короля
            Description: ""
            EnterDomain: Войти во владения Короля
            ThanksDialogue: С трудом верится. Что ж, незнакомец, ты преуспел там, где я потерпел неудачу. Мне пора возвращаться к делу; впредь я тебе не уступлю. Но всё же... я должен тебя поблагодарить.
            Kill.KingSlime: Одолеть Короля слизней
        }

        HunterStartQuest: {
            Name: Натяжение тетивы
            Description: ""
            Kill.FloatingMisc: Убить {0} демонических глаз, кример или пожирателей душ
        }

        WitchStartQuest: {
            Name: Древнее искусство
            Description: ""
        }

        WizardStartQuest: {
            Name: Магическое возвращение
            Description: ""
            KillScout: Убить гоблина-разведчика в обычном мире
            KillSurveyor: Убить гоблина-изыскателя в левой части Вороньего Пика
        }

        EoCQuest: {
            Name: Восходящее знамение
            Description: ""
            Kill.EoC: Одолеть Глаз Ктулху
        }

        EoWQuest: {
            Name: Шёпот глубин
            Description: ""
            MorvenRaven: Сопроводить Морвена к статуе ворона
            SmashOrbs: Разбить 3 теневые сферы
            KillEoW: Одолеть Пожирателя миров
            ReturnToOverworld: Вернуться в обычный мир
            MorvenDialogue: Хм... О, здравствуй, незнакомец. Спасибо, что вытащил меня из этой передряги. Боюсь, я спустился сюда, чтобы выследить помеченных мной пожирателей... Впрочем, неважно. Мои верные инструменты подвели меня, и я каким-то образом оказался замурованным в этом зловонном камне. Я провёл здесь несколько мучительных часов. Не будешь ли ты так любезен проводить меня наружу и привести к статуе ворона? Я щедро вознагражу тебя… ну или постараюсь.
            EnterEvilBiome: Найти учёного в подземном искажении
        }

        BoCQuest: {
            Name: Бьющееся сердце
            Description: ""
            SmashOrb: Пусть Ллойд разобьёт багряное сердце
            EnterDomain: Войти в обитель Мозга Ктулху
            KillBrain: Одолеть Мозг Ктулху
        }

        QueenBeeQuest: {
            Name: Королевское приключение
            Description: ""
            KillQueen: Одолеть Королеву пчёл
            EnterDomain: Погрузите призванного шершня из вашего Гримуара в мёд
        }

        DeerclopsQuest: {
            Name: Ледяное чудовище
            Description: ""
            KillDeerclops: Одолеть Циклопа-оленя
            GetAntlersOrShards: странные рога или осколок рога
        }

        SkeletronQuest: {
            Name: Костяные останки
            Description: ""
            EnterDomain: Войти во владения Скелетрона
            KillSkeletron: Одолеть Скелетрона
        }

        WoFQuest: {
            Name: Высвобождение хаоса
            Description: ""
            WizardStart: Хм... да. Земля глубоко под нами содрогается от мощи того, кого когда-то запечатали. Видишь ли, давным-давно группа отважных искателей приключений заточила древнее зло в искусственную оболочку. Однако из-за твоей невероятной силы, с которой ты истребляешь тварей по всему миру, эта мощь, похоже, просочилась к запечатанному злу. Проще говоря — его нужно уничтожить. Поговори с Траином, Морганой и Эларой как можно скорее. Они знают, что к чему, и дадут тебе оружие. Возьми это — и да поможет тебе бог. За это можешь поблагодарить Моргану. Только... не задавай лишних вопросов. У нас тут дел по горло!
            ThrainHelp: Ох. Значит, началось. Держи... Я готовился к этому дню. Надеюсь, это оружие тебе сгодится. Аларик помог мне с ним — оно хранит воспоминания о моих битвах. Дерзай. Удачи.
            ElaraHelp: Береги себя и возьми вот это. Я не искусная оружейница, но Траин помог мне с ковкой. Всё просто и надёжно. И помни: глаза — самое уязвимое место.
            MorganaHelp: О-о-о?.. Ба-ха-ха! Время пришло! Держи, тут целая россыпь материалов для Гримуара! Элара помогла с этими существами... весьма сведущая барышня, скажу я тебе! Наслаждайся моими дарами! Ба-ха-ха-ха!
            WizardContinue: Держи. Ну же, бери. Это... да... взрывчатка, но так уж оно работает. Клянусь! Брось её на пепелище преисподней, чтобы открыть портал в место, где была заточена Стена плоти. Учти: у тебя будет лишь один шанс победить её — без права на ошибку. Мы не знаем, что произойдёт после её смерти. Будущее туманно, ясно лишь одно — она должна умереть. Удачи. Если понадобится ещё — я могу призвать ещё пару штук... за небольшую плату! Прости — торговля есть торговля!
            KillWall: Одолеть Стену плоти
            WizardFinish: Ты вернулся! Мы видим, как многое изменилось, но земля под ногами больше не будет содрогаться. Готовься к будущему, нам предстоит многое узнать. Особенно мне, ведь у меня появилось... много всего, что нужно опробовать.
        }

        FirstQuest: {
            Name: Вход в Вороний Пик
            Description: ""
            ApproachEntrance: Подойди ко входу в Вороний Пик
            EnterRavencrest: Войти в Вороний Пик
        }

