            AcidGun: {
                DisplayName: Кислотная пушка
                Tooltip: Выпускает три струи кислоты
            }
            
            AetherfluxCannon: {
                DisplayName: Пушка эфирного потока
                Tooltip: Выпускает сфокусированную фотонную спираль, пронзающую всё на своём пути
            }
            
            AethersWhisper: {
                DisplayName: Шёпот эфира
                Tooltip:
                    '''
                    Снаряды накладывают дебафф [cbuff:CalamityMod/Shadowflame] и разделяются при столкновении с блоками
                    Урон снарядов увеличивается во время полёта
                    '''
            }
            
            AlulaAustralis: {
                DisplayName: Алула Астралис
                Tooltip: Призывает ослепительное сияние, накладывающее дебафф [cbuff:CalamityMod/AstralInfectionDebuff], за которым следует звёздный ливень
            }
            
            AlphaDraconis: {
                DisplayName: Альфа Дракона
                Tooltip:
                    '''
                    Обрушивает метеоритный дождь в направлении курсора
                    При попадании иногда создаёт звёздные вспышки, которые можно подобрать
                    Нажмите <right>, имея достаточно вспышек, чтобы призвать защитного драко
                    Драко постепенно расходует звёздные вспышки; его можно отозвать повторным нажатием <right>
                    Атаки драко накладывают дебафф [cbuff:CalamityMod/Voidfrost]
                    'Подражание безумию'
                    '''
            }
            
            AnahitasArpeggio: {
                DisplayName: Арпеджио Анахиты
                Tooltip:
                    '''
                    Удерживайте <left>, чтобы создать до 6 скрипичных ключей, вращающихся вокруг вас
                    Отпустите <left>, чтобы ключи сошлись в точке курсора и начали следовать за ним
                    '''
                TooltipGFB:
                    '''
                    'НЕТ, НЕТ, НЕТ!
                    Вы должны подчиняться МНЕ!!!'
                    Семь душ скрипичных ключей:
                    '''
