                    '''
            }
            
            RainbowPartyCannon: {
                DisplayName: Радужная вечериночная пушка
                Tooltip: "'Видишь радугу - вспомни: только вместе мы будем сиять'"
            }
            
            Rancor: {
                DisplayName: Вражда
                Tooltip:
                    '''
                    Сотворяет магический круг, накапливающий энергию и со временем выпускающий мощный управляемый поток зловещей магии
                    При соприкосновении лазера с поверхностью на ней появляются руки и обжигающая лава
                    '''
                Calamitas:
                    '''
                    'Ярим убедил меня, что Ото'Нилу натравила Серного элементаля на Азафур
                    Тогда я верила ему - ребёнку был нужен виноватый во всех бедах
                    Я обрушила на них всю свою ярость, считая её справедливой, и лишь когда стало слишком поздно, осознала масштаб его лжи'
