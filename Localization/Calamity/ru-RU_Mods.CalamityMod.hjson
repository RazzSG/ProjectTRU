            GastricBelcherStaff: {
                DisplayName: Посох желудочного изрыгателя
                Tooltip:
                    '''
                    Призывает акватическую аномалию
                    Аномалия плюётся рвотой в ближайших врагов и выпускает пузыри при каждой третьей атаке
                    '''
            }
            
            GlacialEmbrace: {
                DisplayName: Леденящие объятья
                Tooltip:
                    '''
                    Призывает силу древнего ледяного замка
                    За каждый использованный слот миньонов вы получаете дополнительный вращающийся защитный шип
                    Эти шипы с огромной скоростью устремляются к ближайшему врагу и наносят серьёзный урон
                    Однако после атаки им требуется некоторое время на восстановление
                    При нажатии <right> создаёт дублирующее кольцо шипов вокруг выбранной цели, которое медленно сжимается, а затем взрывается
                    '''
            }
            
            GuidelightofOblivion: {
                DisplayName: Путеводный свет забвения
                Tooltip:
                    '''
