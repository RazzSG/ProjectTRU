            Endogenesis: {
                DisplayName: Эндогенез
                Tooltip:
                    '''
                    Призывает возвышенную ледяную конструкцию, которая защищает вас
                    Режим атаки меняется при повторном призыве или использовании посоха
                    В первом режиме выпускает рассеивающие лазеры, нацеленные на врагов
                    Во втором режиме жертвует своими конечностями, превращая их в самонаводящиеся снаряды
                    В третьем режиме яростно таранит врагов
                    В четвёртом режиме превращает конечности в эндотермические огнемёты
                    Для призыва требуется 10 слотов миньонов
                    Одновременно может существовать только одна конструкция
                    [c/B0FBFF:'Шутки про лёд в комплект не входят']
                    '''
            }
            
            EndoHydraStaff: {
