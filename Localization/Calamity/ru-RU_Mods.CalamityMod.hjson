    }
    
    CalamitasClone: {
        SpawnInfo: Используйте [i:CalamityMod/EyeofDesolation] ночью.
        DespawnMessage: "[c/FFA500:Клон сплёвывает от разочарования немного крови и исчезает.]"
    }
    
    CeaselessVoid: {
