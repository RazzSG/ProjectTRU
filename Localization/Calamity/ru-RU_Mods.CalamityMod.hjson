Configs: {
    CalamityClientConfig: {
        DisplayName: Клиентская конфигурация
        
        Headers: {
            Gameplay: Общие геймплейные изменения
            Graphics: Графические изменения
            MeterPositions: Позиции шкал
            UI: Изменения пользовательского интерфейса
            MusicToggles: Переключатели музыки
        }
        
        AbyssLayer3Alt: {
            Label: "[i:CalamityModMusic/AbyssLayer3AltMusicBox] Альтернативная тема 3 слоя бездны"
            Tooltip: Проигрывает Calamity Mod OST — «R'lyehian Depths», пока вы находитесь в слое термальных жерл бездны.
        }
        
        AdrenalineMeterPosX: {
            Label: "[i:LaserRuler] Позиция по X шкалы адреналина"
            Tooltip:
                '''
                Позиция по X шкалы адреналина, измеряется в % от ширины экрана.
                Шкалу можно перетаскивать мышью, если отключена настройка «Фиксация позиций шкал».
                '''
        }

        AdrenalineMeterPosY: {
            Label: "[i:LaserRuler] Позиция по Y шкалы адреналина"
            Tooltip:
                '''
                Позиция по Y шкалы адреналина, измеряется в % от высоты экрана.
                Шкалу можно перетаскивать мышью, если отключена настройка «Фиксация позиций шкал».
                '''
        }

        Afterimages: {
            Label: "[i:SteampunkGoggles] Послеобразы"
            Tooltip:
                '''
                Включает отображение послеобразов для существ Calamity, снарядов и т.д.
                Отключите для повышения производительности.
                '''
        }
        
        BossHealthBarExtraInfo: {
            Label: "[i:CalamityMod/EncryptedSchematicPlanetoid] Дополнительная информация на панели здоровья босса"
            Tooltip:
                '''
                Добавляет дополнительную информацию на панели здоровья босса Calamity.
                Здесь отображается либо точное здоровье босса, либо количество оставшихся частей или сегментов.
                '''
        }
        
        ChargeMeter: {
            Label: "[i:CalamityMod/DraedonPowerCell] Шкала заряда"
            Tooltip:
                '''
                Включает шкалу заряда, которая отображает текущий заряд предмета, находящегося в руках игрока.
                Шкала заряда всегда скрыта, если в руках нет предмета, для которого требуется заряд.
                '''
        }

        ChargeMeterPosX: {
            Label: "[i:LaserRuler] Позиция по X шкалы заряда"
            Tooltip:
                '''
                Позиция по X шкалы заряда, измеряется в % от ширины экрана.
                Шкалу можно перетаскивать мышью, если отключена настройка «Фиксация позиций шкал».
                '''
        }

        ChargeMeterPosY: {
            Label: "[i:LaserRuler] Позиция по Y шкалы заряда"
            Tooltip:
                '''
                Позиция по Y шкалы заряда, измеряется в % от высоты экрана.
                Шкалу можно перетаскивать мышью, если отключена настройка «Фиксация позиций шкал».
                '''
        }
        
        CooldownDisplay: {
            Label: "[i:CalamityMod/NebulousCore] Панель перезарядки"
            Tooltip: Добавляет панель перезарядки, отображающую все важные перезарядки прямо под баффами и дебаффами.
        }

        DebuffDisplay: {
            Label: "[i:FlaskofIchor] Отображение дебаффов на врагах"
            Tooltip: Добавляет иконки дебаффов над всеми боссами и мини-боссами.
        }

        DevourerofGodsEulogy: {
            Label: "[i:CalamityModMusic/DevourerofGodsEulogyMusicBox] Eulogy for the Ego"
            Tooltip: Проигрывает Calamity Mod OST - «Scourge of the Universe (Eulogy for the Ego)» после победы над Пожирателем богов.
        }
        
        DisableGravityScreenSwap: {
            Label: "[i:GravityGlobe] Отключить переворот экрана при смене гравитации"
            Tooltip:
                '''
                Отключает ванильный переворот экрана при смене гравитации, переворачивая вместо этого персонажа.
                Включите эту настройку, если переворот экрана отвлекает или вызывает укачивание.
                '''
        }

        EnableVanillaTextureEdits: {
            Label: "[i:Paintbrush] Изменения ванильных текстур"
            Tooltip:
                '''
                Включает небольшие изменения текстур ванильных боссов для улучшения читаемости их атак.
                Отключите эту настройку для совместимости с текстур-паками.
                '''
        }
        
        EnergyShieldOpacity: {
            Label: "[i:CalamityMod/TheSponge] Прозрачность энергетического щита"
            Tooltip:
                '''
                Настраивает прозрачность энергетических щитов, отображаемых поверх персонажа.
                Установите значение на 0, чтобы полностью отключить визуальные эффекты энергетического щита.
                '''
        }
        
        FancyBackgroundVisuals: {
            Label: "[i:CalamityMod/BlueDistortedMonolith] Детализированные фоновые эффекты"
            Tooltip:
                '''
                Определяет, будут ли отображаться сложные фоновые эффекты в определённые моменты игры, например, во время битв с боссами.
                Если отключена эта настройка, в некоторых случаях будет показываться упрощённая версия фона.
                Рекомендуется отключить, если у вас проблемы с видимостью или низкая производительность игры.
                '''
        }
        
        FasterFallHotkey: {
            Label: "[i:CalamityMod/BallAndChain] Активация быстрого падения"
            Tooltip:
                '''
                Если включена эта настройка, вы можете удерживать клавишу {$Key.DOWN}, когда находитесь в воздухе, чтобы ускорить падение.
                Эта настройка не увеличивает вашу максимальную скорость падения, а только то, как быстро вы ускоряетесь.
                Calamity сбалансирован таким образом, чтобы эта настройка была включена.
                '''
        }
        
        FlightBar: {
            Label: "[i:AngelWings] Отображение шкалы полёта"
            Tooltip:
                '''
                Включает интерфейс шкалы полёта, показывающая оставшееся время полёта игрока.
                Эта шкала также будет информировать о снижении максимального времени полёта из-за наложенных дебаффов.
                Она будет светиться ярко-синим, если у игрока в данный момент нет ограничений на максимальное время полёта.
                '''
        }
    
        FlightBarPosX: {
            Label: "[i:LaserRuler] Позиция по X шкалы полёта"
            Tooltip:
                '''
                Позиция по X шкалы полёта, измеряется в % от ширины экрана.
                Шкалу можно перетаскивать мышью, если отключена настройка «Фиксация позиций шкал».
                '''
        }
    
        FlightBarPosY: {
            Label: "[i:LaserRuler] Позиция по Y шкалы полёта"
            Tooltip:
                '''
                Позиция по Y шкалы полёта, измеряется в % от ширины экрана.
                Шкалу можно перетаскивать мышью, если отключена настройка «Фиксация позиций шкал».
                '''
        }
    
        Interludes: {
            Label: "[i:CalamityModMusic/Interlude1MusicBox] Интерлюдии"
            Tooltip:
                '''
                Включает проигрывание трёх интерлюдий в игре:
                Calamity Mod OST - «Silence before the storms» после победы над Клоном Каламитас.
                Calamity Mod OST - «Storms before the catastrophes» после победы над Лунным лордом.
                Calamity Mod OST - «Catastrophes before the calamity» после победы над Яроном.
                '''
        }
    
        MeterPosLock: {
            Label: "[i:GemLockTopaz] Фиксация позиций шкал"
            Tooltip:
                '''
                Предотвращает нажатие на различные шкалы Calamity на экране.
                Это отключает их перетаскивание мышью.
                '''
        }

        ParticleLimit: {
            Label: "[i:FragmentStardust] Максимальное количество частиц"
            Tooltip:
                '''
                Устанавливает максимальное количество эффектов частиц, которые могут одновременно существовать.
                Частицы отделены от пыли и останков убитых врагов.
                Снижайте значение для повышения производительности.
                [c/F05A5A:Снижение этого значения ниже 1000 может привести к некорректному отображению некоторых вещей.]
                '''
        }

        Photosensitivity: {
            Label: "[i:DiscoBall] Режим светочувствительности"
            Tooltip:
                '''
                Снижает или отключает яркость и/или мерцание определённых визуальных эффектов.
                Также отключает все эффекты тряски экрана.
                Настоятельно рекомендуется, если вы страдаете от повышенной светочувствительности.
                '''
        }

        RageMeterPosX: {
            Label: "[i:LaserRuler] Позиция по X шкалы ярости"
            Tooltip:
                '''
                Позиция по X шкалы ярости, измеряется в % от ширины экрана.
                Шкалу можно перетаскивать мышью, если отключена настройка «Фиксация позиций шкал».
                '''
        }

        RageMeterPosY: {
            Label: "[i:LaserRuler] Позиция по Y шкалы ярости"
            Tooltip:
                '''
                Позиция по Y шкалы ярости, измеряется в % от высоты экрана.
                Шкалу можно перетаскивать мышью, если отключена настройка «Фиксация позиций шкал».
                '''
        }
        
        RipperMeterShake: {
            Label: "[i:CalamityMod/RedLightningContainer] Дрожание ярости и адреналина"
            Tooltip:
                '''
                Насколько сильно дрожат шкалы ярости и адреналина во время использования.
                Установите значение на 0, чтобы полностью отключить дрожание.
                '''
        }
    
        ScreenshakePower: {
            Label: "[i:CalamityMod/WavePounder] Интенсивность дрожания экрана"
            Tooltip:
                '''
                Контролирует интенсивность дрожания экрана во время игры.
                Установите значение на 0, чтобы полностью отключить дрожание экрана.
                [c/FF232C:Все визуальные эффекты дрожания экрана сбалансированы при значении 1.]
                [c/FF232C:Более высокое значение может вызывать тошноту или дискомфорт у некоторых игроков.]
                '''
        }
    
        SetBonusDoubleTap: {
            Label: "[i:VortexHelmet] Двойное нажатие для бонусов комплектов брони"
            Tooltip: Позволяет активировать все бонусы комплектов брони стандартным двойным нажатием клавиши {$Key.DOWN} (или {$Key.UP}, в зависимости от ваших настроек).
        }
    
        ShopNewAlert: {
            Label: "[i:GoldChest] Оповещение о новых предметах в магазине"
            Tooltip: Добавляет иконку, которая появляется над жителями, когда у них в магазине появляются новые предметы.
        }
    
        SpeedrunTimer: {
            Label: "[i:Stopwatch] Таймер скоростного прохождения"
            Tooltip:
                '''
                Включает внутриигровой таймер скоростного прохождения, который отображает внутриигровое время с точностью до миллисекунды.
                Во второй строке указывается время последней смерти босса.
                Время отслеживается для каждого игрока и учитывает только время, проведённое в мире.
                '''
        }
    
        SpeedrunTimerPosX: {
            Label: "[i:LaserRuler] Позиция по X таймера"
            Tooltip:
                '''
                Позиция по X таймера скоростного прохождения, измеряется в % от ширины экрана.
                Таймер можно перетаскивать мышью, если отключена настройка «Фиксация позиций шкал».
                '''
        }
    
        SpeedrunTimerPosY: {
            Label: "[i:LaserRuler] Позиция по Y таймера"
            Tooltip:
                '''
                Позиция по Y таймера скоростного прохождения, измеряется в % от высоты экрана.
                Таймер можно перетаскивать мышью, если отключена настройка «Фиксация позиций шкал».
                '''
        }
    
        StealthInvisibility: {
            Label: "[i:CalamityMod/StealthHairDye] Невидимость скрытности"
            Tooltip:
                '''
                Позволяет игрокам постепенно становиться невидимыми по мере увеличения их скрытности разбойника.
                Этот эффект визуально похож на невидимость грибнитового комплекта брони.
                '''
        }
    
        StealthMeter: {
            Label: "[i:CalamityMod/EclipseMirror] Шкала скрытности"
            Tooltip:
                '''
                Включает шкалу скрытности, которая отображает текущий уровень скрытности игрока.
                Шкала скрытности скрыта, если не надет любой из комплектов брони разбойника.
                '''
        }
    
        StealthMeterPosX: {
            Label: "[i:LaserRuler] Позиция по X шкалы скрытности"
            Tooltip:
                '''
                Позиция по X шкалы скрытности, измеряется в % от ширины экрана.
                Шкалу можно перетаскивать мышью, если отключена настройка «Фиксация позиций шкал».
                '''
        }
    
        StealthMeterPosY: {
            Label: "[i:LaserRuler] Позиция по Y шкалы скрытности"
            Tooltip:
                '''
                Позиция по Y шкалы скрытности, измеряется в % от высоты экрана.
                Шкалу можно перетаскивать мышью, если отключена настройка «Фиксация позиций шкал».
                '''
        }
    
        StutterFix: {
            Label: "[i:TrifoldMap] Исправление подвисаний"
            Tooltip:
                '''
                Если включена эта настройка, при входе в мир вся карта загружается сразу.
                Это приведёт к тому, что Террария перестанет отвечать во время загрузки мира. НЕ закрывайте игру в этот момент.
                Как только игра снова начнёт отвечать, вы войдёте в мир и сможете играть без случайных подвисаний.
                Эта настройка рекомендуется только для игроков, которых раздражают случайные подвисания во время игры.
                '''
        }
    
        SulphuricWaterMeterPosX: {
            Label: "[i:LaserRuler] Позиция по X шкалы отравления сернистыми водами"
            Tooltip:
                '''
                Позиция по X шкалы отравления сернистыми водами, измеряется в % от ширины экрана.
                Шкалу можно перетаскивать мышью, если отключена настройка «Фиксация позиций шкал».
                '''
        }
    
        SulphuricWaterMeterPosY: {
            Label: "[i:LaserRuler] Позиция по Y шкалы отравления сернистыми водами"
            Tooltip:
                '''
                Позиция по Y шкалы отравления сернистыми водами, измеряется в % от ширины экрана.
                Шкалу можно перетаскивать мышью, если отключена настройка «Фиксация позиций шкал».
                '''
        }
    
        SunkenSeaBackgroundDistortion: {
            Label: "[i:CalamityMod/SeaRemains] Искажение фона затерянного моря"
            Tooltip:
                '''
                Определяет, будет ли к уникальным фонам затерянного моря применяться дополнительный шейдер искажения.
                Это создаёт иллюзию преломления света под водой.
                [c/FF232C:Обратите внимание, что это сработает ТОЛЬКО если отключена настройка «Детализация волн».]
                '''
        }
    
        TextEffects: {
            Label: "[i:LeinforsAccessory] Дополнительные эффекты текста"
            Tooltip:
                '''
                Если включена эта настройка, названия предметов определённых редкостей Calamity будут иметь дополнительные визуальные эффекты.
                Отключите эту настройку, если хотите уменьшить визуальный шум.
                '''
        }
    
        TileTextureBlendingQuality: {
            Label: "[i:GlowPaint] Мягкое смешивание стыков блоков"
            Tooltip: Изменяет качество мягкого смешивания текстур при соединении разных типов блоков.
        }
        
        VanillaCooldownDisplay: {
            Label: "[i:HealingPotion] Отображение ванильных иконок перезарядки"
            Tooltip:
                '''
                Добавляет ванильные дебаффы [cbuff:PotionSickness] и [cbuff:ChaosState] в панель перезарядки.
                Дебаффы по-прежнему будут отображаться в общем списке баффов, но это может помочь сделать их более заметными.
                '''
        }
        
         VCMMStatusMessage: {
            Label: "[i:MusicBoxMartians] Сообщение о VCMM"
            Tooltip: Включает или выключает сообщение, рекламирующее мод Vanilla Calamity Music Mod, которое появляется при входе в мир.
        }
        
        WikiStatusMessage: {
            Label: "[i:Book] Сообщение о вики"
            Tooltip: Включает или выключает сообщение, рекламирующее официальную вики Calamity, которое появляется при входе в мир.
        }
    }
    
    CalamityServerConfig: {
        DisplayName: Серверная конфигурация
        Denied: У вас нет прав на изменение этой конфигурации

        Headers: {
            ExpertMaster: Изменения режимов Эксперта и Мастера
            Gameplay: Общие геймплейные изменения
            BaseBoosts: Усиление базовых характеристик
        }

        BossesStopWeather: {
            Label: "[i:CalamityMod/TorrentialTear] Боссы останавливают погоду"
            Tooltip:
                '''
                При включении этой настройки многие боссы на поздних стадиях игры останавливают дождь и другие погодные эффекты при появлении.
                Включите эту настройку, если вы испытываете проблемы с производительностью во время сражений с боссами на поздних стадиях игры.
                '''
        }

        BossHealthBoost: {
            Label: "[i:LifeCrystal] Увеличение здоровья боссов в %"
            Tooltip:
                '''
                Глобально увеличивает здоровье всех боссов на указанный процент.
                Это суммируется с увеличением здоровья боссов в мультиплеере.
                Не влияет на уже появившихся боссов.
                '''
        }

        BossZen: {
            Label: "[i:CalamityMod/ZenPotion] Боссы снижают частоту появления врагов"
            Tooltip:
                '''
                Все живые боссы значительно снижают частоту появления обычных врагов.
                Это также предотвращает появление слизнепада во время битвы с боссом.
                Calamity сбалансирован таким образом, чтобы эта настройка была включена.
                '''
        }

        ChilledWaterRework: {
            Label: "[i:ArcticDivingGear] Переработка охлаждённой воды"
            Tooltip: Если включена эта настройка, вода в снегах и льдах будет быстро истощать запас воздуха игрока, вместо наложения дебаффа [cbuff:Chilled].
        }

        DefaultDashEnabled: {
            Label: "[i:Tabi] Стандартный рывок"
            Tooltip:
                '''
                По умолчанию даёт игроку очень слабый рывок, для использования которого не требуется наличие специального снаряжения или предметов.
                Этот рывок будет заменён любым другим доступным рывком, включая те, которые предоставляют другие моды.
                '''
        }

        EarlyHardmodeProgressionRework: {
            Label: "[i:Pwnhammer] Переработка прогрессии раннего хардмода"
            Tooltip:
                '''
                Демонические алтари больше не создают руду и блоки багрянца/искажения при разрушении.
                Стена плоти создаёт кобальт и палладий при первой победе над ней.
                Первый механический босс, с которым вы сражаетесь, имеет на 20% (10% в режимах Эксперта и Мастера) меньше здоровья и урона,
                и при первой победе над ним создаёт мифрил и орихалк.
                Второй механический босс, с которым вы сражаетесь, имеет на 10% (5% в режимах Эксперта и Мастера) меньше здоровья и урона,
                и при первой победе над ним создаёт адамантит и титан.
                Третий механический босс создаёт освящённую руду при первой победе над ним.
                '''
        }

        FasterBaseSpeed: {
            Label: "[i:HermesBoots] Увеличенная базовая скорость передвижения"
            Tooltip:
                '''
                Значительно увеличивает базовую скорость передвижения, всегда давая +50% к скорости передвижения.
                Эта настройка ничего не делает, если включён мод Terraria Overhaul.
                Calamity сбалансирован таким образом, чтобы эта настройка была включена.
                '''
        }

        FasterRopeClimbSpeed: {
            Label: "[i:Rope] Увеличенная скорость лазанья по верёвке"
            Tooltip:
                '''
                Существенно повышает скорость подъёма по верёвке, увеличивая ускорение и торможение.
                Calamity сбалансирован таким образом, чтобы эта настройка была включена.
                '''
        }

        FasterJumpSpeed: {
            Label: "[i:FrogLeg] Увеличенная базовая скорость прыжка"
            Tooltip:
                '''
                Немного увеличивает базовую скорость прыжка.
                Calamity сбалансирован таким образом, чтобы эта настройка была включена.
                '''
        }

        FasterTilePlacement: {
            Label: "[i:ArchitectGizmoPack] Увеличенная базовая скорость строительства"
            Tooltip:
                '''
                Значительно увеличивает скорость, с которой игрок может размещать блоки и стены.
                Эта настройка комбинируется с «{$ItemName.BrickLayer}», «{$ItemName.PortableCementMixer}» и другими аксессуарами.
                '''
        }

        ForceTownSafety: {
            Label: "[i:Sunflower] Принудительная безопасность городов"
            Tooltip:
                '''
                Предотвращает появление врагов возле городов в режимах Эксперт и Мастер, значительно снижая скорость их появления.
                Это может иметь непредвиденные негативные последствия, например, затруднять поиск живности.
                '''
        }

        NerfExpertDebuffs: {
            Label: "[i:AnkhCharm] Отключение увеличенной длительности дебаффа"
            Tooltip:
                '''
                Отключает в режиме Эксперта двукратную (а в режиме Мастера - трёхкратную) длительность дебаффов на игроке.
                Calamity сбалансирован таким образом, чтобы эта настройка была включена.
                '''
        }
        
        PlayerRespawnTime_BossAlive: {
            Label: "[i:Stopwatch] Время возрождения в битве с боссом"
            Tooltip:
                '''
                Устанавливает время в секундах, за которое игрок возродится после смерти во время битвы с боссом.
                Это значение одинаково как для одиночной игры, так и для мультиплеера.
                Если нет живых боссов, игроки возродятся через 3 секунды как в одиночной игре, так и в мультиплеере.
                '''
        }
        
        RemoveLavaDropsFromLavaSlimes: {
            Label: "[i:LavaWaders] Отключение выпадения лавы из лавовых слизней"
            Tooltip: При включении этой настройки лавовые слизни перестанут оставлять после себя лаву в режиме Эксперта.
        }

        RemoveReforgeRNG: {
            Label: "[i:TinHammer] Отключение случайности перековки"
            Tooltip:
                '''
                Удаляет случайность в перековке оружия и аксессуаров у гоблина-изобретателя.
                Во избежание конфликтов отключите эту настройку, если используете моды, которые сами изменяют перековку.
                '''
        }

        TownNPCSpawnRateMultiplier: {
            Label: "[i:GuideVoodooDoll] Множитель прибытия жителей"
            Tooltip:
                '''
                Прямое умножение скорости появления и возрождения жителей.
                Это сократит время ожидания, если босс или событие убивает всех жителей города.
                '''
        }

        TownNPCsSpawnAtNight: {
            Label: "[i:ClothierVoodooDoll] Прибытие жителей ночью"
            Tooltip:
                '''
                Если включена эта настройка, жители могут появляться и возрождаться ночью.
                Это относится и к старику.
                '''
        }
    }
    
    CooldownDisplayOptions: {
        Tooltip: ""
    
        Full: {
            Label: Полная
            Tooltip: Отображает вокруг иконки круговую шкалу, показывающую оставшееся время перезарядки
        }
    
        Compact: {
            Label: Компактная
            Tooltip: Отображает на иконке градиентное затемнение, показывающее оставшееся время перезарядки
        }
    
        Hidden: {
            Label: Скрытая
            Tooltip: ""
        }
    }
    
    SetBonusDoubleTapOptions: {
