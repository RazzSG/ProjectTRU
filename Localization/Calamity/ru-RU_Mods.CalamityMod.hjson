    InCrag: В Серной скале
    InSulph: В Сернистом море
    InSunken: В Затерянном море
    InRev: В режиме Месть
    InRevOrMM: В режиме Месть или Мастер
    AlcoholPoison: Пока наложен дебафф «{$Buffs.AlcoholPoisoning.DisplayName}»
    PostCal: После победы над Клоном Каламитас
    PostAureus: После победы над Аструм Ареусом
    PostPolter: После победы над Полтергастом
    PostOD: После победы над Старым герцогом
    PostDoG: После победы над Пожирателем богов
    PostYharon: После победы над Яроном
}

Configs: {
    CalamityConfig: {
        DisplayName: Главный конфиг

        Headers: {
            ExpertMaster: Изменения режимов Эксперта и Мастера
            Gameplay: Общие геймплейные изменения
            Graphics: Графические изменения
            Revengeance: Изменения режима Месть
            UI: Изменения пользовательского интерфейса
            BaseBoosts: Усиление базовых характеристик
            MusicEvents: Музыкальные события
        }

        AdrenalineMeterPosX: {
            Label: "[i:LaserRuler] Позиция по X индикатора адреналина"
            Tooltip:
                '''
                Позиция по X индикатора адреналина, измеряется в % от ширины экрана.
                Индикатор можно перетаскивать мышью, если отключена настройка «Фиксация позиций индикаторов».
                '''
        }

        AdrenalineMeterPosY: {
            Label: "[i:LaserRuler] Позиция по Y индикатора адреналина"
            Tooltip:
                '''
                Позиция по Y индикатора адреналина, измеряется в % от высоты экрана.
                Индикатор можно перетаскивать мышью, если отключена настройка «Фиксация позиций индикаторов».
                '''
        }

        Afterimages: {
            Label: "[i:SteampunkGoggles] Послеобразы"
            Tooltip:
                '''
                Включает отображение послеобразов для существ Calamity, снарядов и т.д.
                Отключите для повышения производительности.
                '''
        }

        BossesStopWeather: {
            Label: "[i:CalamityMod/TorrentialTear] Боссы останавливают погоду"
            Tooltip:
                '''
                При включении этой настройки многие боссы на поздних стадиях игры останавливают дождь и другие погодные эффекты при появлении.
                Включите, если вы испытываете проблемы с производительностью во время сражений с боссами на поздних стадиях игры.
                '''
        }

        BossHealthBarExtraInfo: {
            Label: "[i:CalamityMod/EncryptedSchematicPlanetoid] Дополнительная информация на панели здоровья босса"
            Tooltip:
                '''
                Добавляет дополнительную информацию на панели здоровья босса Calamity.
                Здесь отображается либо точное здоровье босса, либо количество оставшихся частей или сегментов.
                '''
        }

        BossHealthBoost: {
            Label: "[i:LifeCrystal] Увеличение здоровья боссов в %"
            Tooltip:
                '''
                Глобально увеличивает здоровье всех боссов на указанный процент.
                Это суммируется с увеличением здоровья боссов в мультиплеере.
                Не влияет на уже появившихся боссов.
                '''
        }
        
        DefaultDashEnabled: {
            Label: "[i:Tabi] Стандартный рывок"
            Tooltip:
                '''
                По умолчанию даёт игроку очень слабый рывок, для использования которого не требуется наличие специального снаряжения или предметов.
                Этот рывок будет заменён любым другим доступным рывком, включая те, которые предоставляют другие моды.
                '''
        }

        BossZen: {
            Label: "[i:CalamityMod/ZenPotion] Боссы снижают частоту появления врагов"
            Tooltip:
                '''
                Все живые боссы значительно снижают частоту появления обычных врагов.
                Это также предотвращает появление слизнепада, пока босс жив.
                Calamity сбалансирован таким образом, чтобы эта настройка была включена.
                '''
        }

        ChargeMeter: {
            Label: "[i:CalamityMod/DraedonPowerCell] Индикатор заряда"
            Tooltip:
                '''
                Включает индикатор заряда, который отображает текущий заряд оружия, находящегося в руках игрока.
                Индикатор заряда всегда скрыт, если в руках нет оружия, для которого требуется заряд.
                '''
        }

        ChargeMeterPosX: {
            Label: "[i:LaserRuler] Позиция по X индикатора заряда"
            Tooltip:
                '''
                Позиция по X индикатора заряда, измеряется в % от ширины экрана.
                Индикатор можно перетаскивать мышью, если отключена настройка «Фиксация позиций индикаторов».
                '''
        }

        ChargeMeterPosY: {
            Label: "[i:LaserRuler] Позиция по Y индикатора заряда"
            Tooltip:
                '''
                Позиция по Y индикатора заряда, измеряется в % от высоты экрана.
                Индикатор можно перетаскивать мышью, если отключена настройка «Фиксация позиций индикаторов».
                '''
        }

        ChilledWaterRework: {
            Label: "[i:ArcticDivingGear] Переработка охлаждённой воды"
            Tooltip: Если эта настройка включена, вода в снегах и льдах будет быстро истощать запас воздуха игрока, вместо наложения дебаффа «{$BuffName.Chilled}».
        }

        CooldownDisplay: {
            Label: "[i:CalamityMod/NebulousCore] Панель перезарядки"
            Tooltip:
                '''
                Добавляет панель перезарядки, отображающую все важные перезарядки прямо под баффами и дебаффами.
                Установите значение на 1, чтобы отображать панель перезарядки в компактном режиме, и 0, чтобы полностью скрыть её.
                '''
        }

        DebuffDisplay: {
            Label: "[i:FlaskofIchor] Отображение дебаффов на врагах"
            Tooltip: Добавляет иконки дебаффов над всеми боссами и мини-боссами.
        }

        DevourerofGodsEulogy: {
            Label: "[i:CalamityModMusic/DevourerofGodsEulogyMusicBox] Eulogy for the Ego"
            Tooltip: Проигрывает Calamity Mod OST - "Scourge of The Universe (Eulogy for The Ego)" после победы над Пожирателем богов
        }

        EarlyHardmodeProgressionRework: {
            Label: "[i:Pwnhammer] Переработка прогрессии раннего хардмода"
            Tooltip:
                '''
                Демонические алтари больше не создают руду и блоки багрянца/искажения при разрушении.
                Стена плоти создаёт кобальт и палладий при первой победе над ней.
                Первый механический босс, с которым вы сражаетесь, имеет на 20% (10% в режимах Эксперта и Мастера) меньше здоровья и урона, и при первой победе над ним создаёт мифрил и орихалк.
                Второй механический босс, с которым вы сражаетесь, имеет на 10% (5% в режимах Эксперта и Мастера) меньше здоровья и урона, и при первой победе над ним создаёт адамантит и титан.
                Третий механический босс создаёт освящённую руду при первой победе над ним.
                '''
        }

        FasterBaseSpeed: {
            Label: "[i:HermesBoots] Увеличенная базовая скорость передвижения"
            Tooltip:
                '''
                Значительно увеличивает базовую скорость передвижения, всегда давая +50% к скорости передвижения.
                Эта настройка ничего не делает, если включён мод Terraria Overhaul.
                Calamity сбалансирован таким образом, чтобы эта настройка была включена.
                '''
        }

        FasterFallHotkey: {
            Label: "[i:CalamityMod/BallAndChain] Активация быстрого падения"
            Tooltip:
                '''
                Если включена эта настройка, вы можете удерживать клавишу ВНИЗ, когда находитесь в воздухе, чтобы ускорить падение.
                Эта настройка не увеличивает вашу максимальную скорость падения, а только то, как быстро вы ускоряетесь.
                Calamity сбалансирован таким образом, чтобы эта настройка была включена.
                '''
        }

        FasterJumpSpeed: {
            Label: "[i:FrogLeg] Увеличенная базовая скорость прыжка"
            Tooltip:
                '''
                Немного увеличивает базовую скорость прыжка.
                Calamity сбалансирован таким образом, чтобы эта настройка была включена.
                '''
        }

        FasterTilePlacement: {
            Label: "[i:ArchitectGizmoPack] Увеличенная базовая скорость строительства"
            Tooltip:
                '''
                Значительно увеличивает скорость, с которой игрок может размещать блоки и стены.
                Эта настройка комбинируется с «{$ItemName.BrickLayer}», «{$ItemName.PortableCementMixer}» и другими аксессуарами.
                '''
        }

        FlightBar: {
            Label: "[i:CalamityMod/DrewsWings] Отображение индикатора полёта"
            Tooltip:
                '''
                Включает интерфейс индикатора полёта, показывающий оставшееся время полёта игрока.
                Этот индикатор также будет информировать о снижении максимального времени полёта из-за наложенных дебаффов.
                Он будет светиться ярко-синим, если у игрока в данный момент нет ограничений на максимальное время полёта.
                '''
        }

        FlightBarPosX: {
            Label: "[i:LaserRuler] Позиция по X индикатора полёта"
            Tooltip:
                '''
                Позиция по X панели полёта, измеряется в % от ширины экрана.
                Индикатор можно перетаскивать мышью, если отключена настройка «Фиксация позиций индикаторов».
                '''
        }

        FlightBarPosY: {
            Label: "[i:LaserRuler] Позиция по Y индикатора полёта"
            Tooltip:
                '''
                Позиция по Y панели полёта, измеряется в % от ширины экрана.
                Индикатор можно перетаскивать мышью, если отключена настройка «Фиксация позиций индикаторов».
                '''
        }

        ForceTownSafety: {
            Label: "[i:Sunflower] Принудительная безопасность городов"
            Tooltip:
                '''
                Предотвращает появление врагов возле городов в режимах Эксперт и Мастер, значительно снижая скорость их появления.
                Это может иметь непредвиденные негативные последствия, например, затруднять поиск живности.
                '''
