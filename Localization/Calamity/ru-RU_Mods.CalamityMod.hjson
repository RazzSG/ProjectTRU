        DespawnMessage: "[c/F0E68C:Ядовитый бич уплывает в безмятежный, открытый океан.]"
    }
    
    AstrumAureus: {
        SpawnInfo: Используйте [i:CalamityMod/AstralChunk] ночью в астральной инфекции.
        DespawnMessage: "[c/FFD700:Ареус ликвидировал все угрозы, возобновляя предыдущую разведку.]"
    }
    
    AstrumDeus: {
        EntryName: Аструм Деус
