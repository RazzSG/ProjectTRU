        BrimstoneLocus: {
            DisplayName: Серный лотос
            Tooltip:
                '''
                [c/C61B40:'Я способна не только усиливать снаряжение могущественной магией,]
                [c/C61B40:но и извлекать его истинную силу, возвышая определённое оружие до совершенно новых форм]
                [c/C61B40:Предметы, которые можно возвысить, подсвечиваются, пока этот предмет находится в инвентаре']
                '''
        }
        
        MomentumCapacitor: {
            DisplayName: Импульсный конденсатор
            Tooltip:
                '''
                Во время использования импульсного конденсатора ваша максимальная скорость будет постоянно и неконтролируемо увеличиваться
                Этот эффект работает, только если нет живых боссов
                '''
        }
        
        NormalityRelocator: {
            DisplayName: Релокатор нормальной формы
            Tooltip:
                '''
                Нажмите [KEY] для телепортации в место расположения курсора
                Скорость падения удваивается на 30 кадров после телепортации
                Телепортация невозможна, пока активен дебафф «{$BuffName.ChaosState}»
                Работает, пока находится в инвентаре
                'Одна нога здесь, другая там'
                '''
        }
        
        RelicOfConvergence: {
            DisplayName: Реликвия сближения
            Tooltip:
                '''
                Создаёт осквернённый кристалл, набирающий силы
                Замедляет, пока активен кристалл
                В конце своего существования кристалл восстанавливает владельцу 70 единиц здоровья
                '''
        }
        
        Rock: {
            DisplayName: Камень
            Tooltip:
                '''
                Когда битва, наконец, завершилась, а пыль только начала оседать
                В том месте, где даже камень упорно сопротивлялся времени, сидел монах
                Он осмелился подвергнуть сомнению ход истории и взглянуть в глаза судьбе
                'Какова истинная цена бесконечного прошлого?
                Почему наше будущее обязано вечно преследовать нас?'
                '''
        }
        
        SulphurousSeaWorldSideChanger: {
            DisplayName: Переключатель стороны сернистого моря
            Tooltip:
                '''
                Используйте это, если ваш обычный океан считается сернистым морем
                Это также исправляет бездну, если она сломана
                '''
        }
        
        SuperDummy: {
            DisplayName: Сверхманекен
            Tooltip:
                '''
                Создаёт сверхманекенов
                Восстанавливает 1 миллион единиц здоровья в секунду
                Не умрёт при получении постепенного урона от дебаффов
                Нажмите <right>, чтобы убить всех сверхманекенов
                '''
        }
    }
    
