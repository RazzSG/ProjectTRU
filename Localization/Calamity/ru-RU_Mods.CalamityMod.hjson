        }
    
        Normal: {
            Label: Включено
            Tooltip: Мягкое смешивание текстур блоков включено.
        }
    
        High: {
            Label: Включено + Попиксельная обработка
            Tooltip:
                '''
                Мягкое смешивание текстур блоков включено и использует попиксельную отрисовку.
                [c/F05A5A:Не рекомендуется для слабых устройств.]
                '''
        }
