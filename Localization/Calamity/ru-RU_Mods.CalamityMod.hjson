    }
    
    Calamitas: {
        EntryName: Высшая ведьма, Каламитас
        SpawnInfo: Используйте [i:CalamityMod/AshesofCalamity] или [i:CalamityMod/CeremonialUrn] в качестве подношения на [i:CalamityMod/AltarOfTheAccursedItem].
