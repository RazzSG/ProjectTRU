        Havocfish: {
            DisplayName: Рыба опустошения
            QuestDescription: Когда ты прикончил ту мерзкую Стену плоти, в эти разрушенные утёсы хлынуло столько хаоса, что даже в лаве завелись рыбы, рождённые из чистой эссенции! А ну-ка, принеси мне такую. Настоящее опустошение — это как раз то, чего не хватает моему новому плану!
        }
        
        Shadowfish: {
            DisplayName: Теневая рыба
            Tooltip: Тьма продолжает распространяться
        }
        
        SlagCrate: {
            DisplayName: Шлаковый ящик
            Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
        }
        
        Slurpfish: {
            DisplayName: Рыба-поглотитель
            QuestDescription: Эй, {0}, разве не было бы ужасно, если бы я послал тебя в те руины в самых глубинах преисподней? Так вот, я именно это и делаю! Слыхал я о жуткой рыбе, способной выхлебать душу из человека. Я свою душонку ценю, так что брысь отсюда! Рыба сама себя не выудит!
        }

