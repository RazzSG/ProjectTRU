        PlayerRespawnTime_BossAlive: {
            Label: "[i:Stopwatch] Время возрождения в битве с боссом"
            Tooltip:
                '''
                Устанавливает время в секундах, за которое игрок возродится после смерти во время битвы с боссом.
                Это значение одинаково как для одиночной игры, так и для мультиплеера.
                Если нет живых боссов, игроки возродятся через 3 секунды как в одиночной игре, так и в мультиплеере.
                '''
        }

        TownNPCSpawnRateMultiplier: {
            Label: "[i:GuideVoodooDoll] Множитель прибытия жителей"
            Tooltip:
                '''
                Прямое умножение скорости появления и возрождения жителей.
                Это сократит время ожидания, если босс или событие убивает всех жителей города.
                '''
        }

        TownNPCsSpawnAtNight: {
            Label: "[i:ClothierVoodooDoll] Прибытие жителей ночью"
            Tooltip:
                '''
                Если включена эта настройка, жители могут появляться и возрождаться ночью.
                Это относится и к старику.
                '''
        }

        VanillaCooldownDisplay: {
            Label: "[i:HealingPotion] Отображение ванильных иконок перезарядки"
            Tooltip:
                '''
                Добавляет ванильные дебаффы «{$BuffName.PotionSickness}» и «{$BuffName.ChaosState}» в панель перезарядки.
                Дебаффы по-прежнему будут отображаться в массиве баффов, но это может помочь сделать их более заметными.
                '''
        }

        WikiStatusMessage: {
            Label: "[i:Book] Сообщение о статусе вики"
            Tooltip: Включает или выключает сообщение о статусе, рекламирующее официальную вики Calamity, которое появляется при входе в мир.
        }
    }
}

DamageClasses: {
    AverageDamageClass.DisplayName: ед. общего урона
    MeleeRangedHybridDamageClass.DisplayName: ед. ближнего боя/стрелкового урона
    RogueDamageClass.DisplayName: ед. разбойного урона
    TrueMeleeDamageClass.DisplayName: ед. истинного урона ближнего боя
    TrueMeleeNoSpeedDamageClass.DisplayName: ед. истинного урона ближнего боя
}

Events: {
    AcidRain: Кислотный дождь
    AcidRainStart: Токсичный ливень начался над морями пустоши!
    AcidRainEnd: Сернистое небо светлеет...
    BossRush: Босс-раш
    BossRushStartText_1: ...Сколько времени минуло? Столетия? Возможно, даже тысячелетия?
    BossRushStartText_2: Я спрятал этот артефакт в глубочайших недрах мира, дабы никто не мог использовать его впредь.
    BossRushStartText_3: Лишь немногие ведают о его существовании, а те, кто знают...
    BossRushStartText_4: Понимают, что безграничная сила, которой он когда-то обладал, более недоступна смертным.
    BossRushStartText_5: В свете этих обстоятельств, поразительно, что нашёлся тот смельчак, что отважился отыскать его.
    BossRushStartText_6: Ещё и смертный! Как интересно...
    BossRushStartText_7: И что же побудило тебя приложить столько усилий, чтобы завладеть тем, что теперь представляет собой лишь истлевшую каменную скрижаль?
    BossRushStartText_8: ...Сама возможность сделать это? Заполучить эту реликвию нелегко, но я видел часть того, через что тебе пришлось пройти.
    BossRushStartText_9: Ты, завладевший этим артефактом, положивший конец одной эпохе, в своём стремлении положить конец другой...
    BossRushStartText_DoG: Ты, сразивший безымянного змея...
    BossRushStartText_Yharon: Ты, одолевший даже моего давнего друга, Феникса...
    BossRushStartText_DraedonSCal: Ты, чья сила сравнима с единственной смертной, что вселила в меня сомнения...
    BossRushStartText_10: Я желаю испытать тебя, создав из фрагментов моего Первозданного света образы твоих поверженных врагов.
    BossRushStartText_11: Не рассчитывай на лёгкую прогулку, но если проявишь свою силу, у меня будет для тебя предложение.
    BossRushStartText_12: Считаешь ли ты себя способным пройти через это испытание?
    BossRushStartText_Repeat: Ты готов испытать себя?
    BossRushStartText_Decline: Ясно. Похоже, моя вера в тебя была ошибочной. Прощай.
    BossRushStartText_Accept: Отлично. Да начнётся испытание!
    BossRushStartText_Death: ...И ради этого я возвращался?
    BossRushTierOneEndText_1: Сносное представление, но далеко не достаточное, чтобы оправдать мои ожидания.
    BossRushTierOneEndText_2: Подготовься как физически, так и морально к тому, что грядёт.
    BossRushTierTwoEndText_1: Я не ошибся в своих оценках. Ты и впрямь достойный воин.
    BossRushTierTwoEndText_2: Тем не менее, я уверен, что ты ещё не раскрыл передо мной все свои способности. Почему бы нам не продолжить и не узнать, на что ты ещё способен?
    BossRushTierThreeEndText_1: Твоя целеустремлённость и стремление к силе... напоминают мне о тех временах, когда я был простым смертным.
    BossRushTierThreeEndText_2: Однако самые сложные испытания ещё ждут тебя впереди. Не расслабляйся ни на секунду.
    BossRushTierFourEndText_1: Скоро наступит кульминационный момент испытания.
    BossRushTierFourEndText_2: И теперь настало время проявить свои непоколебимые убеждения и истинную силу духа.
    BossRushTierFourEndText_3: Докажи, что ты способен превзойти даже собственные пределы.
    BossRushEndText_1: Воистину, это было впечатляющее зрелище. Я вижу, что был прав в своих оценках! Ты действительно можешь считаться самым могущественным воином в этом мире. Однако...
    BossRushEndText_2: Похоже, что даже этой силы... недостаточно. Боюсь, я не смогу поделиться с тобой своим предложением.
    BossRushEndText_3: Впрочем, в качестве утешительного приза я подарю тебе этот древний камень, вырезанный мной из Гнездовья.
    BossRushEndText_4: Я долгое время хранил его как... своеобразный сувенир.
    BossRushEndText_5: Хоть ты и не оправдал мои ожидания, я уверен, что мы ещё встретимся!
    BossRushEndText_6: Не останавливайся на достигнутом, стремись к силе, и когда наши пути вновь пересекутся, возможно, ты будешь достаточно силён, чтобы заслужить моё признание.
    BossRushEndText_7: А пока у меня есть свои дела, которыми мне нужно заняться.
    BossRushEndText_8: До встречи в будущем.
    BossRushEndText_Repeat: Ты доказал, что являешься грозным воином, но этого недостаточно. Старайся достичь новых вершин могущества, чтобы однажды стать по-настоящему достойным.
    BossRushEndText_Death: ...Похоже, я был прав, полагая, что этот мир сам себя не спасёт, а уж меня и подавно.
}

GameTips: {
    SunkenSeaTip: Calamity Mod: Глубоко под пустыней покоятся руины разрушенного королевства.
    ArsenalLabTip: Calamity Mod: В недрах земли расположены старые и заброшенные лаборатории. 
    PlanetoidTip: Calamity Mod: Высоко в космосе можно найти планетоиды!
    AbyssTip: Calamity Mod: Глубоко под сернистым морем можно найти бездну. Убедитесь, что у вас есть подходящее снаряжение для дайвинга, прежде чем исследовать её.
    BanditTip: Calamity Mod: Бандит не обирает бедняков. Чтобы встретиться с ней, вам потребуется привлечь её внимание немалой суммой денег.
    RefundTip: Calamity Mod: Если вы часто обращались к гоблину-изобретателю для перековки оружия, возможно, стоит навестить бандита.
    DrunkPrincessTip: Calamity Mod: Пьяная принцесса - отличная компаньонка для веселья. Она может заселиться, если у вас будет её любимая водка.
    SeaKingTip: Calamity Mod: Морскому королю нравились моллюски, но он изменил своё мнение, когда один из них его съел.
    AmidiasBlessingTip: Calamity Mod: Морской король готов дать вам пузырь для дыхания под водой, если вы обратитесь к нему за помощью.
    ArchmageTip: Calamity Mod: Архимага можно освободить, если разрушить тюрьму, в которой он заточён.
    BrimstoneWitchTip: Calamity Mod: Серная ведьма может зачаровывать ваши предметы, наделяя их новыми способностями.
    TitanHeartTip: Calamity Mod: Сердца титанов можно использовать как подношение на маяке, который можно найти в астральной инфекции.
    NightProvTip: Calamity Mod: Призыв Осквернённой богини при свете луны значительно увеличивает её силу и стойкость.
    DayEoLTip: Calamity Mod: Призыв монарха фей при свете дня приведёт к жестокой и продолжительной битве.
    BossEnemyTip: Calamity Mod: Убийство самого безобидного врага может вызвать гнев гораздо более могущественного существа. Будьте осторожны!
    RoDAbyssTip: Calamity Mod: Когда вы находитесь в бездне, используйте жезл раздора на свой страх и риск. Оставляемый свет может привлечь внимание нежелательных врагов.
    TerminusTip: Calamity Mod: На дне бездны находится древний артефакт. Используйте его с большой осторожностью.
    CodebreakerTip: Calamity Mod: Дешифратор можно модернизировать, что позволит расшифровывать новые схемы, находящиеся в различных лабораториях по всему миру.
    ChargeTip: Calamity Mod: Для использования некоторого оружия требуется заряд. Оружие можно заряжать на зарядном устройстве с помощью батареек Дрэйдона.
    PowerCellTip: Calamity Mod: Фабрика по производству батареек генерирует батарейки Дрэйдона с течением времени.
    FactoryChargingTip: Calamity Mod: Фабрики по производству батареек и зарядные устройства можно найти в старых лабораториях.
    StealthTip: Calamity Mod: Ношение любой брони разбойника позволяет накапливать скрытность!
    SummonNerfTip: Calamity Mod: Использование оружия, не относящегося к классу призывателя, снижает урон призывателя.
    DefenseDamageTip: Calamity Mod: Некоторые атаки разрушают вашу защиту, но она быстро восстанавливается.
    PointBlankTip: Calamity Mod: Стрелковое оружие наносит гораздо больше урона при стрельбе в упор.
    RevengeanceTip: Calamity Mod: Ищете вызов сложнее режима Эксперта? Попробуйте режим Месть!
    BloodOrbTip: Calamity Mod: Кровавые сферы, выпадающие из врагов во время кровавой луны, можно использовать для создания почти любого зелья.
    KeybindsTip: Calamity Mod: Клавиши управления для мода можно изменить в настройках.
}

Items: {
    Accessories: {
        Abaddon: {
            DisplayName: Абаддон
            Tooltip:
                '''
                Увеличивает шанс критического удара на 8%
                При критических ударах происходит взрыв, воспламеняющий ближайших врагов дебаффом «{$Buffs.BrimstoneFlames.DisplayName}»
                Значительно снижает получаемый урон от дебаффа «{$Buffs.BrimstoneFlames.DisplayName}»
                '''
        }
    
        AbyssalAmulet: {
            DisplayName: Амулет бездны
            Tooltip:
                '''
                Все атаки, включая миньонов, накладывают дебафф «{$Buffs.RiptideDebuff.DisplayName}»
                Даёт невосприимчивость к дебаффу «{$Buffs.RiptideDebuff.DisplayName}»
                Когда вы находитесь в бездне, увеличивает максимальный запас здоровья на 10%
                '''
        }
    
        AbyssalDivingGear: {
            DisplayName: Глубоководное водолазное снаряжение
            Tooltip:
                '''
                Снижает урон от давления бездны при нехватке воздуха
                Устраняет дебафф «{$BuffName.Bleeding}» в бездне
                Позволяет плавать и значительно увеличивает запас воздуха под водой
                Обеспечивает светом под водой и увеличивает подвижность на льду
                Обеспечивает умеренным количеством света в бездне
                Значительно снижает расход воздуха в бездне
                '''
        }
    
        AbyssalDivingSuit: {
            DisplayName: Глубоководный водолазный костюм
            Tooltip:
                '''
                Превращает владельца в бронированного водолаза
                Увеличивает максимальную скорость передвижения и ускорение под водой, но замедляет на суше
                Бронированные пластины костюма увеличивают сопротивление урону на 15%
                Пластины получают урон только в том случае, если полученный урон превышает 50 единиц
                После того как костюм получает слишком много урона, его бронированным пластинам требуется 3 минуты на восстановление
                Снижает урон от давления бездны при нехватке воздуха
                Устраняет дебафф «{$BuffName.Bleeding}» на всех слоях бездны, кроме слоя пустоты
                Позволяет плавать и значительно увеличивает запас воздуха под водой
                Обеспечивает светом под водой и увеличивает подвижность на льду
                Обеспечивает умеренным количеством света в бездне
                Значительно снижает расход воздуха в бездне
                Делает вас менее заметным для существ бездны
                Уменьшает снижение защиты, вызванное бездной
                Даёт невосприимчивость к воздействию сернистых вод
                Позволяет быстрее опускаться под водой
                '''
        }
    
        AbyssalMirror: {
            DisplayName: Зеркало бездны
            Tooltip:
                '''
                Враги реже выбирают вас в качестве цели, даже в бездне
                Увеличивает скорость накопления скрытности на 25%, если вы стоите на месте, и на 12%, если вы движетесь
                Позволяет уклоняться от атак, выпуская облако люмениловой жидкости, которое наносит урон и оглушает ближайших врагов
                Уклонение не срабатывает против атак, которые наносят менее 5% урона от вашего максимального запаса здоровья
                Перезарядка уклонения составляет от 15 до 90 секунд в зависимости от урона атаки, от которой вы уклонились
                Уклонение от атаки даёт много скрытности
                Эта перезарядка распространяется на все другие уклонения и отражения
                'Свет не достигает глубин океана'
                '''
        }
    
        AscendantInsignia: {
            DisplayName: Знак отличия восходящего
            Tooltip:
                '''
                Увеличивает время полёта крыльев на 30%
                Увеличивает скорость передвижения, прыжка и ускорение 10%
                При нажатии [KEY] даёт силу восхождения, позволяя бесконечно летать в течение 4 секунд
                Восхождение имеет 40 секунд перезарядки
                '''
        }
    
        AeroStone: {
            DisplayName: Аэрокамень
            Tooltip:
                '''
                Увеличивает время полёта на 50 единиц
                Постепенно восстанавливает время полёта в воздухе, если вы не летите и не парите
                'Одна из древних реликвий'
                '''
        }
    
        Affliction: {
            DisplayName: Скорбь
            Tooltip:
                '''
                Увеличивает вам и всем игрокам в команде регенерацию здоровья на 0.5, максимальный запас здоровья на 10%, сопротивление урону на 7%, защиту на 13 и урон на 10%
                '''
        }
    
        AlchemicalFlask: {
            DisplayName: Алхимическая колба
            Tooltip:
                '''
                Все атаки, включая миньонов, накладывают дебафф «{$Buffs.Plague.DisplayName}» и снижает получаемый урон от дебаффа «{$Buffs.Plague.DisplayName}»
                Снаряды создают чумных искателей при попадании во врага
                Выпускает чумных пчёл и обливает вас мёдом после получении урона
                '''
        }
    
        AlluringBait: {
            DisplayName: Заманчивая приманка
            Tooltip:
                '''
                Увеличивает навык рыбной ловли на 30
                Значительно увеличивает шанс поймать рыбу для приготовления зелий
                Увеличивает количество пойманной рыбы для приготовления зелий
                '''
        }
    
        AmalgamatedBrain: {
            DisplayName: Сросшийся мозг
            Tooltip:
                '''
                Увеличивает урон на 10%
                Обрушивает с неба тени после получения урона
                Даёт способность уклоняться от атак
                Уклонение не срабатывает против атак, которые наносят менее 5% урона от максимального запаса здоровья
                Перезарядка уклонения составляет от 15 до 90 секунд в зависимости от урона атаки, от которой вы уклонились
                Эта перезарядка распространяется на все другие уклонения и отражения
                Временно увеличивает шанс критического удара и урон призывателя после уклонения
                После получения удара может наложить на ближайших врагов дебафф «{$BuffName.Confused}»
                '''
        }
    
        AmbrosialAmpoule: {
            DisplayName: Амброзиевая ампула
            Tooltip:
                '''
                Увеличивает максимальный запас здоровья на 50
                Увеличивает регенерацию здоровья от 2 до 6 в зависимости от недостающего здоровья
                Увеличивает регенерацию здоровья на 1 и дополнительно на 1, если на вас наложен дебафф, наносящий урон
                Когда вы стоите на месте, увеличивает регенерацию здоровья на 1.5
                Снижает в два раза длительность дебаффов огня и истощения, наложенных на игрока
                Излучает жёлтый свет, если видимость аксессуара включена
                '''
        }
    
        AmidiasPendant: {
            DisplayName: Кулон Амидиаса
            Tooltip: Периодически обрушивает с неба осколки призм, которые кратковременно оглушают врагов
        }
    
        AmidiasSpark: {
            DisplayName: Искра Амидиаса
            Tooltip: Испускает заряд искр после получения урона
        }
    
        AncientFossil: {
            DisplayName: Древнее ископаемое
            Tooltip: Увеличивает скорость добычи на 10%
        }
    
        AnechoicPlating: {
            DisplayName: Безэховое покрытие
            Tooltip:
                '''
                Делает вас менее заметным для существ бездны
                Уменьшает снижение защиты, вызванное бездной
                '''
        }
    
        AngelicAlliance: {
            DisplayName: Альянс ангелов
            Tooltip:
                '''
                Воззовите к силам небесным, чтобы усилить ваши атаки и миньонов
                Храбрость, Просветление, Благодать. Объединены Правосудием
                Увеличивает максимальное количество миньонов на 2, урон призывателя на 15%, а урон других классов на 8%
