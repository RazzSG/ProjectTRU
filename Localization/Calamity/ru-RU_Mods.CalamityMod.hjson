            }
            
            HeavyLaserRifle: {
                DisplayName: Тяжёлая лазерная винтовка
                Tooltip:
                    '''
                    Стреляет чрезвычайно точной парой разрушительных лазерных лучей
                    [c/1FFBFF:'Несмотря на то, что рыцари-богоискатели зачастую жестоки, не все предпочитают ближний бой]
                    [c/1FFBFF:Поэтому Ярим лично попросил меня создать для них тяжёлое вооружение, учитывая их немногочисленность']
                    '''
