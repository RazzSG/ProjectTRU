BossChecklistIntegration: {
    AcidRainT1: {
        EntryName: Кислотный дождь
        SpawnInfo: Используйте [i:CalamityMod/CausticTear] или дождитесь начала кислотного дождя после победы над Глазом Ктулху.
    }

    AcidRainT2: {
        EntryName: Кислотный дождь (2 ранг)
        SpawnInfo: Используйте [i:CalamityMod/CausticTear] или дождитесь начала кислотного дождя после победы над Акватическим бичом.
    }

    AcidRainT3: {
        EntryName: Кислотный дождь (3 ранг)
        SpawnInfo: Используйте [i:CalamityMod/CausticTear] или дождитесь начала кислотного дождя после победы над Полтергастом.
    }
    
    AquaticScourge: {
        EntryName: Акватический бич
        SpawnInfo: Используйте [i:CalamityMod/Seafood] в сернистом море или дождитесь его естественного появления в этом биоме.
        DespawnMessage: "[c/F0E68C:Отравленный бич уплывает в безмятежный, открытый океан.]"
    }
    
    AstrumAureus: {
        SpawnInfo: Используйте [i:CalamityMod/AstralChunk] в астральной инфекции.
        DespawnMessage: "[c/FFD700:Ареус ликвидировал все угрозы, возобновляя свою миссию по разведке.]"
    }
    
    AstrumDeus: {
        EntryName: Аструм Деус
        SpawnInfo: Используйте [i:CalamityMod/TitanHeart] или [i:CalamityMod/Starcore] в качестве подношения на [i:CalamityMod/AstralBeaconItem].
        DespawnMessage: "[c/FFD700:Заражённое божество отступает к небесам.]"
    }


    BossRush: {
        EntryName: Босс-раш
        SpawnInfo: Используйте [i:CalamityMod/Terminus], найденный на дне бездны.
    }
    
    BrimstoneElemental: {
        SpawnInfo: Используйте [i:CalamityMod/CharredIdol] в серном утёсе или Азафуре.
        DespawnMessage: "[c/DC143C:Элементаль продолжает свой скорбный дозор над Азафуром...]"
    }
    
    Calamitas: {
        EntryName: Высшая ведьма, Каламитас
        SpawnInfo: Используйте [i:CalamityMod/AshesofCalamity] или [i:CalamityMod/CeremonialUrn] в качестве подношения на [i:CalamityMod/AltarOfTheAccursedItem].
        DespawnMessage: "[c/FFA500:Ведьма исчезает, оставляя после себя лишь знойное пекло.]"
    }
    
    CalamitasClone: {
        SpawnInfo: Используйте [i:CalamityMod/EyeofDesolation].
        DespawnMessage: "[c/FFA500:Клон сплёвывает от разочарования немного крови и исчезает.]"
    }
    
    CeaselessVoid: {
        EntryName: Нескончаемая пустота
        SpawnInfo: Используйте [i:CalamityMod/MarkofProvidence] в Темнице.
        DespawnMessage: "[c/4B0082:Древний пространственный разлом ускользает в неизведанные края.]"
    }
    
    Crabulon: {
        SpawnInfo: Используйте [i:CalamityMod/DecapoditaSprout] в подземных грибных пустошах.
        DespawnMessage: "[c/6495ED:Чудовищный мицелиевый краб уползает прочь...]"
    }
    
    CragmawMire: {
        SpawnInfo:
            '''
            Появляется во время кислотного дождя после победы над Акватическим бичом.
            Начните кислотный дождь, используя [i:CalamityMod/CausticTear], или дождитесь его естественного начала.
            '''
        DespawnMessage: "[c/F0E68C:Болотистый скалозев зарывается в песок.]"
    }
    
    Cryogen: {
        SpawnInfo: Используйте [i:CalamityMod/CryoKey] в тундре.
        DespawnMessage: "[c/00FFFF:Криоген исчезает среди пронизывающего ветра вьюги.]"
    }
    
    DesertScourge: {
        EntryName: Пустынный бич
        SpawnInfo: Используйте [i:CalamityMod/DesertMedallion] в пустыне.
        DespawnMessage: "[c/EEE8AA:Пустынный бич погружается обратно в песок.]"
    }
    
    DevourerofGods: {
        EntryName: Пожиратель богов
        SpawnInfo: Используйте [i:CalamityMod/CosmicWorm].
        DespawnMessage: "[c/00FFFF:Пожиратель богов высокомерно возвращается в глубины Искривления.]"
    }
    
    Dragonfolly: {
        SpawnInfo: Используйте [i:CalamityMod/ExoticPheromones] в джунглях.
        DespawnMessage: "[c/FFD700:Псевдодракон возвращается в своё укромное гнездо.]"
    }
    
    ExoMechs: {
        EntryName: Экзо-механизмы
        SpawnInfo: Используйте полностью собранный Дешифратор, чтобы связаться с Дрэйдоном...
        DespawnMessage: "[c/7FFFD4:Несовершенство... какой позор.]"
    }
    
    GiantClam: {
        SpawnInfo: Может появиться естественным образом под водой в затерянном море.
        DespawnMessage: "[c/7FFFD4:Гигантский моллюск скрывается в своём гроте.]"
    }
    
    GreatSandShark: {
        SpawnInfo: Убейте 10 песчаных акул после победы над Плантерой или используйте [i:CalamityMod/SandstormsCore] в пустыне.
        DespawnMessage: "[c/DAA520:Высший хищник песков исчезает в дюнах.]"
    }
    
    HiveMind: {
        SpawnInfo: Убейте опухоль в искажении или используйте [i:CalamityMod/Teratoma] в этом биоме.
        DespawnMessage: "[c/9400D3:Разум улья улетает прочь, чтобы размножиться в другом месте.]"
    }
    
    Leviathan: {
        EntryName: Анахита и Левиафан
        SpawnInfo: Убейте неуловимую певицу в океане или используйте [i:CalamityMod/NaiadsWarhorn] в этом биоме.
        DespawnMessage: "[c/7FFFD4:Водные изгнанники возвращаются в свою уединённую обитель.]"
    }
    
    Mauler: {
        SpawnInfo:
            '''
            Появляется во время кислотного дождя после победы над Полтергастом.
            Начните кислотный дождь, используя [i:CalamityMod/CausticTear], или дождитесь его естественного начала.
            '''
        DespawnMessage: "[c/F0E68C:Жестокая акула высматривает, куда бы направить свою агрессию.]"
    }
    
    NuclearTerror: {
        SpawnInfo:
            '''
            Появляется во время кислотного дождя после победы над Полтергастом.
            Начните кислотный дождь, используя [i:CalamityMod/CausticTear], или дождитесь его естественного начала.
            '''
        DespawnMessage: "[c/F0E68C:Радиоактивная аномалия растворяется в тошнотворном свете.]"
    }
    
    OldDuke: {
        EntryName: Старый герцог
        SpawnInfo: Пройдите событие «Кислотный дождь» 3 ранга или используйте [i:CalamityMod/BloodwormItem] как наживку в сернистом море.
        DespawnMessage: "[c/F0E68C:Старый герцог отступает глубоко в кислотный ливень.]"
    }
    
    Perforators: {
        EntryName: Перфораторы
        SpawnInfo: Убейте кисту или используйте [i:CalamityMod/BloodyWormFood] в багрянце.
        DespawnMessage:"[c/DC143C:Перфораторы выискивают новых носителей, чтобы поживиться ими.]"
    }
    
    PlaguebringerGoliath: {
        SpawnInfo: Используйте [i:CalamityMod/Abombination] в джунглях.
        DespawnMessage: "[c/00FF00:ОБРАЗЦЫ ЭВТАНИЗИРОВАНЫ. ПРОТОКОЛ ВЫХОДА ИЗ БОЯ.]"
    }
    
    Polterghast: {
        EntryName: Полтергаст
        SpawnInfo: Убейте 30 фантомных духов или используйте [i:CalamityMod/NecroplasmicBeacon] в Темнице.
        DespawnMessage: "[c/B0E0E6:Нестабильный фантом рассеивается с истошным воплем.]"
    }
    
    ProfanedGuardians: {
        EntryName: Осквернённые стражи
        SpawnInfo: Используйте [i:CalamityMod/ProfanedShard] в освящении или в преисподней.
        DespawnMessage: "[c/FFA500:Богиня призывает своих стражей к себе.]"
    }
    
    Providence: {
        SpawnInfo: Используйте [i:CalamityMod/ProfanedCore] в освящении или в преисподней.
        DespawnMessage: "[c/FFA500:Осквернённая богиня окутывает себя очищающим пламенем, оставляя после себя лишь пепел...]"
    }
    
    Ravager: {
        EntryName: Разрушитель
        SpawnInfo: Используйте [i:CalamityMod/DeathWhistle].
        DespawnMessage: "[c/B22222:Разрушитель возобновляет своё бесцельное, ужасающее бесчинство.]"
    }
    
    Signus: {
        EntryName: Сигнус
        SpawnInfo: Используйте [i:CalamityMod/MarkofProvidence] в преисподней.
        DespawnMessage: "[c/BA55D3:Сигнус необъяснимым образом исчезает, словно его никогда и не было.]"
    }
    
    SlimeGod: {
        EntryName: Бог слизней
        SpawnInfo: Используйте [i:CalamityMod/OverloadedSludge].
        DespawnMessage: "[c/BA5533:Мерзкий желеобразный бог ускакал прочь, свершив свою месть.]"
    }
    
    StormWeaver: {
        EntryName: Штормовой ткач
        SpawnInfo: Используйте [i:CalamityMod/MarkofProvidence] в космосе.
        DespawnMessage: "[c/EE82EE:Штормовой ткач скрывается в свирепых, наковальнообразных облаках.]"
    }
    
    Yharon: {
        EntryName: Ярон
        SpawnInfo: Используйте [i:CalamityMod/YharonEgg].
        DespawnMessage: "[c/FFA500:Ярон взмывает в небо, выполнив свою задачу.]"
    }
}

