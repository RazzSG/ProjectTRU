        }
        
        RemoveLavaDropsFromLavaSlimes: {
            Label: "[i:LavaWaders] Отключение выпадения лавы из лавовых слизней"
            Tooltip: При включении этой настройки заменяет лавовых слизней на новых, из которых не будет выпадать лава после смерти.
        }

        RemoveReforgeRNG: {
            Label: "[i:TinHammer] Отключение случайности перековки"
            Tooltip:
                '''
                Удаляет случайность в перековке оружия и аксессуаров у гоблина-изобретателя.
                Во избежание конфликтов отключите эту настройку, если используете моды, которые сами изменяют перековку.
                '''
        }

        RipperMeterShake: {
            Label: "[i:CalamityMod/RedLightningContainer] Дрожание ярости и адреналина"
            Tooltip:
                '''
                Насколько сильно дрожат индикаторы ярости и адреналина во время использования.
                Установите значение на 0, чтобы полностью отключить дрожание.
                '''
        }

        ScreenshakePower: {
            Label: "[i:CalamityMod/WavePounder] Интенсивность дрожания экрана"
            Tooltip:
                '''
                Контролирует интенсивность дрожания экрана во время игры.
                Установите значение на 0, чтобы полностью отключить дрожание экрана.
                [c/FF232C:Все визуальные эффекты дрожания экрана сбалансированы при значении 1.]
                [c/FF232C:Более высокое значение может вызывать тошноту или дискомфорт у некоторых игроков.]
                '''
        }

        ShopNewAlert: {
            Label: "[i:GoldChest] Оповещение о новых предметах в магазине"
            Tooltip: Добавляет иконку, которая появляется над жителями, когда у них в магазине появляются новые предметы.
        }

        SpeedrunTimer: {
            Label: "[i:Stopwatch] Таймер скоростного прохождения"
            Tooltip:
                '''
                Включает внутриигровой таймер скоростного прохождения, который отображает внутриигровое время с точностью до миллисекунды.
                Во второй строке указывается время последней смерти босса.
                Время отслеживается для каждого игрока и учитывает только время, проведённое в мире.
                '''
        }

        SpeedrunTimerPosX: {
            Label: "[i:LaserRuler] Позиция по X таймера"
            Tooltip:
                '''
                Позиция по X таймера скоростного прохождения, измеряется в % от ширины экрана.
                Таймер можно перетаскивать мышью, если отключена настройка «Фиксация позиций индикаторов».
                '''
        }

        SpeedrunTimerPosY: {
            Label: "[i:LaserRuler] Позиция по Y таймера"
            Tooltip:
