                    '''
            }
            
            RustyBeaconPrototype: {
                DisplayName: Ржавый прототип маяка
                Tooltip:
                    '''
                    Призывает на помощь давно заброшенного дрона
                    Дрон парит на месте и выпускает токсичные волны, которые накладывают дебафф «{$Buffs.Irradiated.DisplayName}»
                    '''
            }
            
            SanctifiedSpark: {
                DisplayName: Сакральная искра
                Tooltip: Призывает осквернённую энергетическую турель
            }
            
            SandSharknadoStaff: {
                DisplayName: Посох песчаного акулонадо
                Tooltip: Призывает песчаный торнадо
            }
            
            SarosPossession: {
                DisplayName: Одержимость саросом
                Tooltip:
                    '''
                    Призывает сияющую ауру, которая дарует полный контроль над самим светом
                    Аура будет искоренять врагов сияющими сферами
                    Одновременно может существовать только одна аура
                    Занимает 8 слотов призываемых миньонов
                    '''
            }
            
            ScabRipper: {
                DisplayName: Гнойный потрошитель
                Tooltip: Призывает маленького кровавого ползуна
            }
            
            ShellfishStaff: {
                DisplayName: Посох моллюсков
                Tooltip:
                    '''
                    Призывает моллюска
                    Каждый моллюск занимает 2 слота призываемых миньонов
                    '''
            }
            
            Sirius: {
                DisplayName: Сириус
                Tooltip:
                    '''
                   Призывает ярчайшую звезду ночного неба озарить ваших врагов
                   Одновременно может существовать только одна звезда
                   Занимает 6 слотов призываемых миньонов
                    '''
            }
            
            SlimePuppetStaff: {
                DisplayName: Посох слизня-марионетки
                Tooltip:
                    '''
                    Призывает шар слизи, следующий за вами
                    Шар летит к ближайшим врагам и при попадании во врага взрывается, превращаясь в слизь
                    Не использует слоты призываемых миньонов
                    '''
            }
            
            SpikecragStaff: {
                DisplayName: Шипоскальный посох
                Tooltip: "[GFB]"
                TooltipNormal: Призывает шипоскала
                TooltipGFB:
                    '''
                    Призывает шипоскала
                    Победа над Осквернённой богиней раскроет его истинную силу
                    '''
            }
            
            SquirrelSquireStaff: {
                DisplayName: Посох белки-оруженосца
                Tooltip: Призывает белку-оруженосца
            }
            
            StaffOfNecrosteocytes: {
                DisplayName: Посох некростеоцита
                Tooltip:
                    '''
                    Призывает маленьких скелетов
                    Скелеты оставляют костные клетки во время движения
                    '''
            }
            
            StaffoftheMechworm: {
                DisplayName: Посох мехачервя
                Tooltip: Призывает воздушного мехачервя
            }
            
            StarspawnHelixStaff: {
                DisplayName: Звездорождённый спиральный посох
                Tooltip: Призывает астральные зонды
            }
            
            StellarTorusStaff: {
                DisplayName: Посох звёздного торуса
                Tooltip: Призывает орбитальный торус, сжигающий врагов телескопическим световым лучом
            }
            
            StormjawStaff: {
                DisplayName: Посох штормовой челюсти
                Tooltip: Призывает маленького штормового льва
            }
            
            SunSpiritStaff: {
                DisplayName: Посох солнечного духа
                Tooltip:
                    '''
                    Призывает солнечного духа
                    Одновременно может существовать только один дух
                    '''
            }
            
            TacticalPlagueEngine: {
                DisplayName: Тактический чумной двигатель
                Tooltip:
                    '''
                    Призывает чумного истребителя, сокрушающего врагов
                    Истребители используют пули из инвентаря
                    Иногда стреляют ракетой вместо пули
                    50% шанс не использовать боеприпасы
                    Ракеты не используют боеприпасы
                    '''
            }
            
            TemporalUmbrella: {
                DisplayName: Временной зонт
                Tooltip:
                    '''
                    Призывает набор инструментов, помогающих вам в бою:
                        - Киноварная стрела, пронзающая ваших врагов
                        - Мармеладный молот, эффектно громящий врагов
                        - Нефритовый топор, рассекающий монстров и иногда срубающий деревья
                        - Голубой зонт, элегантно карающий врагов
                        - Лавандовая винтовка, устраняющая тех, кто встал у вас на пути
                    А самое главное - вы получаете шляпу-цилиндр
                    Занимает 5 слотов призываемых миньонов. Одновременно можно использовать только один набор инструментов
                    'На удивление крепкий. Думаю, даже мафию можно уложить с одного удара'
                    '''
            }
            
            TundraFlameBlossomsStaff: {
                DisplayName: Посох пламенных цветков тундры
                Tooltip:
                    '''
                    Призывает три вспыхивающие орхидеи над вашей головой
                    Каждый цветок занимает один слот призываемых миньонов
                    '''
            }
            
            UniverseSplitter: {
                DisplayName: Рассекатель вселенной
                Tooltip:
                    '''
                    Призывает энергетическое поле в позицию курсора
                    После развёртывания поле начинает излучать множество маленьких лучей
                    Через несколько секунд на месте поля появляется огромный лазерный луч
                    Этот эффект имеет перезарядку
                    Попытка использовать этот предмет во время перезарядки приведёт к короткому замыканию и нанесёт вам урон
                    [c/BB57FF:'Древний артефакт прошедших времён ожидает только вашего приказа]
                    [c/BB57FF:Отвратительная идея, но ведь не ваша... Верно?']
                    '''
            }
            
            VengefulSunStaff: {
                DisplayName: Посох мстительного солнца
                Tooltip:
                    '''
                    Призывает мстительного солнечного духа
                    Одновременно может существовать только один дух
                    '''
            }
            
            Vigilance: {
                DisplayName: Линчевание
                Tooltip: Призывает искателя душ
            }
            
            VileFeeder: {
                DisplayName: Гнусный кормилец
                Tooltip: Призывает маленького пожирателя душ
            }
            
            ViralSprout: {
                DisplayName: Паразитный росток
                Tooltip:
                    '''
                    Призывает духов полыни
                    Духи накладывают дебафф «{$Buffs.SagePoison.DisplayName}», который усиливается от количества призванных духов
                    '''
            }
            
            ViridVanguard: {
                DisplayName: Изумрудный авангард
                Tooltip: Призывает круговую комбинацию клинков, которые кромсают ближайших врагов на кусочки
            }
            
            VoidConcentrationStaff: {
                DisplayName: Концентратор пустоты
                Tooltip:
                    '''
                    Призывает зловещую ауру, которая атакует, стреляя сгустками пустоты
                    Пока аура активна, увеличивает урон призывателя на 5%
                    Занимает 3 слота призываемых миньонов
                    Одновременно может существовать только одна аура
                    Нажмите <right>, чтобы запустить чёрную дыру, которая увеличивается в размерах
                    '''
            }
            
            WarloksMoonFist: {
                DisplayName: Лунный кулак чернокнижника
                Tooltip:
                    '''
                    Призывает неземной кулак, избивающий врагов
                    Занимает 4 слота призываемых миньонов
                    '''
            }
            
            WitherBlossomsStaff: {
                DisplayName: Посох увядшего соцветия
                Tooltip:
                    '''
                    Призывает четыре разлагающихся цветка над вашей головой
                    Совокупность цветов занимает два слота призываемых миньонов
                    '''
            }
            
            WulfrumController: {
                DisplayName: Вульфрумовый контроллер
                Tooltip:
                    '''
                    Призывает вульфрумового дроида
                    Удерживайте <right>, держа в руках контроллер, чтобы переключить всех ваших дронов в режим сверхзаряда
                    В режиме сверхзаряда дроиды перестают атаковать и начинают концентрировать вульфрумовую энергию на вас
                    В режиме сверхзаряда дроиды увеличивают регенерацию здоровья на 0.5 и защиту на 3 за каждого дроида
                    Также можно использовать для лечения других игроков, если расположить курсор достаточно близко к ним
                    '''
            }
            
            YharonsKindleStaff: {
                DisplayName: Воспламеняющий посох Ярона
                Tooltip:
                    '''
                    Призывает огненного драконида
                    Занимает 5 слотов призываемых миньонов
                    '''
            }
            
            MutatedTruffle: {
                DisplayName: Мутировавший трюфель
                Tooltip:
                    '''
                    Призывает юного рыброна, который облучает ваших врагов
                    Рыброн циклично переключается между рывками, снарядами и тайфуном
                    Занимает 3 слота призываемых миньонов
                    Может быть только один
                    '''
            }
            
            HarvestStaff: {
                DisplayName: Посох жатвы
                Tooltip:
                    '''
                    Выращивает тыквенную грядку, рядом с которой прорастают тыквы
                    Тыквы выпрыгивают, когда к ним приближаются существа или игроки
                    Выпрыгнув, они агрессивно атакуют врагов и взрываются при столкновении
                    'А в голове один ветер гуляет'
                    '''
            }
            
            LiliesOfFinality: {
                DisplayName: Лилии завершённости
                Tooltip:
                    '''
                    Занимает 2 слота призываемых миньонов
                    Одновременно может существовать только одна пара
                    'Проснись'
                    '''
            }
        }
        
        Typeless: {
            Aestheticus: {
                DisplayName: Эстетикус
                Tooltip:
                    '''
                    Стреляет кристаллами, которые взрываются и замедляют врагов
                    На урон оружия влияют все бонусы, увеличивающие урон
                    '''
            }
            
            EyeofMagnus: {
                DisplayName: Око Магнуса
                Tooltip:
                    '''
                    Стреляет мощными самонаводящимися лучами, которые снижают защиту врага
                    Восстанавливает здоровье и ману при попадании
                    На урон оружия влияют все бонусы, увеличивающие урон
                    '''
            }
            
            LunicEye: {
                DisplayName: Лунный глаз
                Tooltip:
                    '''
                    Стреляет самонаводящимися лунными лучами, которые снижают сопротивление врага
                    На урон оружия влияют все бонусы, увеличивающие урон
                    '''
            }
            
            RelicOfDeliverance: {
                DisplayName: Реликвия освобождения
                Tooltip:
                    '''
                    Нажмите <left>, чтобы зарядить копьё для рывка
                    Нажмите <left> повторно, чтобы совершить рывок в направлении курсора
                    Во время рывка удерживайте <left>, чтобы изменить направление атаки в сторону курсора
                    Переключение на другой предмет сбрасывает заряд для рывка
                    '''
            }
            
            RelicOfResilience: {
                DisplayName: Реликвия устойчивости
                Tooltip:
                    '''
                    Призывает артефакт в место расположения курсора
                    Артефакт получает урон от врагов и снарядов
                    После разрушения артефакта он разрывается на вращающиеся осколки
                    Если враг находится в области осколков, его следующая атака будет на 45% слабее
                    Этот эффект имеет перезарядку
                    Через 5 секунд осколки соединятся вместе и воссоздадут первоначальный артефакт
                    Это воссоздание может произойти 3 раза, прежде чем его нужно будет вновь призвать
                    При вызове нового артефакта вы получаете 5 секундную перезарядку
                    Если артефакт уже существует, использование этого предмета переместит его к курсору
                    '''
            }
            
            Skynamite: {
                DisplayName: Небеснамит
                Tooltip:
                    '''
                    Бросает лёгкую взрывчатку, которая игнорирует гравитацию
                    'Для её использования не требуется степень в аэродинамике'
                    '''
            }
            
            StarStruckWater: {
                DisplayName: Поражённая звёздами вода
                Tooltip: Распространяет астральную инфекцию на некоторые блоки
            }
            
            YanmeisKnife: {
                DisplayName: Нож Янмэй
                Tooltip:
                    '''
                    Калечит врагов, по которым вы попадаете
                    Попадания также увеличивают вашу скорость передвижения и урон на 10 секунд
                    'Нож из неизвестного мира
                    Владелец, чьё сердце чисто и невинно
                    Сердце из железа и доблести'
                    '''
            }
        }
    }
}

