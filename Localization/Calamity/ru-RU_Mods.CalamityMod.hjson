        On: {
            Label: Всегда включено
            Tooltip: Активация двойным нажатием всегда включена. Можно использовать одновременно с клавишей «{$Keybinds.ArmorSetBonus.DisplayName}» из Calamity.
        }
    
        Auto: {
            Label: Автоматически
            Tooltip: Автоматически отключает двойное нажатие, если назначена клавиша «{$Keybinds.ArmorSetBonus.DisplayName}» из Calamity.
        }
    
        Off: {
            Label: Всегда выключено
            Tooltip: Активация двойным нажатием всегда отключена. Используйте это для полного запрета активации бонуса комплекта данным способом.
        }
    }
    
    TileBlendingQuality: {
