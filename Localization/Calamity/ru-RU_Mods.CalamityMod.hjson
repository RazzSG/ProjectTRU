    Weapons: {
        DraedonsArsenal: {
            FrequencyManipulator: {
                DisplayName: Частотный манипулятор
                Tooltip:
                    '''
                    Размахивает копьём, а затем бросает его
                    При столкновении копьё высвобождает всплеск самонаводящейся энергии
                    При скрытном ударе копьё высвобождает больший всплеск энергии и взрывается при столкновении
                    [c/1FFBFF:'Длинное устройство, используемое при настройке некоторых весьма... оригинальных машин']
                    '''
            }
            
            GalvanizingGlaive: {
                DisplayName: Гальванизирующая глефа
                Tooltip:
                    '''
                    Размахивает копьём, которое окутывает поражённых врагов энергетическим полем
                    Когда вы заканчиваете размахивать, копьё разряжает дополнительный импульс энергии
                    [c/1FFBFF:'Инструмент, который быстро и аккуратно разделит один объект на два]
                    [c/1FFBFF:Его эффективность и надёжность в качестве оружия не вызывают сомнений']
                    '''
            }
            
            GatlingLaser: {
