                '''
            Tooltip: ""
        }
        
        LoreQueenSlime: {
            DisplayName: История (Королева слизней)
            Lore:
                '''
                После того как ты обратил Бога слизней в бегство, похоже, он создал нового стража из высвободившихся сущностей
                Поглощённый процессом впитывания новообретённой силы... он уже не мог сбежать
