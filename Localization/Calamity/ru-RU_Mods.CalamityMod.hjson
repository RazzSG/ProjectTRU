    Weapons: {
        DraedonsArsenal: {
            AerialTracker: {
                DisplayName: П-ЛЗР: Воздушный наводчик
                Tooltip:
                    '''
                    Выпускает летающий диск, обстреливающий лазерами ближайших врагов
                    Лазеры не наносят прямой урон, а накладывают суммирующийся эффект лазерного ожога
                    При достаточном количестве попаданий или по истечении времени ожог наносит прямой урон
                    При возвращении к игроку диск постепенно ускоряется
                    При скрытном ударе выпускает два диска, стреляющих по нескольким целям с большего расстояния
                    '''
            }
            
            AqueousHunterDrone: {
                DisplayName: П-ПЛЗ: Водный охотничий дрон
                Tooltip:
                    '''
                    Призывает дрона-креветку, выпускающего залпы самонаводящихся плазменных ракет
                    Нажмите <right>, держа любое оружие призывателя в руках, чтобы приказать дрону произвести вертикальный ракетный залп
                    Вертикальные ракеты летят в сторону курсора и создают остаточные взрывы при ударе о поверхность
                    Каждый дрон занимает 4 слота миньонов
                    [c/1FFBFF:'Преследуя приверженцев богов, Ярим верил, что нельзя оставлять без внимания ни единой детали]
                    [c/1FFBFF:Разработке вооружения для подводных операций уделялось необычайно много внимания, но ни одна модель так и не была введена в эксплуатацию']
                    '''
            }
            
            Auger: {
                DisplayName: П-ГСС: Шнек
                Tooltip:
                    '''
                    Наручное устройство, генерирующее магнитный энергетический клинок
                    Нажмите <right>, чтобы создать кратковременное магнитное поле в точке курсора и усилить следующий удар
                    [c/1FFBFF:'Изначально предназначался для распиливания и отделения глыб сырья для транспортировки]
                    [c/1FFBFF:Возможность оставить руки свободными без потери мощности сделала его исключительно эргономичным']
                    '''
            }
            
            CountermeasureMitt: {
                DisplayName: Ч-ЛЗР: Перчатка контрмер
                Tooltip:
                    '''
                    Высокоточная сварочная перчатка с лазерными излучателями на кончиках пальцев
                    Нажмите <right>, чтобы сфокусировать все излучатели в мощный залп из ладони, который всегда наносит критический удар
                    У ладонного залпа есть перезарядка, которая значительно короче при промахе
                    [c/1FFBFF:'Большинство батальонов предпочитают либо атаку по площади, либо концентрацию огня на одной цели]
                    [c/1FFBFF:Эта перчатка подходит для обоих случаев, хотя она никогда не сотрёт грань между этими тактиками']
                    '''
            }
            
            GalvanizingGlaive: {
                DisplayName: Гальванизирующая глефа
                Tooltip:
                    '''
                    Размахивает копьём, которое окутывает поражённых врагов энергетическим полем
                    Когда вы заканчиваете размахивать, копьё разряжает дополнительный импульс энергии
                    [c/1FFBFF:'Инструмент, способный быстро и аккуратно разделить один объект на два]
                    [c/1FFBFF:Его эффективность и надёжность в качестве оружия не вызывают сомнений']
                    '''
            }
            
            HolofibreImmolator: {
                DisplayName: Р-ПЛЗ: Головолоконный сжигатель
                Tooltip:
                    '''
                    Выпускает три подверженные гравитации плазменные капли, прожигающие врагов насквозь
                    Удерживайте <left>, чтобы быстро зарядить лук и выпустить высокоскоростную плазменную стрелу
                    Плазменные стрелы взрываются при попадании; взрыв усиливается, если стрела застряла в блоке
                    Удерживайте <right>, чтобы вести непрерывный огонь незаряженными снарядами
                    Удерживайте <right> и <left>, чтобы автоматически стрелять заряженными стрелами с чуть меньшей скоростью
                    [c/1FFBFF:'Изящество головолокна несравненно]
                    [c/1FFBFF:Тем не менее, механическое натяжение могло бы дать более стабильные результаты']
                    '''
            }
            
            HydraulicVoltCrasher: {
                DisplayName: Гидравлический вольтовый крушитель
                Tooltip:
                    '''
                    Электрически заряженный отбойный молоток, бьющий током всех ближайших врагов при попадании
                    Нажмите <right>, чтобы использовать без разрушения фоновых стен
                    [c/1FFBFF:'Устройство для электрического штампования металлических пластин путём их мгновенного сплавления]
                    [c/1FFBFF:Естественно, его также можно использовать как разрушительное оружие']
                    '''
            }
            
            MountedScanner: {
                DisplayName: Смонтированный сканер
                Tooltip: Призывает парящее над вашей головой мощное оружие, которое стреляет лазерами по ближайшим врагам
            }
            
            Nidhogg: {
                DisplayName: Ч-ГСС: Нидхёгг
                Tooltip:
                    '''
                    Энергетический рельсотрон на магнитной тяге, обладающий высокой скорострельностью и создающий при попадании остаточные магнитные имплозии, притягивающие слабых врагов
                    Одновременно может существовать только одна имплозия
                    Нажмите <right>, чтобы начать зарядку сокрушительного энергетического луча, всегда наносящего критический удар и выстреливающего автоматически при полной зарядке
                    Эту атаку нельзя прервать после начала, и она имеет длительную перезарядку
                    [c/1FFBFF:'Многие солдаты недооценивают разрушительный потенциал магнетизма]
                    [c/1FFBFF:Этот рельсотрон надёжно притянул к себе скептиков, сомневавшихся в его сокрушительной эффективности']
                    '''
            }
            
            PhalanxSurge: {
                DisplayName: Б-ЛЗР: Натиск фаланги
                Tooltip:
                    '''
                    Стреляет разбросом лазеров
                    Удерживайте <right>, чтобы зарядить оружие и совершить выпад вперёд, пронзая врагов энергетическим копьём
                    Если при совершении заряженной атаки удерживать <left>, вы совершите стремительный рывок вперёд и нанесёте дополнительный урон
                    Использование заряженной атаки имеет короткую перезарядку
                    [c/1FFBFF:'В войсках Ярима был большой спрос на вооружение ближнего боя]
                    [c/1FFBFF:Лазерное копьё, предназначенное для растерзания врагов, было встречено громогласными аплодисментами']
                    '''
            }
            
            Phaseslayer: {
                DisplayName: Фазовый палач
                Tooltip:
                    '''
                    Проецирует гигантский лазерный клинок, управляемый движением курсора
                    Двигайте курсором, чтобы размахивать клинком и разрывать врагов на части
                    Быстрые взмахи наносят больше урона и выпускают дополнительные лучи в форме мечей
                    '''
            }
            
            PlasmaCaster: {
                DisplayName: Плазмолив
                Tooltip:
                    '''
                    Нажмите <left>, чтобы выстрелить большим взрывающимся плазменным снарядом
                    Нажмите <right>, чтобы стрелять в турбо-режиме, увеличивая скорострельность ценой снижения точности
                    '''
            }
            
            PlasmaGrenade: {
                DisplayName: Плазменная граната
                Tooltip:
                    '''
                    Бросает гранату, которая взрывается плазмой при столкновении
                    При скрытном ударе граната вызывает мощный испаряющий взрыв
                    [c/1FFBFF:'Каждая граната содержит конденсированный блок сверхнагретой плазмы. Используйте с крайней осторожностью']
                    '''
            }
            
            PoleWarper: {
                DisplayName: Искажатель полюса
                Tooltip:
                    '''
                    Призывает пару парящих магнитов, которые отталкиваются друг от друга и неистово атакуют врагов
                    Эти магнитные устройства разрывают врагов, используя силу взаимного отталкивания
                    '''
            }
            
            PulseDragon: {
                DisplayName: Импульсный дракон
                Tooltip:
                    '''
                    Бросает две драконьи головы, излучающие разрушительные электрические поля
                    [c/1FFBFF:'Ярим настоял на том, чтобы это оружие было создано по образу драконов древности]
                    [c/1FFBFF:Как банально']
                    '''
            }
            
            PulseGrenade: {
                DisplayName: Р-ИМП: Импульсная граната
                Tooltip:
                    '''
                    Самовосстанавливающаяся граната, преследующая врагов и разрывающаяся на 8 импульсных сфер
                    Сферы возвращаются к вам, воссоздавая гранату и поражая всё на своём пути
                    При скрытном ударе метает гранату на высокой скорости, при этом она разлетается на вдвое большее количество сфер
                    '''
            }
            
            PulsePistol: {
                DisplayName: П-ИМП: Импульсный пистолет
                Tooltip:
                    '''
                    Стреляет импульсной сферой, наводящейся на ближайшие цели
                    При попадании во врага сфера разделяется надвое
                    Пронзающая способность сферы увеличивается при убийстве врагов
                    '''
            }
            
            PulseRifle: {
                DisplayName: А-ИМП: Импульсная винтовка
                Tooltip:
                    '''
                    Стреляет усиленным импульсным лучом, который при попадании распадается на 4 высокочастотные импульсные сферы
                    Эти сферы активно преследуют ближайшие цели и с каждым попаданием ускоряются
                    Пронзающая способность импульсных сфер не снижается при убийстве врагов или нанесении низкого урона
                    [c/1FFBFF:'Моё собственное оружие, предназначенное для уничтожения неудачных созданий]
                    [c/1FFBFF:Я создал резервную копию схем на случай уничтожения оригинала']
                    '''
            }
            
            PulseTurretRemote: {
                DisplayName: Пульт управления импульсной турелью
                Tooltip:
