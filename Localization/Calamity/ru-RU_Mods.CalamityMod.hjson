            RustyBeaconPrototype: {
                DisplayName: Ржавый прототип маяка
                Tooltip:
                    '''
                    {$CommonItemTooltip.Sentry}
                    Призывает давно заброшенного дрона, который пассивно излучает волны радиации
                    '''
            }
            
            SanctifiedSpark: {
                DisplayName: Сакральная искра
                Tooltip:
                    '''
                    {$CommonItemTooltip.Sentry}
                    Призывает дружелюбного жертвенника, парящего рядом с вами
                    Жертвенники стреляют самонаводящимися огнями по ближайшим врагам, после чего возвращаются к вам
                    После атаки жертвенники выпускают в вас по одному исцеляющему заряду за каждые 4 слота миньонов
                    'Может, они и навязчивы, но зато от них веет теплом'
                    '''
            }
            
            SandSharknadoStaff: {
                DisplayName: Посох песчаного акулонадо
                Tooltip: Призывает песчаный торнадо
            }
            
            SarosPossession: {
                DisplayName: Одержимость саросом
                Tooltip:
                    '''
                    Призывает сияющую ауру, черпающую силу из первородного света
                    Повторные призывы усиливают ауру
                    Удерживайте <left>, когда все слоты миньонов заняты, чтобы выпустить луч затмения, со временем ослабевающий
                    Когда луч не используется, он перезаряжается
                    '''
            }
            
            ScabRipper: {
                DisplayName: Гнойный потрошитель
                Tooltip: Призывает маленького кровавого ползуна
            }
            
            ShellfishStaff: {
                DisplayName: Посох моллюсков
                Tooltip:
                    '''
                    Призывает моллюска
                    Каждый моллюск занимает 2 слота миньонов
                    '''
            }
            
            Sirius: {
                DisplayName: Сириус
                Tooltip:
                    '''
                    Призывает Сириус - ярчайшую звезду на небосклоне
                    Продолжайте призывать, чтобы собрать созвездие Большого Пса
                    Повторные призывы значительно увеличивают его мощь, даже после завершения созвездия
                    Сириус пассивно создаёт звёздные вспышки, когда целится во врагов
                    При максимальном количестве вспышек Сириус поглощает их, чтобы выпустить мощный пронзающий квазар, накладывающий дебафф [cbuff:CalamityMod/Voidfrost]
                    'Проводник к мечте, которой не суждено было сбыться'
                    '''
            }
            
            SlimePuppetStaff: {
                DisplayName: Посох слизня-марионетки
                Tooltip:
                    '''
                    Призывает шар слизи, следующий за вами
                    Шар летит к ближайшим врагам и при попадании во врага взрывается, превращаясь в слизь
                    Не использует слоты миньонов
                    '''
            }
            
            SpikecragStaff: {
                DisplayName: Шипоскальный посох
                Tooltip: "[GFB]"
                TooltipNormal:
                    '''
                    {$CommonItemTooltip.Sentry}
                    Призывает скопление сталагмитов, осыпающее врагов шипами
                    '''
                TooltipGFB:
                    '''
                    {$CommonItemTooltip.Sentry}
                    Призывает скопление сталагмитов, осыпающее врагов шипами
                    Победа над Осквернённой богиней раскроет его истинную силу
                    '''
            }
            
            SquirrelSquireStaff: {
                DisplayName: Посох белки-оруженосца
                Tooltip:
                    '''
                    {$CommonItemTooltip.Sentry}
                    Призывает белку, бросающую жёлуди во врагов
                    '''
            }
            
            StaffOfNecrosteocytes: {
                DisplayName: Посох некростеоцита
                Tooltip:
                    '''
                    Призывает маленьких скелетов
                    Скелеты оставляют костные клетки во время движения
                    '''
            }
            
            StarspawnHelixStaff: {
                DisplayName: Звездорождённый спиральный посох
                Tooltip: Призывает астральные зонды, накладывающие дебафф [cbuff:CalamityMod/AstralInfectionDebuff]
            }
            
            StellarTorusStaff: {
                DisplayName: Посох звёздного торуса
                Tooltip: Призывает орбитальный торус, сжигающий врагов телескопическим световым лучом
            }
            
            StormjawStaff: {
                DisplayName: Посох штормовой челюсти
                Tooltip: Призывает маленького штормового льва
            }
            
            SunSpiritStaff: {
                DisplayName: Посох солнечного духа
                Tooltip:
                    '''
                    Призывает солнечного духа
                    Повторные призывы увеличивают его мощь
                    '''
            }
            
            TacticalPlagueEngine: {
                DisplayName: Тактический чумной двигатель
                Tooltip:
                    '''
                    Призывает чумного истребителя, сокрушающего врагов
                    Истребители используют пули из инвентаря
                    Иногда стреляют ракетой вместо пули
                    50% шанс не использовать боеприпасы
                    Ракеты не используют боеприпасы
                    '''
            }
            
            TemporalUmbrella: {
                DisplayName: Временной зонт
                Tooltip:
                    '''
                    Призывает набор инструментов, помогающих вам в бою:
                        - Киноварная стрела, пронзающая ваших врагов
                        - Мармеладный молот, эффектно громящий врагов
                        - Нефритовый топор, рассекающий монстров и иногда срубающий деревья
                        - Голубой зонт, элегантно карающий врагов
                        - Лавандовая винтовка, устраняющая тех, кто встал у вас на пути
                    А самое главное - вы получаете шляпу-цилиндр
                    Занимает 5 слотов миньонов. Одновременно можно использовать только один набор инструментов
                    'На удивление крепкий. Думаю, даже мафию можно уложить с одного удара'
                    '''
            }
            
            TundraFlameBlossomsStaff: {
                DisplayName: Посох пламенных цветков тундры
                Tooltip:
                    '''
                    Призывает три вспыхивающие орхидеи над вашей головой
                    Каждый цветок занимает один слот миньонов
                    '''
            }
            
            UniverseSplitter: {
                DisplayName: Рассекатель вселенной
                Tooltip:
                    '''
                    Призывает энергетическое поле в позицию курсора
                    После развёртывания поле начинает излучать множество маленьких лучей
                    Через несколько секунд на месте поля появляется огромный лазерный луч
                    Этот эффект имеет 30 секунд перезарядки
                    Попытка использовать этот предмет во время перезарядки приведёт к короткому замыканию и нанесёт вам урон
                    [c/BB57FF:'Древний артефакт прошедших времён ожидает только вашего приказа]
                    [c/BB57FF:Отвратительная идея, но ведь не ваша... Верно?']
                    '''
            }
            
            VengefulSunStaff: {
                DisplayName: Посох мстительного солнца
                Tooltip:
                    '''
                    Призывает солнечного духа
                    Повторные призывы затмевают духа, увеличивая его мощь
                    '''
            }
            
            Vigilance: {
                DisplayName: Линчевание
                Tooltip: Призывает искателя душ
            }
            
            VileFeeder: {
                DisplayName: Гнусный кормилец
                Tooltip: Призывает маленького пожирателя душ
            }
            
            ViralSprout: {
                DisplayName: Паразитный росток
                Tooltip:
                    '''
                    Призывает духов полыни
                    Духи накладывают дебафф [cbuff:CalamityMod/SagePoison], который усиливается от количества призванных духов
                    '''
            }
            
            ViridVanguard: {
                DisplayName: Изумрудный авангард
                Tooltip:
                    '''
                    Поочерёдно призывает топоры и мечи, пропитанные сильным ядом
                    Топоры вращаются вокруг игрока, нанося огромный урон вблизи
                    Мечи преследуют врагов с предельной точностью, разрывая их на части
                    Призванное оружие накладывает дебафф [cbuff:CalamityMod/SagePoison], усиливающийся с ростом числа призванных единиц оружия
                    Если все слоты миньонов заняты, нажмите <left> ещё раз, чтобы запустить шквал разрезов в направлении курсора
                    Эта способность имеет 5 секунд перезарядки и срабатывает только при удержании предмета в руках
                    Нажмите Shift+<right> по этому предмету в инвентаре, чтобы изменить направление вращения
                    '''
            }
            
            VoidConcentrationStaff: {
                DisplayName: Концентратор пустоты
                Tooltip:
                    '''
                    Призывает зловещую ауру, которая атакует, стреляя сгустками пустоты
                    Пока аура активна, увеличивает урон призывателя на 5%
                    Занимает 3 слота миньонов
                    Одновременно может существовать только одна аура
                    Нажмите <right>, чтобы запустить чёрную дыру, которая увеличивается в размерах
                    '''
            }
            
            VoidEaterMarionette: {
                DisplayName: Марионетка Пожирателя пустоты
                Tooltip:
                    '''
                    Таит в себе силу для управления миниатюрным Пожирателем
                    Повторные призывы увеличивают длину и мощь его сегментов
                    Пожиратель атакует при помощи [c/ff00ff:Пожирателя божественности], [c/ff00ff:Испепелителя веры] и [c/ff00ff:Сверхкосмического водоворота]
                    Способен приносить владельцу выпавшие предметы
                    Нажмите Shift+<right> по этому предмету в инвентаре, когда Пожиратель призван, чтобы он отдавал приоритет подбору предметов
                    '''
            }
            
            WarloksMoonFist: {
                DisplayName: Лунный кулак чернокнижника
                Tooltip:
                    '''
                    Призывает неземной кулак, избивающий врагов
                    Занимает 4 слота миньонов
                    '''
            }
            
            WitherBlossomsStaff: {
                DisplayName: Посох увядшего соцветия
                Tooltip:
                    '''
                    Призывает четыре разлагающихся цветка над вашей головой
                    Совокупность цветов занимает два слота миньонов
                    '''
            }
            
            WulfrumController: {
                DisplayName: Вульфрумовый контроллер
                Tooltip:
                    '''
                    Призывает вульфрумового дроида
                    Удерживайте <right>, держа в руках контроллер, чтобы переключить всех ваших дронов между обычным режимом и режимом сверхзаряда
                    В режиме сверхзаряда дроиды перестают атаковать и начинают концентрировать вульфрумовую энергию на вас
                    В режиме сверхзаряда каждый дроид увеличивает регенерацию здоровья на 0,5 ед./сек и защиту на 3
                    Также можно использовать для лечения других игроков, если расположить курсор достаточно близко к ним
                    '''
            }
            
            YharonsKindleStaff: {
                DisplayName: Воспламеняющий посох Ярона
                Tooltip:
                    '''
                    Призывает огненного драконида
                    Занимает 5 слотов миньонов
                    '''
            }
            
            MutatedTruffle: {
                DisplayName: Мутировавший трюфель
                Tooltip:
                    '''
                    Призывает юного рыброна, который облучает ваших врагов
                    Рыброн циклично переключается между рывками, снарядами и тайфуном
                    Занимает 3 слота миньонов
                    Может быть только один
                    '''
            }
            
            HarvestStaff: {
                DisplayName: Посох жатвы
                Tooltip:
                    '''
                    {$CommonItemTooltip.Sentry}
                    Выращивает тыквенную грядку, рядом с которой прорастают тыквы
                    Тыквы выпрыгивают, когда к ним приближаются существа или игроки
                    Выпрыгнув, они агрессивно атакуют врагов и взрываются при столкновении
                    'А в голове один ветер гуляет'
                    '''
            }
            
            LiliesOfFinality: {
                DisplayName: Лилии завершённости
                Tooltip:
                    '''
                    Занимает 2 слота миньонов
                    Одновременно может существовать только одна пара
                    'Проснись'
                    '''
            }
        }
        
        Typeless: {
            Aestheticus: {
                DisplayName: Эстетикус
                Tooltip:
                    '''
                    Стреляет кристаллами, которые взрываются и замедляют врагов
                    На урон оружия влияют все бонусы, увеличивающие урон
                    '''
            }
            
            ClaretCannon: {
                DisplayName: Бордовая пушка
                Tooltip:
                    '''
                    Выстреливает сверхплотным бордовым снарядом
                    Он взрывается при попадании во врага и выпускает кровавые сферы
                    Взрыв разрывает врагов на части, накладывает дебафф [cbuff:CalamityMod/Laceration] и значительно снижает их защиту
                    Подбор кровавых сфер сокращает длительность дебаффа [cbuff:PotionSickness], если это возможно
                    Если дебафф [cbuff:PotionSickness] отсутствует, ваша естественная регенерация усиливается
                    Можно стрелять только раз в 10 секунд
                    '''
            }
            
            ColdheartIcicle: {
                DisplayName: Сосулька холодного сердца
                Tooltip: "'У(лёд)ная работа'"
            }
            
            EyeofMagnus: {
                DisplayName: Око Магнуса
                Tooltip:
                    '''
                    Выпускает самонаводящиеся космические сгустки, которые восстанавливают здоровье и ману при попадании
                    Взрывается облаком туманности, которое снижает защиту врагов
                    Урон оружия зависит от среднего показателя всех ваших характеристик урона
                    '''
            }
            
            LunicEye: {
                DisplayName: Лунное око
                Tooltip:
                    '''
                    Выпускает самонаводящиеся энергетические разряды, которые снижают сопротивление врага
                    Урон оружия зависит от среднего показателя всех ваших характеристик урона
                    '''
            }
            
            RelicOfDeliverance: {
                DisplayName: Реликвия освобождения
                Tooltip:
                    '''
                    Нажмите <left>, чтобы сесть на копьё; удерживайте <left>, чтобы разогнать его, постепенно замедляясь
                    Отпустите <left>, чтобы совершить скоростной рывок; во время битвы с боссом скорость снижается вдвое
                    Если во время зарядки слишком сильно потерять скорость, рывок сорвётся, а скорость будет сброшена
                    Рывок позволяет вам проноситься сквозь врагов и проходить сквозь блоки
                    Слишком долгое пребывание внутри блоков телепортирует вас обратно в точку входа
                    Нажмите <right>, чтобы слезть
                    Пока копьё находится в руках, урон всех миньонов значительно снижается
                    [c/FF8C00:Мною двигала месть, я не помышляла ни о чём, кроме возмездия]
                    [c/FF8C00:Дракон отнял у меня всё, оставив лишь мои обломки, разбросанные по земле]
                    [c/FF8C00:Но, сражаясь рядом с Ней, я поняла, что всё ещё есть то, за что стоит бороться]
                    '''
            }
            
            Skynamite: {
                DisplayName: Небеснамит
                Tooltip:
                    '''
                    Бросает лёгкую взрывчатку, которая игнорирует гравитацию
                    'Для её использования не требуется степень в аэродинамике'
                    '''
            }
            
            StarStruckWater: {
                DisplayName: Поражённая звёздами вода
                Tooltip: Распространяет астральную инфекцию на некоторые блоки
            }
            
            StratusSphere: {
                DisplayName: Стратус сфера
                Tooltip:
                    '''
                    Выпускает сингулярность, воздействующую на всех существ в большом радиусе
                    Находясь под её действием, игроки постепенно накапливают звёздные вспышки
                    Звёздные вспышки продлевают полёт после исчерпания времени полёта
                    Нажмите <right>, чтобы преобразовать вспышки в барьер, расходующий их вместо здоровья при получении урона
                    Запуск сингулярности отключает барьер, а активация барьера деактивирует сингулярность
                    'Превращение душ в звёзды - бессмысленная затея'
                    '''
            }
        }
    }
}

