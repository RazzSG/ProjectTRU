            SuperradiantSlaughterer: {
                DisplayName: Сверхизлучающий мясник
                Tooltip:
                    '''
                    [MAIN]
                    [ALT]
                    [c/c91a1a:'Никто не знает, как он превращает кровь в радугу...']
