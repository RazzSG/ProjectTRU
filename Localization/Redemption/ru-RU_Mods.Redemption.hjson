    Holoshield: {
        DisplayName: Голографический щит
        Tooltip:
            '''
            Увеличивает сопротивление урону на 6%; на 16% против урона, не относящегося к школе элементов
            Дважды нажмите в нужном направлении, чтобы совершить рывок
            Рывок в сторону снаряда отражает его
            Не отражает снаряды, наносящие более 200 единиц урона
            '''
    }

    InfectionShield: {
        DisplayName: Заражённый терновый щит
        Tooltip:
            '''
            Дважды нажмите в нужном направлении, чтобы совершить рывок
            Увеличивает шанс критического удара ближнего боя на 4%
            При рывке сквозь врага заражает его инфекцией
            Во время движения испускает кислотные искры
            '''
    }

    MicroshieldCore: {
        DisplayName: Нанозащитное ядро
        Tooltip:
            '''
