    LunarShot: {
        DisplayName: Лунный выстрел
        Tooltip:
            '''
            Заменяет деревянные стрелы на лунные заряды, наносящие урон {0}, {1} и {2}
            Лунные заряды призывают летучих мышей, но только если на небе видна луна
            Призывает дополнительную летучую мышь во время полнолуния
            '''
    }

    PureIronCrossbow: {
        DisplayName: Арбалет железного царства
        Tooltip:
            '''
            Заменяет обычные стрелы на морозные, которые прилипают к врагам и через некоторое время вызывают ледяной взрыв
            Урон от взрыва увеличивается с каждой стрелой, попавшей в цель, и может замораживать большинство врагов
            Врагов, невосприимчивых к отбрасыванию, нельзя заморозить
            '''
    }

    SilverwoodBow: {
        DisplayName: Сребродревый лук Дэрела
        Tooltip:
            '''
            20% шанс не использовать боеприпасы
            Выпускает сребродревые стрелы, которые впиваются во врагов и поглощают их здоровье
            '''
        Lore:
            '''
            'Подарок Силлессы, полулесной нимфы, преподнесённый Дэрелу во время тренировок
            Древесина лука старше самого времени, а тетива соткана из гибкой золотой нити. Он способен выпускать стрелы с невероятной скоростью'
            '''
    }

    BlazingBalisong: {
