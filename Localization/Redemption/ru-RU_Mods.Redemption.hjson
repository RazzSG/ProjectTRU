    InSoullessCaverns: Находясь в бездушных пещерах
    ForestNymphTrust: Заслужив доверие Лесной нимфы
    OldTophat: После исчезновения подвешенного скелета
    ElementBookObtained: После получения книги от Странника
    ElementBookQuest: После заполнения Книги бонусов
    InSavanna: В саванне
    NotInSavanna: За пределами саванны
}

Configs: {
    RedeConfigClient: {
        DisplayName: Личная конфигурация

        NoBossIntroText: {
            Label: Отключить представление боссов в стиле Zelda
            Tooltip: Отключает текстовое представление боссов, выполненное в стиле The Legend of Zelda.
        }
    
        CameraLockDisable: {
            Label: Отключить фиксацию камеры
            Tooltip:
                '''
                Отключает фиксацию камеры во время кат-сцен, а также временную неуязвимость и затемнение по краям экрана.
                Не рекомендуется, особенно при первом прохождении, так как это может испортить задуманное разработчиками впечатление.
                '''
        }

        ElementalDamageTooltipStyle: {
            Label: Стиль элементального урона
            Tooltip: Определяет способ отображения усилений элементального урона в описании оружия или отключает их.
        }
        
        NoFlyBuzz: {
            Label: Отключить жужжание мух
            Tooltip: Мухи становятся бесшумными
        }
        
        DialogueInChat: {
            Label: Показывать диалоги кат-сцен в чате
            Tooltip: Диалоги из кат-сцен, Чаши мировоззрения, а также реплики боссов будут отображаться в текстовом чате.
        }
        
        LegacyNebSky: {
            Label: Старое небо Небулеус
            Tooltip: Возвращает старое вращающееся изображение неба для финальной формы Небулеус.
        }
    }
    
    RedeConfigServer: {
        DisplayName: Глобальная конфигурация

        DialogueWaitTime: {
            Label: Дополнительное время на чтение диалога
            Tooltip:
                '''
                Увеличивает время отображения текста диалога перед переходом к следующему.
                Увеличьте значение, если вы читаете медленно.
                Значение указывается в секундах.
                '''
        }

        DialogueSpeed: {
            Label: Скорость текста в диалогах
            Tooltip:
                '''
                Рекомендуется изменять только в случае, если скорость диалога слишком медленная или быстрая.
                Эта настройка определяет, насколько быстрее будут отображаться буквы (в секундах): большее значение = быстрее.
                Чем выше скорость, тем сложнее читать текст до конца, поэтому не забудьте также отрегулировать настройку 'Дополнительное время на чтение диалога'.
                '''
        }

        ElementDisable: {
            Label: Отключить элементальные школы
            Tooltip: Отключает элементальное сопротивление и урон.
        }

        VanillaGuardPointsDisable: {
            Label: Отключить барьер на ванильных врагах
            Tooltip: Отключает наличие барьера на ванильных врагах.
        }

        ShakeIntensity: {
            Label: Интенсивность дрожания экрана
            Tooltip:
                '''
                Уменьшите значение, чтобы снизить интенсивность эффекта дрожания экрана
                Значение 0 полностью отключает эффект.
                '''
        }

        NoPZBuildUp: {
            Label: Мгновенный бой с Нулевым пациентом
            Tooltip:
                '''
                Активирует немедленное начало сражения с боссом, идеально для прохождений без получения урона.
                Это может привести к рассинхронизации пульсирующего эффекта босса с музыкой.
                '''
        }
        
        FindNewStructureCoords: {
            Label: Сброс координат структур
            Tooltip:
                '''
                При входе в мир игра заново определяет координаты важных блоков структур.
                Полезно, если вы хотите изменить расположение структур - например, разрушить портал на поверхности и перенести его рамку в другое место.
                Если эта настройка отключена, координаты фиксируются и не изменяются.
                '''
        }

        FunniHeader: Весёлости (Не забудьте отключить их перед созданием обычного мира!)

        FunniSpiders: {
            Label: Ой! Паукопалипсис!
            Tooltip: При создании нового мира все каменные блоки превратятся в заражённый камень.
        }

        FunniWasteland: {
            Label: Ну и кто тут запустил ядерную бомбу?
            Tooltip: При создании нового мира будет естественным образом генерироваться пустошь (Может нарушить прогрессию).
        }

        FunniAllWasteland: {
            Label: Лиден дома:
            Tooltip: При создании нового мира каждый блок превратится в свою облучённую версию (Может нарушить прогрессию).
        }

        FunniJanitor: {
            Label: Последний подвиг уборщика
            Tooltip: При создании нового мира появится чистая лаборатория с безопасными блоками лаборатории и без слякоти (Может нарушить прогрессию).
        }

        FunniAncient: {
            Label: Древний мир
            Tooltip: При создании нового мира блоки превратятся в их древние или гатурамские версии, а гатурамских гробниц станет больше.
        }
    }
    
    ElementDamageTooltipEnum: {
        Tooltip: ""
        Disabled.Label: Отключено
        ShowAdded.Label: Бонус
        ShowTotalled.Label: Итоговое значение
    }
}

BossChecklistIntegration: {
    AbandonedLaboratory: {
        EntryName: Заброшенная лаборатория
        SpawnInfo: Найдите заброшенную лабораторию глубоко под поверхностью и победите первых двух мини-боссов внутри. Не забудьте сперва победить всех механических боссов.
    }

    AbandonedLaboratory2: {
        EntryName: Возвращение в заброшенную лабораторию
        SpawnInfo: Используйте [i:Redemption/Keycard] для открытия дополнительных секторов лаборатории. Ключ-карта выдаётся дроном после победы над Лунным лордом. Остерегайтесь того, что ждёт впереди.
    }

    FowlMorning: {
        EntryName: Кудашное утро
        SpawnInfo: Используйте [i:Redemption/FowlWarHorn] до полудня.
    }
}
