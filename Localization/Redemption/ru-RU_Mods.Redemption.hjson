    ForgottenGreatsword: {
        DisplayName: Забвенный двуручник Офоса
        Tooltip:
            '''
            Вращает клинок вокруг игрока и воспламеняет его
            Создаёт огненный вихрь, охватывающий игрока, наносящий урон {0}
            Отпустите <left>, чтобы рассеять вихрь, отбрасывая ближайших врагов
            '''
        Lore:
            '''
            'Серебряный меч со стальной рукоятью, выкованный Офосом, легендарным кузнецом из земель, ныне известных как Хай Ангулон
            Считается, что он мастерски владел магией огнешторма и украшал свои творения самоцветом, наделяющим оружие магической силой
            Это оружие выполнено в традиционном стиле территории Нортхолма'
            '''
    }

    GravityHammer: {
        DisplayName: Гравитационный молот
