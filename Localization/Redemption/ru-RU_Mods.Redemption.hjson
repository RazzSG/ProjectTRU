    GigapeiliContactor: {
        DisplayName: Гигазеркальный соприкасатель
        Tooltip:
            '''
            Стреляет разбросом электрических зарядов на небольшое расстояние
            Нажмите <right>, чтобы разместить неподвижного дрона или отозвать его
            Заряды, попадающие в дрона, отражаются с большей дальностью и меньшим разбросом в ближайшего врага
            '''
    }

    GlobalDischarge: {
        DisplayName: Планетарный разряд
        Tooltip:
            '''
            Создаёт нестабильную сферу молний, удерживаемую энергетическим потоком жезла
            Нажмите <left>, чтобы создать сферу и немедленно прервать поток, вызвав нестабильный разряд
            Удерживайте <left>, чтобы создать сферу и поддерживать её стабильность, позволяя ей раскачиваться по инерции
            Сфера наносит больше урона, чем быстрее она движется
            '''
    }

    LightningRod: {
        DisplayName: Автономный громоотвод
        Tooltip:
            '''
            Удерживайте <left>, чтобы зарядить электричество, отпустите, чтобы выпустить разряд молнии в позицию курсора
            Молния поражает больше врагов и наносит больше урона при более длительном заряде
            Перегрузка снижает урон, но увеличивает радиус поражения
            '''
    }

    Nanoswarmer: {
        DisplayName: Нанороевик
        Tooltip:
            '''
            Выпускает шквал нанитов, которые проникают во врагов и уничтожают их изнутри
            Игнорирует значительную часть защиты врага
            'Наномашины, сынок'
            '''
    }

    Rockslide: {
        DisplayName: Камнепад
        Tooltip:
            '''
            Создаёт множество камней, парящих над игроком
            Отпустите <left>, чтобы запустить их в позицию курсора
            '''
        Lore:
            '''
            'Древняя реликвия, некогда принадлежавшая королю Тенебрису
            Считалось, что тексты, содержащиеся в этом фолианте, содержат знания, необходимые для овладения магией псионики
            Король Тенебрис правит Эреллоном из столицы Аргат, провинции, защищённой землями, полными жизни и бесплодной смерти
            Говорят, что его познания о древних эпохах поистине безграничны'
            '''
    }

    SunshardGreatstaff: {
        DisplayName: Великий посох солнечного блеска
        Tooltip:
            '''
            Запускает всплеск искупительных искр
            После 3 последовательных выстрела запускает священный луч света
            '''
        Lore:
            '''
            'Золотой посох, охраняемый монастырём клириков в Таморе
            Наполненный святой магией, он славился прежде всего своими целительными способностями
            Несметное число людей стремились обрести его силу, надеясь исцелить себя или своих любимых'
            '''
    }

    Synthesizer: {
        DisplayName: Синтезатор
        Tooltip: Выпускает волну нот вдоль земли
    }

    XenomiteScepter: {
        DisplayName: Спиральный скипетр
        Tooltip:
            '''
            Запускает заразные спиральные снаряды
            Каждый последующий выстрел увеличивает скорость снарядов
            '''
    }

    BlindJustice: {
        DisplayName: Слепое правосудие, Кошмар демонов
        Tooltip:
            '''
            Удерживайте <left>, чтобы зарядить сияющий круговой удар
            Нажмите <right> в момент, когда вы вот-вот получите физический урон (контактный или от оружия), чтобы выполнить парирование, дающее кадры неуязвимости
            Парирование контактного урона не сработает, если враг неподвижен или движется вдвое медленнее вас
            После успешного парирования нажмите <left> для мгновенного контрудара сияющим круговым ударом
            Наносит двойной урон демоническим врагам
            '''
        Lore:
            '''
            'Изысканное и священное, это оружие принадлежало Эймену - прославленному члену ордена высших тамплиеров
            Он наделил клинок частицей своей бессмертной души, чтобы тот оставался святым и после его смерти
            Эймен относился к этому оружию как к части себя, сражая им бесчисленных демонов высшего ранга'
            '''
    }

    BloodstainedPike: {
        DisplayName: Окровавленная пика
        Tooltip:
            '''
            Направьте пику вперёд и устремитесь на слабых врагов, нанизывая их на острие
            Если цель остаётся на пике 10 секунд, или если нанизано сразу 5 целей:
            Пика забирает их здоровье и становится зачарованной на 10 секунд
            '''
    }

    Chernobyl: {
        DisplayName: Убойный бросок
        Tooltip:
