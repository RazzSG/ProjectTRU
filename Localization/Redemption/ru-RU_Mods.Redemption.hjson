    }

    HammerOfProving: {
        DisplayName: Молот доказательств
        Tooltip:
            '''
            Удерживайте <left> в воздухе, чтобы совершить удар о землю
            Удар вызывает появление {0} молотов, количество которых зависит от того, сколько раз вы отскочили от врага
            Святые молоты наносят дополнительный урон {1}
            Увеличивает скорость падения, если продолжать удерживать <left>
            Оглушает врагов, если скорость падения достигает определённого уровня
