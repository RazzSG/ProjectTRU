GenericTooltips: {
    Bonuses: {
        AxeBonus: Критические удары наносят тройной урон, а также увеличен шанс обезглавить гуманоидных врагов
        SlashBonus: Небольшой шанс обезглавить большинство гуманоидных врагов, мгновенно убивая их
        HammerBonus: Наносит четырёхкратный урон по барьеру врага и игнорирует его сопротивление к отбрасыванию
        ChaliceLine: "[i:Redemption/ChaliceIcon]Чаше есть что сказать об этом предмете"
        ExplodeBonus: Наносит двойной урон по барьеру врага и игнорирует его защиту
        ArcaneBonus: Может наносить урон врагам из мира духов
        BloodBonus: Наносит больше урона органическим врагам и меньше - роботизированным
        CelestialBonus: При ударе по врагам вокруг них могут появляться звёзды, восстанавливающие здоровье и ману после их убийства
        EarthBonus: Наносит дополнительный урон и может оглушить врагов, находящихся на земле
        FireBonus: Шанс наложить сильный дебафф «{$BuffName.OnFire}» на воспламеняющихся врагов
        HolyBonus: Наносит больше урона нежити и демонам
        IceBonus: анс заморозить слизней и замедлить инфицированных врагов
        NatureBonus: При ударе по врагам, находящимся под действием не огненного дебаффа, есть шанс выпадения дара природы, увеличивающего защиту
        PoisonBonus: Наносит больше урона отравленным целям
        PsychicBonus: Игнорирует барьер врага
        ShadowBonus: Из убитых врагов может выпасть предмет, увеличивающий урон школы тени
        ThunderBonus: Электризует и наносит дополнительный урон, если цель находится в воде
        WaterBonus: Наносит больше урона демонам и может электризовать роботизированные цели
        WindBonus: Наносит дополнительное отбрасывание воздушным целям
    }

    RodOfHarmonyLine: Накладывает дебафф «{$BuffName.ChaosState}» во время битвы с боссами из Redemption

    ArmorSetBonus: {
        VanillaArmor: {
            Resistance: Увеличивает сопротивление {1} на {0}%
            Damage: Увеличивает урон {1} на {0}%
            SolarCelestial:
                '''

                Звёзды при активации бонуса {0} пылают ярче и спустя короткое время взрываются небольшими вспышками
                Вспышки наносят урон {1}, который зависит от показателя защиты игрока
                '''
        }

        LivingWood:
            '''
            Даёт невосприимчивость к дебаффу «{$BuffName.Poisoned}» и увеличивает максимальное количество миньонов на 1
            Увеличивает урон и сопротивление {0} на 15%
            '''
        CommonGuardHelm1: Увеличивает скорость атаки ближнего боя на 12%
        CommonGuardHelm2: Увеличивает сопротивление урону на 6%

        PureIron: {
            Bonus:
                '''
                Увеличивает сопротивление {0} на 20%
                Увеличивает урон {1} на 10%
                Обычное оружие с 33% шансом накладывает дебафф «{$Buffs.PureChillDebuff.DisplayName}»
                Сверхчистое железное оружие с 100% шансом накладывает дебафф «{$Buffs.PureChillDebuff.DisplayName}»
                '''
        }

        DragonLead: {
            Bonus:
                '''
                Увеличивает сопротивление {0} на 20%
                Увеличивает урон {1} на 10%
                Обычное оружие с 33% шансом накладывает дебафф «{$Buffs.DragonblazeDebuff.DisplayName}»
                Сверхчистое железное оружие с 100% шансом накладывает дебафф «{$Buffs.DragonblazeDebuff.DisplayName}»
                '''
        }

        Hardlight: {
            Keybind: Назначьте клавишу для [Особая способность] в управлении
            Press: "Нажмите "
            Support:
                '''
                , чтобы получить подкрепление с корабля Короля-охотника

                '''
            Cowl: Призывает дрона, который непрерывно восполняет ману в течение 10 секунд
            Helm: Призывает 2 мини-космических корабля, которые вращаются вокруг вас и стреляют лазерами всякий раз, когда вы атакуете оружием ближнего боя
            Hood: Призывает 2 ракетных дрона и магнитного дрона
            Visor: Выпускает ракетный залп с корабля Короля-охотника, нацеливаясь на врага, ближайшего к позиции курсора
        }

        Xenomite: {
            Press: "\nНажмите "
            Keybind:
                '''
                Увеличивает урон на 6%
                Увеличивает регенерацию энергии, пока Энергоячейка находится в инвентаре
                Назначьте клавишу для [Особая способность] в управлении
                '''
            Bonus1:
                '''
                Увеличивает урон на 6%
                Увеличивает регенерацию энергии, пока Энергоячейка находится в инвентаре
                '''
            Bonus2: ", чтобы высвободить токсичный газ вокруг игрока, накладывающий дебафф «{$Buffs.BileDebuff.DisplayName}»"
        }

        Xenium.Bonus:
            '''
            Увеличивает регенерацию энергии, пока Энергоячейка находится в инвентаре
            Дважды нажмите ВНИЗ для активации [c/BCF160:Режима пушки]:
            В режиме пушки всё оружие деактивируется, а атака запускает управляемые гранаты
            Граната делает всех врагов в радиусе взрыва уязвимыми к урону
            '''
    }
}

SpecialTooltips: {
    Viewer: Удерживайте 'Shift', чтобы увидеть историю
    Viewer2: Удерживайте 'Shift', чтобы увидеть содержимое
    SunkenCaptainViewer: На обороте выгравирована надпись, удерживайте 'Shift', чтобы прочитать
    Unbreakable: "[c/ff0000:Неразрушимый]"
    Unbreakable5000: "[c/ff0000:Неразрушимый (нужно 5000% мощности кирки)]"

    CommonGuard: {
        CommonGuardGreaves:
            '''
            'Поножи латного доспеха, принадлежащие гвардейцу Ангулона, найдены среди останков скелетов
            В тот незабываемый день, когда через неохраняемый портал прорвался демон, погибли люди, и дома были охвачены пламенем
            Этот урок, выжженный адским пламенем, дал рождение новому отряду, призванному защищать народ Ангулона'
            '''
        CommonGuardHelm1:
            '''
            'Шлем с забралом, принадлежащий гвардейцу Ангулона, найден среди останков скелетов
            Жители деревень мечтают о дне, когда их небольшие поселения получат защиту гвардейцев
            Однако этот день не наступит. Несмотря на скромное название, этот отряд не заботится о простом люде
            Гвардейцы несут службу лишь у значимых достопримечательностей и в крупных городах
            До простого люда им нет никакого дела'
            '''
        CommonGuardHelm2:
            '''
            'Горшковый шлем, принадлежащий гвардейцу Ангулона, найден среди останков скелетов
            Несмотря на превосходство над рядовыми рыцарями, обычные гвардейцы не участвуют в военных конфликтах'
            '''
        CommonGuardPlateMail:
            '''
            'Латные доспехи, принадлежащие гвардейцу Ангулона, найдены среди останков скелетов
            Некогда блестящая сталь со временем потускнела и покрылась слоем пыли
            Однако красная ткань сохранила свой цвет. Ангулонские ткани и красители славятся своим качеством'
            '''
    }

    PureIron: {
        AntiquePureIronHelmet:
            '''
            'Устаревшая модель шлема воинов Железного царства
            Обнаружена в катакомбах Гатурама павшим Хэппинсом
            Отличительной чертой этой модели является меховая отделка, призванная защищать шею и плечи воина от сурового холода'
            '''
        PureIronHelmet:
            '''
            'Этот шлем с забралом носят воины Железного царства
            Металл постоянно источает ледяной туман и холоден на ощупь, однако воины Железного царства прошли обучение, чтобы выдерживать столь суровые температуры
            Воины Железного царства - главная военная сила Гатурама, отряды которой раскиданы по всему царству'
            '''
        PureIronChestplate:
            '''
            'Этот нагрудник из металла и кожи носят воины Железного царства
            Металл постоянно источает ледяной туман и холоден на ощупь, однако воины Железного царства прошли обучение, чтобы выдерживать столь суровые температуры
            Воины Железного царства - главная военная сила Гатурама, отряды которой раскиданы по всему царству'
            '''
        PureIronGreaves:
            '''
            'Эти поножи из металла и кожи носят воины Железного царства
            Металл постоянно источает ледяной туман и холоден на ощупь, однако воины Железного царства прошли обучение, чтобы выдерживать столь суровые температуры
            Воины Железного царства - главная военная сила Гатурама, отряды которой раскиданы по всему царству'
            '''
    }

    DragonLead: {
