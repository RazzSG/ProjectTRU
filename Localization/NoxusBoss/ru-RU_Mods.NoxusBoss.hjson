    OminousStorybook: {
        DisplayName: Мрачные хроники
        ObtainmentHint: ""
        Tooltip:
            '''
            [c/C69C97:Пульс, затем тишина]
            [c/C69C97:Звёзды вздыхают. Семена рассекают камень]
    
            [c/C69C97:Пепел цепляется за ветер, шепча о лесах, которых ему не суждено узнать]
            [c/C69C97:Свет угасает в вечной тьме. В складках нового рассвета]
            [c/C69C97:Его края истрёпаны в перерождение]
    
            [c/C69C97:Миры возникают и исчезают, появляясь из великой пены и растворяясь в ней]
    
            [c/C69C97:Но время - не линия]
            [c/C69C97:А расцвет пламени]
             
            [c/C69C97:Лепестки загибаются внутрь]
            [c/C69C97:Пепел спиралью разлетается наружу]
            [c/C69C97:Нет начала. Нет конца]
            [c/C69C97:Лишь движение бытия]
    
            [c/C69C97:Ты слышишь это? Тихий гул под руинами]
    
            [c/CEA3A3:Память о движении]
            [c/EF908D:Вращение оси колеса]
            [c/FF6660:Скачке искры]
    
            [c/FF5171:Пробуждение мира]
            [c/FF274A:Из тени опавшего цветка]
            '''
    }
    
    TwentyTwome: {
        DisplayName: Два-Два-Том
        ObtainmentHint: "[c/F79BC6:Похоже, эта книга находится где-то среди растительности джунглей]"
        Tooltip:
            '''
            Странные бредни неизвестного автора, выдумывающего множество связей между шершнями и числом двадцать два
