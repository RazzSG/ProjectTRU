        Tooltip: ""
    }
    
    RageOfTheDeities: {
        DisplayName: Ярость божеств
        ObtainmentHint: "[c/F79BC6:Серный лотос может подсказать, откуда взялась эта книга]"
        Tooltip:
            '''
            Начальные строки трактата гласят:
    
