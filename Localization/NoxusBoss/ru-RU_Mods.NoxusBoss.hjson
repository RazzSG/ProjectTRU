    }
    
    AppleThesis: {
        DisplayName: Яблочный трактат
        ObtainmentHint: "[c/F79BC6:Эту книгу можно найти в кронах деревьев]"
        Tooltip:
            '''
            Диссертация о бесконечных способах применения яблок!
