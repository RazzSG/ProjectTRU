    AcidicPrayerbook: {
        DisplayName: Кислотный молитвенник
        ObtainmentHint: "[c/F79BC6:Похоже, эта книга как-то связана с едкими ливнями]"
        Tooltip:
            '''
            Потрёпанный фолиант, написанный в почтительном тоне
