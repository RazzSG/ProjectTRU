    WhisperingHood: {
        DisplayName: Шепчущий капюшон
        Tooltip:
            '''
            Искажает вашу лучезарную силу
            Снижает весь урон, кроме лучезарного, на 25%
            Увеличивает лучезарный урон на 25%
            Увеличивает лучезарный шанс критического удара на 12%
            Увеличивает максимальный запас маны на 40
            Исцеляющие заклинания восстанавливают дополнительно 1 единицу здоровья
            '''

        SetBonusQuotes: {
            TheGrandThunderBird: Зачем проявлять милосердие к слабым?..
            KingSlime: Пешки в космической игре...
            EyeofCthulhu: Один из множества сосудов...
            EaterofWorlds: Наше влияние простирается широко...
            BrainofCthulhu: Никому не постичь наших интриг...
            QueenJellyfish: Очередной провальный эксперимент...
            Viscount: Кровавые жертвы не тому источнику...
            Deerclops: Очередное существо, ведомое безумием...
            QueenBee: Исказить можно всё...
            Skeletron: Никому не понять наших целей...
            GraniteEnergyStorm: Вся энергия ждёт поглощения...
            BuriedChampion: Такой восторг от очищения этого...
            StarScouter: Их вмешательство не имеет значения...
            WallofFlesh: Да... Продолжай свой путь, 'Герой'...
            FallenBeholder: Жалкое зрелище...
            BoreanStrider: Наша сила в умении адаптироваться и преодолевать...
            QueenSlime: Самопровозглашённые лидеры... Все слуги одинаковы...
            SkeletronPrime: Продолжай демонстрировать свою ярость...
            TheDestroyer: Продолжай демонстрировать свою силу...
            TheTwins: Продолжай демонстрировать свою проницательность...
            Lich: Как недальновидно...
            Plantera: Мы тоже должны распространяться по всей вселенной...
            Golem: Ложный идол мёртвого бога...
            ForgottenOne: Необходимая жертва...
            MartianSaucer: Они до сих пор сопротивляются...
            EmpressofLight: Она сразила многих из нас... Изумительно...
            DukeFishron: Мы ожидали большего...
            Cultist: Поклоняться должны нам...
            MoonLord: Мы не единственные, забытые временем...
            DreamEater: Нам есть о чём задуматься...
        }

        SetBonusFallbackQuotes: {
            0: Не одно из нас... Интересно...
            1: Существо, находящееся вне цикла...
        }
        
        SetBonus:
            '''
            Периодически создаёт щупальце бездонной энергии, которое атакует ближайших врагов
            Вы можете иметь до шести щупалец, а их атаки похищают у поражённого врага {0} единицу здоровья и {1} единицу маны
