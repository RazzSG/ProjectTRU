        }

        ShowEmpowermentNotice: {
            Label: Отображение бонусов усиления
            Tooltip: Переключает отображение бонусов об активных усилениях вокруг игрока.
        }

        ShowOthersEmpowermentNotice: {
            Label: Отображение бонусов усиления у других
            Tooltip: Переключает отображение бонусов об активных усилениях вокруг других игроков.
        }

        ShowEmpowermentBar: {
            Label: Отображение панели усиления
            Tooltip: Переключает отображение панели, которая показывает активные усиления.
        }

        ShowInspirationWheel: {
            Label: Отображение колеса вдохновения
            Tooltip: Переключает отображение колеса вдохновения при использовании вдохновения игроком.
        }

        InspirationWheelScale: {
            Label: Масштаб колеса вдохновения
            Tooltip: Устанавливает множитель масштаба колеса вдохновения.
        }

        MoveInspirationWheelToTop: {
            Label: Колесо вдохновения в верхней части экрана
            Tooltip: Если эта настройка включена, колесо вдохновения будет отображаться в верхней части экрана, слева от шкалы здоровья.
        }

        MoveInstrumentTimerToMouse: {
            Label: Отображение таймера инструментов под курсором
            Tooltip: Если эта настройка включена, таймеры больших инструментов будут отображаться непосредственно под курсором.
        }

        HideInstrumentTimerMouse: {
            Label: Сокрытие вспомогательного таймера инструмента
            Tooltip: Если эта настройка включена, скрывается вспомогательный таймер больших инструментов (под курсором).
        }

        toggleBigInstrumentMetronome: {
