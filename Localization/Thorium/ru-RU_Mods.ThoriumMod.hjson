    SnarkyGun: {
        DisplayName: Дерзкое ружьё
        Tooltip:
            '''
            Превращает мушкетные пули в различные типы яиц
            Нажимайте <right> для переключения между типами яиц
            '''

        SnarkyGunStage: {
            Basic: Обычные
            Explosive: Взрывные
            Fire: Огненные
            Ice: Ледяные
            Homing: Самонаводящиеся
        }
    }

    Fig: {
        DisplayName: Инжир
        Tooltip: Немного увеличивает все характеристики
    }

    Tamarind: {
        DisplayName: Тамаринд
        Tooltip: Немного увеличивает все характеристики
    }

    AdamantiteKlaxon: {
        DisplayName: Адамантитовый клаксон
        Tooltip: Высвобождает отложенный звуковой взрыв после нанесения урона врагам
    }

    TitaniumCimbasso: {
        DisplayName: Титановый чимбассо
        Tooltip: ""
    }

    ValadiumTheremin: {
        DisplayName: Валадиумовый терменвокс
        Tooltip: Исполняет нарастающую мелодию, наносящую увеличенный урон целям над вами
    }

    LodestoneRadio: {
        DisplayName: Магнетитовое радио
        Tooltip: Окружает вас радиопомехами магнетита, которые разрывают и отталкивают врагов
    }

    Cello: {
        DisplayName: Виолончель
        Tooltip:
            '''
            'Произносится как Ви-о-лон-чель'
            Испускает длительную огненную звуковую волну
            '''
    }

    SorcerersDice: {
        DisplayName: Игральная кость чародея
        Tooltip:
            '''
            Испытайте удачу, бросив шестигранную магическую кость, потратив текущий запас маны
            Выпавшая грань определяет множество эффектов, связанных с маной - как положительных, так и отрицательных
            После использования кости требуется {0} {^0:минута;минуты;минут} для перезарядки
            '''
        Choice1: (1) «{$BuffName.ManaSickness}» на {0} секунд
        Choice2: (2) «{$BuffName.ManaSickness}» на {0} секунд
        Choice3: (3) Возврат потраченной маны
        Choice4: (4) Полное восстановление маны!
        Choice5:
            '''
            (5)
            Бесконечная мана на {0} секунд
            Увеличивает скорость произнесения заклинаний {1}%
            '''
        Choice6:
            '''
            (6)
            Бесконечная мана на {0} секунд
            Увеличивает скорость произнесения заклинаний {1}%
            Кратковременная неуязвимость
            '''
    }
}

NPCs: {
    AggroDummy.DisplayName: Манекен-приманка

    AncientArcher: {
        DisplayName: Древний лучник
        BestiaryFlavorText: Меткие воины древней цивилизации, владеющие мощными бронзовыми луками, позволяющие им поражать врагов на больших расстояниях.
    }

    AncientCharger: {
        DisplayName: Древний налётчик
        BestiaryFlavorText: Быстрые и ловкие воины древней цивилизации, продолжающие сражаться в надежде на возвращение своего чемпиона.
    }

    AncientPhalanx: {
        DisplayName: Древняя фаланга
        BestiaryFlavorText: олоссальные стражи древней цивилизации, которым ныне осталось защищать лишь самих себя.
    }

    AquamarineBunny: {
        DisplayName: Аквамариновый кролик
        BestiaryFlavorText: "{$CommonBestiaryFlavor.GemBunny}"
    }

    AquamarineSquirrel: {
        DisplayName: Аквамариновая белка
        BestiaryFlavorText: "{$CommonBestiaryFlavor.GemSquirrel}"
    }

    ArmyAnt: {
        DisplayName: Муравей-солдат
        BestiaryFlavorText: Гигантский муравей с неприятным укусом. Будьте благодарны, что вы не наткнулись на его родное гнездо!
    }

    AstroBeetle: {
        DisplayName: Космический жук
        BestiaryFlavorText: Громоздкая инопланетная форма жизни, предпочитающая прицепляться к пролетающим космическим кораблям и метеоритам.
    }

    BabySpiderWall: {
        DisplayName: Паучок
        BestiaryFlavorText: Даже будучи новорождёнными, они могут в большом количестве расчленить террарийца в мгновение ока.
    }

    BiteyBaby: {
        DisplayName: Кусачий малыш
        BestiaryFlavorText: Слуги Виконта. Их часто отправляют на поиски свежей крови, а изредка - пищи.
    }

    Viscount: {
        DisplayName: Виконт
        BestiaryFlavorText: Величественный как по размерам, так и по эго, Виконт является безоговорочным властелином пещер.
        BossChecklistIntegration.SpawnInfo: Используйте [i/s{0}:{1}] в подземной Кровавой камере. Используйте [i:{2}], чтобы отыскать Кровавую камеру.
    }

    BatOutaHell.DisplayName: Летучая мышь из ада

    Beholder: {
        DisplayName: Созерцатель
        BestiaryFlavorText: Низшее существо из другого измерения, которое стремится к знаниям и уничтожению всего, до чего сможет дотянуться.
    }

    FallenBeholder: {
        DisplayName: Падший Созерцатель
        BestiaryFlavorText: Это существо - лишь отголосок того, что скрывается за пределами пустоты. Длительное пребывание в мире Террарии ослабило его по сравнению с родным измерением.

        BossChecklistIntegration: {
            SpawnInfo: Используйте [i:ThoriumMod/VoidLens] в преисподней.
            EntryName: "{$NPCs.FallenBeholder.DisplayName}"
        }
    }

    BigBone: {
        DisplayName: Большой костяк
        BestiaryFlavorText: Этот крепкий скелет выводит понятие 'большой костяк' на совершенно новый уровень.
    }

    Biter: {
        DisplayName: Кусач
        BestiaryFlavorText: Процесс зомбификации может приводить к самым неожиданным результатам. Этот экземпляр выделяется особенно сильным кровотечением.
    }

    Blacksmith: {
        DisplayName: Кузнец
        BestiaryFlavorText: Кузнец - сварливый старик с непревзойдённым мастерством выплавки. Его мастерски созданное снаряжение заинтересует любого террарийца.

        TownNPCMood: {
            Content: Конечно, я в порядке, олух! Чего спрашиваешь?
            NoHome: Чего? Мне что, ещё и дом самому строить? За работу!
            FarFromHome: Хмф, если бы я всё время торчал в той коробушке, которую ты называешь домом, я бы ничего не успел сделать.
            LoveSpace: Люблю наслаждаться покоем и тишиной, когда не занят работой.
            DislikeCrowded: Слишком много народу на мой вкус. Немного личного пространства не помешало бы.
            HateCrowded: И как я должен ковать, если все норовят врезаться в меня? Выгнал бы ты этих бездельников отсюда!
            LikeBiome: Разве не прекрасно, когда материалы для ковки находятся буквально под носом?
            HateBiome: Понятия не имею, как я оказался в этом опасном месте, но тебе лучше помочь мне свалить отсюда!
            LoveNPC: Иногда {NPCName} и я затеваем споры, но как собутыльник он просто отличный.
            LikeNPC: Тихий, спокойный, знает, когда действовать. Мне нравится {NPCName}.
            DislikeNPC: "{NPCName} иногда меня дико раздражает. Он мог бы стать моим главным клиентом! Но нет, всё, что ему нужно, - это наточенный топор..."
            LikeNPC_Princess: Соплячка соплячкой, но {NPCName} нашла слабое место в моём сердце.
            Princess_LovesNPC: "{NPCName} помогла мне починить тиару. Я так благодарен!"
        }

        Census.SpawnCondition: Одолейте {$NPCName.EyeofCthulhu}.
    }

    BlackWidowWall: {
        DisplayName: Чёрная вдова
        BestiaryFlavorText: Яд этой скрытной паучихи настолько силён, что он разъедает сталь. Что же произойдёт с террарийцем?..
    }

    Blister: {
        DisplayName: Волдырь
        BestiaryFlavorText: Вздутый пузырь, заполненный до краёв едким ихором. Даже самое лёгкое прикосновение может привести к его взрыву!
    }

    BlisterPod: {
        DisplayName: Волдырный кокон
        BestiaryFlavorText: Гротескное образование, порождённое внутренностями багрянца. Вынашивает и производит опасных отпрысков.
    }

    BlizzardBat: {
        DisplayName: Вьюжная летучая мышь
        BestiaryFlavorText: Кровожадная летучая мышь, пропитанная холодом, жаждет снежков с привкусом крови.
    }

    BoreanHopper: {
        DisplayName: Борейский прыгун
        BestiaryFlavorText: Новорождённый шагатель, столь же голодный и замёрзший, как и его мать.
    }

    BoreanMyte: {
        DisplayName: Борейский клещ
        BestiaryFlavorText: Мутировавший детёныш шагательницы, несущий ледяную гибель повсюду, куда бы ни пошёл.
    }

    BoreanStrider: {
        DisplayName: Борейский шагатель
        BestiaryFlavorText: Вид арахнидов, приспособленный к выживанию в суровых условиях террарийской вьюги. Такая целеустремлённость делает их опасными для всех.

        BossChecklistIntegration: {
            SpawnInfo: Появляется случайным образом во время метели или призывается с помощью [i:ThoriumMod/StriderTear].
            EntryName: "{$NPCs.BoreanStrider.DisplayName}"
        }
    }

    FrostBurnt: {
        DisplayName: Сгоревший морозом
        BestiaryFlavorText: Замёрзшая оболочка, лишённая плоти из-за суровых вьюжных ветров.
    }

    FrostBurntFlayer: {
        DisplayName: "{$NPCs.FrostBurnt.DisplayName}"
        BestiaryFlavorText: Деградирующая замёрзшая оболочка, умудряющаяся орудовать огромным ледяным шипом. Похоже, её язык прилип к его концу.
    }

    SnowElemental: {
        DisplayName: Снежный элементаль
        BestiaryFlavorText: Ледяной элементаль, до краёв наполненный снегом. Любит взрываться в красивом снежном вихре... смерти.
    }

    SnowyOwl: {
        DisplayName: Снежная сова
        BestiaryFlavorText: Суровая порода сов, охотящихся преимущественно во время приближающейся метели, когда видимость полностью исчезает.
    }

    Abomination: {
        DisplayName: Мерзость
        BestiaryFlavorText: Сшитые останки различных зомби. Сами швы видали и лучшие времена...
    }

    BloodDrop: {
        DisplayName: Капля крови
        BestiaryFlavorText: Ожившая кровь проявляет поразительное сходство со слизнями из Террарии.
    }

    BloodMage: {
        DisplayName: Маг крови
        BestiaryFlavorText: Редкий мутант кровавого зомби, сохранивший способность управлять тёмной магией крови.
    }

    BloodyWarg: {
        DisplayName: Кровавый варг
        BestiaryFlavorText: Неистовый зверь, обезумевший под воздействием ауры таинственной кровавой луны.
    }

    BurstingMaggot.DisplayName: Взрывающаяся личинка

    EngorgedEye: {
        DisplayName: Вздувшийся глаз
        BestiaryFlavorText: Этот демонический глаз напитался энергией кровавой луны, что придало ему уникальный облик.
    }

    FamishedMaggot: {
        DisplayName: Изголодавшаяся личинка
        BestiaryFlavorText: Злобный червь, известный своей склонностью к массовым нашествиям.
    }

    GraveLimb: {
        DisplayName: Могильная конечность
        BestiaryFlavorText: Жуткий некротический отросток, который обожает отрывать лица. Это будет массаж лица, который вы никогда не забудете!
    }

    PatchWerk: {
        DisplayName: Лоскутик
        BestiaryFlavorText: Ужасное существо, образованное из кишащих личинками останков террарийцев. Оно взывает к любому, кто может услышать, умоляя о смерти.
        BossChecklistIntegration.SpawnInfo: Появляется случайным образом в кровавую луну. Может быть повторно призван с помощью [i:ThoriumMod/FreshBrain], которые продаёт Растерянный зомби. Для начала кровавой луны используйте [i:BloodMoonStarter].
    }

    SeveredLegs: {
        DisplayName: Отрубленные ноги
        BestiaryFlavorText: Эти ноги созданы для ходьбы, и только это они и могут делать... Впрочем, этого вполне достаточно.
    }

    SmotheringShade: {
        DisplayName: Удушающая тень
        BestiaryFlavorText: Необъяснимые существа, порождённые зловещей аурой кровавой луны. Древние свитки упоминают их долгую и мрачную историю.
    }

    CorpseBloom: {
        DisplayName: Трупоцвет
        BestiaryFlavorText: Неясно, получил ли этот мутировавший цветок своё название из-за зловонного запаха или из-за того, что оставляет после себя тела террарийцев.
        BossChecklistIntegration.SpawnInfo: Появляется случайным образом в подземных джунглях после победы над Пожирателем миров / Мозгом Ктулху. Для повторного призыва используйте [i:ThoriumMod/RottingSpore], которую продаёт Растерянный зомби.
    }

    CorpsePetal.DisplayName: Трупный лепесток

    CorpseWeed: {
        DisplayName: Трупный сорняк
        BestiaryFlavorText: Живые корни Трупоцвета столь же опасны, как и само растение-хозяин. А возможно, даже опаснее!
    }

    BloomMahoganyEnt: {
        DisplayName: Энт красного дерева
        BestiaryFlavorText: Сознательная масса красного дерева, защищающая флору джунглей смертоносными, но изящными способами.
    }

    BoneFlayer: {
        DisplayName: Костяной свежеватель
        BestiaryFlavorText: Воскресшие останки архидемона, чьи огненные способности уничтожают большинство врагов в преисподней.
    }

    BossDummy.DisplayName: Босс-манекен
    BrownRecluseBabyWall.DisplayName: Отшельник-малыш

    BrownRecluseWall: {
        DisplayName: Коричневый отшельник
        BestiaryFlavorText: Редкий вид пауков, представляющий серьёзную угрозу благодаря рою защитных детёнышей и кислотной слюне. Особенно опасен для людей с арахнофобией.
    }

    BizarreRockFormation: {
        DisplayName: Странная каменная фигура
        BestiaryFlavorText: Каменная фигура в форме террарийца. Вам никак не избавиться от ощущения, что её каменные глаза следят за вами...
    }

    MagicalBurst.DisplayName: Магический всплеск

    BuriedChampion: {
        DisplayName: Погребённый чемпион
        BestiaryFlavorText: Герой, некогда прославленный на весь мир, ныне забытый временем. Он стремится встретиться с террарийцем, который разрушил проклятие Темницы.
        BossChecklistIntegration.SpawnInfo: Используйте [i:ThoriumMod/AncientBlade] глубоко под землёй в мраморных пещерах или найдите и одолейте странную каменную фигуру.
    }

    FallenChampion2: {
        DisplayName: Павший воитель
        BestiaryFlavorText: Смертоносное эхо мастерства владения оружием, некогда принадлежавшего Погребённому чемпиону. Невосприимчив к обычным атакам.
    }

    ChilledSpitter: {
        DisplayName: Замёрзший плевун
        BestiaryFlavorText: Один из множества осквернённых монстров, обитающих в ледяных пустошах. Использовать их слюну для охлаждения напитков крайне не рекомендуется.
    }

    Clot: {
        DisplayName: Сгусток
        BestiaryFlavorText: Как мы уже говорили, этот враг не из тех, кто сдаётся без боя.
    }

    Cobbler: {
        DisplayName: Сапожник
        BestiaryFlavorText: Сапожник, некогда бывший героем, теперь занимается изготовлением качественной обуви для следующего поколения.

        TownNPCMood: {
            Content: Стою на ногах нормально, не волнуйся!
            NoHome: Сложно работать, когда рядом нет рабочего места. Можешь помочь мне?
            FarFromHome: Как только вернусь домой, нужно будет заштопать обувь...
            LoveSpace: На работе легче сосредоточиться, когда есть личное пространство. Спасибо тебе!
            DislikeCrowded: Вокруг слишком много людей, не находишь?
            HateCrowded: Я не справляюсь с потоком заказов на обувь. Здесь чересчур многолюдно, как по мне.
            LikeBiome: Лес - идеальное место для прогулок. Никакого раздражающего песка. Никакого раздражающего снега. Никакого раздражающего гравия. Ну, ты понимаешь.
            DislikeBiome: Я слишком стар, чтобы вытряхивать песок и воду из ботинок....
            HateBiome: Будь я моложе, я бы справился с этим местом, но не сейчас, когда я стар!
            LoveNPC: Если кто-то понимает важность качественной обуви, то это {NPCName}. Их обувь действительно хороша.
            LikeNPC: "{NPCName} своими разговорами всегда успокаивает меня. Иногда даже мне нужна поддержка."
            DislikeNPC: "{NPCName} должен надеть обувь, пока не споткнулся и не упал."
            HateNPC: Я не фанат того, что {NPCName} пытается лечить ходящих на каблуках. Вы, мелюзга, так и напрашиваетесь на несчастный случай...
            LikeNPC_Princess: "{NPCName} невозможно не любить."
            Princess_LovesNPC: "{NPCName} невероятно умелая! Никогда моя обувь ещё так не блестела!"
        }

        Census.SpawnCondition: Наличие в инвентаре любого аксессуара-обуви ([i/s1:Aglet][i/s1:HermesBoots][i/s1:RocketBoots][i/s1:WaterWalkingBoots] и т.д.)
        Button2: Начистить обувь
    }

    CoinBagCopper: {
        DisplayName: Мешок с медными монетами
        BestiaryFlavorText: Эта зачарованная груда монет недавно обрела сознание, но всеми силами будет защищать свои богатства от посягательств.
    }

    CoinBagGold: {
        DisplayName: Мешок с золотыми монетами
        BestiaryFlavorText: Можно было бы ожидать, что золото станет обузой для этого жадного мешка с монетами, но оно лишь укрепляет его решимость убежать от террарийцев.
    }

    CoinBagSilver: {
        DisplayName: Мешок с серебряными монетами
        BestiaryFlavorText: После долгих скитаний по пещерам этот мешок с монетами сразу же исчезает, как только поблизости появляется жадный террариец.
    }

    Coldling: {
        DisplayName: Морозовичок
        BestiaryFlavorText: После длительного пребывания в снегу кожа этого тупорыла сильно обледенела. Однако его голод по-прежнему не утих.
    }

    ConfusedZombie: {
        DisplayName: Растерянный зомби
        BestiaryFlavorText: Растерянный зомби - это бывший химик, который превратился в зомби. Несмотря на то, что он сохранил большую часть рассудка, он всё ещё немного странноват.

        TownNPCMood: {
            Content: Жив и здоров, как видишь.
            NoHome: Ах, я, кажется, забыл, где мой дом. Можешь помочь мне найти его?
            FarFromHome: Пройди десять шагов, осмотрись. Если я не дома, то... как там дальше...
            LoveSpace: Люблю простор, могу не беспокоиться за других, пока готовлю репелленты.
            DislikeCrowded: Какие у меня грубые соседи, не любят меня только за то, кто я. Даже грустно...
            HateCrowded: Сколько людей... шведский стол... э-эм, ты ничего не слышал, правда?
            LikeBiome: Лес просто... делает меня счастливым, словно здесь мне самое место.
            DislikeBiome: Двигать конечностями и так сложно, а эта холодрыга делает это ещё труднее!
            HateBiome: Нравится ли мне здесь... Забочусь ли я о своей жизни... Нравится ли... Нет. Не-а. Совсем нет.
            LoveNPC: "{NPCName} всегда открывает мне двери, он такой заботливый!"
            LikeNPC: "{NPCName} и я чувствуем странную, но приятную связь. Не знаю почему, просто чувствуем."
            DislikeNPC: Под капюшоном это не видно, но, думаю, {NPCName} бросает на меня странные взгляды...
            LikeNPC_Princess: "{NPCName} выглядит как будто со вкусом клубники... Эм, просто мысли вслух!"
            Princess_LovesNPC: Хе-хе, {NPCName} делает такие забавные рожицы!
        }

        Census.SpawnCondition: Одолейте [c/4dffb8:Лоскутика].
        Button2: Репеллент ({^0:80 серебряных;1 золотая})
    }

    BlueHag: {
        DisplayName: Колдунья
        BestiaryFlavorText: Измождённая ведьма, обменявшая свою молодость на власть над волнами. Очевидно, сделка была неудачной, поскольку она пытаются вас убить.
    }

    CyanHag: {
        DisplayName: Колдунья
        BestiaryFlavorText: Измождённая ведьма, обменявшая свою молодость на власть над ветрами. Очевидно, сделка была неудачной, поскольку она пытаются вас убить.
    }

    GreenHag: {
        DisplayName: Колдунья
        BestiaryFlavorText: Измождённая ведьма, обменявшая свою молодость на власть над землёй. Очевидно, сделка была неудачной, поскольку она пытаются вас убить.
    }

    RedHag: {
        DisplayName: Колдунья
        BestiaryFlavorText: Измождённая ведьма, обменявшая свою молодость на власть над огнём. Очевидно, сделка была неудачной, поскольку она пытаются вас убить.
    }

    Cook: {
        DisplayName: Повар
        BestiaryFlavorText: Повар - мастер кулинарного искусства. Он постоянно разрабатывает новые рецепты, используя местные ингредиенты.

        TownNPCMood: {
            Content: Я в порядке, просто думаю над следующим рецептом.
            NoHome: У тебя случайно нет свободной кухни, а?
            FarFromHome: Думаю, пока я здесь, могу поискать несколько новых ингредиентов.
            LoveSpace: Иметь дегустаторов хорошо, но возможность сесть и расслабиться ещё лучше.
            DislikeCrowded: С сыром или без сыра?.. Угх, я уже путаюсь в заказах.
            HateCrowded: Количество людей, требующих еды, зашкаливает. Даже мне иногда нужен перерыв!
            LikeBiome: Вот это я понимаю место. Куча уникальных грибов и живности для новых рецептов!
            DislikeBiome: Под землёй, кроме мха, особо и не с чем работать...
            HateBiome: Вытащи меня отсюда, пока я не стал следующим блюдом для монстров!
            LoveNPC: Да, {NPCName} настоящий гурман. Просто лучший дегустатор!
            LikeNPC: Не особо люблю готовить грибные блюда, но {NPCName}, живущий рядом, открыл мне на них новый взгляд.
            DislikeNPC: Угх... {NPCName} такой привередливый. Он отказывается есть всё, кроме жареных рыбных палочек!
            HateNPC: Ничего личного, но, поскольку {NPCName} не может есть еду, его присутствие я нахожу довольно... раздражающим.
            LikeNPC_Princess: "{NPCName} приятно слушать во время готовки!"
            Princess_LovesNPC: "{NPCName} готовит самые замечательные угощения!"
        }

        Census.SpawnCondition: Одолейте Короля слизней.
        Button2: Снабдить ингредиентами
    }

    Coolmera: {
        DisplayName: Ледомера
        BestiaryFlavorText: Ненасытный голод заставляет его искать пищу даже в замерзающей тундре.
    }

    DarksteelKnight: {
        DisplayName: Рыцарь тёмной стали
        BestiaryFlavorText: Эти элитные стражи, когда-то верно служившие Темнице в его золотые годы, сохранили свою преданность, несмотря на то, что их плоть истлела.
    }

    AbyssalAngler.DisplayName: Золотая монета?

    AbyssalAngler2: {
        DisplayName: Глубинный удильщик
        BestiaryFlavorText: Яркие огни привлекают внимание рыб, но что привлекает внимание террарийцев? Правильно, монеты!
    }

    AbyssalSpawn: {
        DisplayName: Глубинное отродье
        BestiaryFlavorText: Ненасытные отпрыски Забытого оскверняют и загрязняют пресные воды мира.
    }

    ForgottenOne: {
        DisplayName: Забытый
        BestiaryFlavorText: Это существо, о котором давно забыли даже самые древние террарийцы. Оно и его сородичи были запечатаны много столетий назад во время кровопролитной войны.

        BossChecklistIntegration: {
            SpawnInfo: Соберите 3 [i:ThoriumMod/AbyssalShadow], которые выпадают из акватических галлюцинаций в Акватических глубинах.
            EntryName: "{$NPCs.ForgottenOne.DisplayName}"
        }
    }

    AquaticHallucination: {
        DisplayName: Акватическая галлюцинация
        BestiaryFlavorText: Потустороннее существо, способное внушить вам мысль о том, что вы сходите с ума...
    }

    Barracuda: {
        DisplayName: Барракуда
        BestiaryFlavorText: Эта шустрая рыба известна своей способностью преследовать добычу любыми способами. Даже стены не могут остановить её зверский аппетит.
    }

    Blobfish: {
        DisplayName: Рыба-капля
        BestiaryFlavorText: Этот маленький гадёныш - самый уродливый из всех существ в Акватических глубинах. А ведь он просто хочет обнимашек...
    }

    Blowfish: {
        DisplayName: Рыба фугу
        BestiaryFlavorText: Не стоит недооценивать этого хвастуна - он может вас удивить, если вам удастся его победить!
    }

    BlueLobster: {
        DisplayName: Синий лобстер
        BestiaryFlavorText: Исключительный вид глубоководного лобстера, который напугал до усрачки первого террарийца, увидевшего его.
    }

    CrownofThorns: {
        DisplayName: Венец терний
        BestiaryFlavorText: Обитающая на дне глубин, укол одной из этих морских звёзд может быть смертельным для многих.
    }

    DumboOctopus: {
        DisplayName: Осьминог Дамбо
        BestiaryFlavorText: Безобидный вид осьминога, который обитает в глубинах океана. Любит арахис.
    }

    FeedingFrenzy: {
        DisplayName: Бешеный обжора
        BestiaryFlavorText: Этот вид рыб - настоящие обжоры. Они могут быстро собрать вокруг себя целую стаю таких же прожорливых собратьев.
    }

    GiantIsopod: {
        DisplayName: Гигантский изопод
        BestiaryFlavorText: Эти миролюбивые существа тысячелетиями обитают в Акватических глубинах. Обитателям поверхности есть чему поучиться у них.
    }

    GigaClam: {
        DisplayName: Огромный моллюск
        BestiaryFlavorText: Среди террарианцев долгое время шли споры о том, как классифицировать размер этого моллюска: как 'огромный' или как 'массивный'. В итоге было решено, что он 'огромный'.
    }

    Globee: {
        DisplayName: Глоби
        BestiaryFlavorText: Это безобидное существо выделяет биолюминесцентную субстанцию, которая может освещать пространство вокруг него, даже глубоко под водой.
    }

    GoldDumboOctopus: {
        DisplayName: Золотой осьминог Дамбо
        BestiaryFlavorText: "{$CommonBestiaryFlavor.GoldCritter}"
    }

    GoldLobster: {
        DisplayName: Золотой лобстер
        BestiaryFlavorText: "{$CommonBestiaryFlavor.GoldCritter}"
    }

    Hammerhead: {
        DisplayName: Молотоголовый
        BestiaryFlavorText: Этот бедняга никак не мог понять, как выделиться среди своих друзей-акул... пока не решил использовать свою голову.
    }

    Kraken: {
        DisplayName: Кракен
        BestiaryFlavorText: Могучее существо, скрывающееся под поверхностью океана, обладающее восемью конечностями и восемью обидами на мир поверхности.
    }

    Lobster: {
        DisplayName: Лобстер
        BestiaryFlavorText: Глубоководный ракообразный с привычкой к щипанию.
    }

    ManofWar: {
        DisplayName: Медузник
        BestiaryFlavorText: Обладая беспрецедентным жалом и склонностью к непредсказуемой неуязвимости, эта медуза является изрядно сильным врагом.
    }

    MorayHead: {
        DisplayName: Мурена
        BestiaryFlavorText: Разновидность угря, обитающего в Акватических глубинах. Она предпочитает прятаться в норах и трещинах, которые роет сама.
    }

    Octopus: {
        DisplayName: Осьминог
        BestiaryFlavorText: Этот луковицеобразный морской обитатель обладает длинными щупальцами, которые он использует, чтобы захватывать и сокрушать добычу, даже через стены.
    }

    PurpleDumboOctopus: {
        DisplayName: Фиолетовый осьминог Дамбо
        BestiaryFlavorText: В глубинах океана обитает редкая разновидность осьминога Дамбо, который всё ещё любит арахис.
    }

    PutridSerpent: {
        DisplayName: Гнилостный змей
        BestiaryFlavorText: Гнилостный змей - это отвратительное пресмыкающееся, обитающее в скальных породах Акватических глубин. Он выделяет едкий сок и источает зловонный запах.
    }

    Sharptooth: {
        DisplayName: Острозуб
        BestiaryFlavorText: Название этой рыбы говорит само за себя. Один её укус способен доказать это любому террарийцу.
    }

    SubmergedMimic: {
        DisplayName: Подводный мимик
        BestiaryFlavorText: Потерянные в глубинах мимики обретают зловещие свойства, способные разрушать всё на своём пути. Говорят, они могут появляться из самых обычных сундуков.
    }

    VampireSquid: {
        DisplayName: Кальмар-кровопийца
        BestiaryFlavorText: Эти кальмары обладают укусом, высасывающим кровь и дарующим жертве исцеление. Они явно не настроены на безобидные игры.
    }

    VoltEelHead: {
        DisplayName: Электрический угорь
        BestiaryFlavorText: Эти угри обладают уникальным органом, позволяющим использовать электричество для разных целей: от охоты и обездвиживания добычи до розыгрышей друзей.
    }

    Whale: {
        DisplayName: Кит
        BestiaryFlavorText: Одно из самых величественных созданий, известных этому миру. Только истинное чудовище могло бы осмелиться причинить ему вред.
    }

    DesertAcolyte: {
        DisplayName: Пустынный послушник
        BestiaryFlavorText: Пустынный послушник, хотя и несколько пуглив, готов продать любое снаряжение тем, кто интересуется метанием предметов в монстров.

        TownNPCMood: {
            Content: Не чую опасности - значит, всё хорошо.
            NoHome: Надеюсь, ты поможешь мне найти спокойное пристанище. Чем раньше я обрету защищённый дом, тем лучше...
            FarFromHome: Хм, и как я только здесь оказался...
            LoveSpace: Меньше людей - жизнь бурней, вот что скажу.
            DislikeCrowded: Сила в количестве, конечно, но от такого столпотворения мне становится неуютно.
            HateCrowded: Как же здесь людно! Меня словно окружили.
            LikeBiome: Ах, родина... В этих пустошах любая угроза была видна за милю.
            DislikeBiome: Ч-что это был за шум?! Как далеко моя родная пустыня... Здесь я окружён ужасными жуками и ещё более ужасной грязью!
            HateBiome: Н-немыслимо... Нет... Прошу, вытащи меня отсюда!
            LikeNPC: Ах, когда {NPCName} рядом, я ощущаю себя в полной безопасности!
            DislikeNPC: "{NPCName} так и напрашивается на неприятности..."
            HateNPC: Понимаю, это не его вина, но когда {NPCName} рядом, у меня ноги подкашиваются. У меня достаточно плохих воспоминаний о представителях его вида.
            LikeNPC_Princess: Какое странное чувство... Словно {NPCName} заслуживает защиты даже больше, чем я!
            Princess_LovesNPC: "{NPCName} - лучший в городе мастер пряток, с ним весело играть!"
        }

        Census.SpawnCondition: Одолейте [c/4dffb8:Великую громовую птицу].
        Button2: Песчаная буря ({^0:80 серебряных;1 золотая})
    }

    DissonanceSeer: {
        DisplayName: Провидец диссонанса
        BestiaryFlavorText: Охваченные благословением обезумевшие маги выслеживают и атакуют любого, кто вторгается в священное освящение.
    }

    Diverman: {
        DisplayName: Водолаз
        BestiaryFlavorText: Этот чудак водолаз ищет загадочные Акватические глубины. Он готов продать вам затонувшие сокровища.

        TownNPCMood: {
            Content: Всё нормально, а у тебя как?
            NoHome: Когда я в последний раз был вне дома, произошёл неприятный случай с одним розовым мутантом...
            FarFromHome: Не обращай на меня внимания. С этим комплектом для дайвинга я доберусь домой без проблем.
            LoveSpace: Не помешало бы встретить несколько старых друзей, согласен?
            DislikeCrowded: Большинство из тех, кто здесь, мне нравится, но разве их не слишком много?
            HateCrowded: Слишком шумно, чтобы думать. Мне нужен свой уголок!
            LikeBiome: Песок пляжа, воды океана... о чём ещё может мечтать дайвер?
            DislikeBiome: Пустыня?! Худшее место! Муравьиные кладки, перекати-кактусы, огромные черви. А уж что начинается после заражения...
            HateBiome: Зловещее местечко, не находишь?..
            LoveNPC: Долгое пребывание в Глубинах может испортить настроение кому угодно. Но {NPCName} всегда поднимает мне его...
            LikeNPC: Не поверишь, но {NPCName} и я давно знакомы. Поверь, он не всегда был грозой океанов.
            DislikeNPC: Эта малявка, {NPCName}, думает, что знает всё об океане...
            LikeNPC_Princess: Кажется, всем нравится {NPCName}... странно.
            Princess_LovesNPC: "{NPCName} рассказывает просто невероятные истории о жизни под водой!"
        }

        Census.SpawnCondition: Одолейте [c/4dffb8:Королеву медуз].
        Button2: Воздушный баллон
    }

    Druid: {
        DisplayName: Друид
        BestiaryFlavorText: Друид с любовью относится к растениям всех видов. У неё можно приобрести семена и другие природные товары для ваших нужд.

        TownNPCMood: {
            Content: Я свежа как огурчик, спасибо, что спрашиваешь!
            NoHome: Ах, великолепная улица...
            FarFromHome: Ой, привет! Я тут собираю травы. Не вечно же сидеть дома, душа требует открытий!
            LoveSpace: Чувствую себя великолепно, словно одинокое дерево на вершине холма!
            DislikeCrowded: Разговаривать с растениями полезно, но даже им требуется тишина.
            HateCrowded: Слишком много людей! И дня не проходит без того, чтобы кто-то не потоптал мои растения!
            LikeBiome: Ожидаемо, наверное, но я обожаю джунгли. Да, можно сказать, я здесь практически выросла!
            DislikeBiome: В этих снегах мои цветы не растут!.. Ну ладно, один тут растёт, но это не считается!
            HateBiome: Сомневаюсь, что в этом мерзком месте может хоть что-то цвести.
            LikeNPC: С самого детства я мечтала встретить дриаду. И вот удача, здесь есть {NPCName}!
            DislikeNPC: Чёртов {NPCName} своей взрывчаткой только и делает, что поджигает траву!
            HateNPC: Кхе-кхе... {NPCName} со своими приборами создаёт столько пара и дыма, что у меня уже голова кружится...
            LikeNPC_Princess: "{NPCName} - ну просто цветочек. Нельзя ненавидеть девушку, которая способна созывать лесных зверушек своим пением!"
            Princess_LovesNPC: "{NPCName} собирает самые красивые цветочные букеты!"
        }

        Census.SpawnCondition: Одолейте [c/4dffb8:{$NPCs.CorpseBloom.DisplayName}].
    }

    EarthenBat: {
        DisplayName: Земляная летучая мышь
        BestiaryFlavorText: Редкий вид летучей мыши, наделённой силой самой земли. Она предпочитает висеть на потолке, поджидая свою следующую жертву.
    }

    EarthenGolem: {
        DisplayName: Земляной голем
        BestiaryFlavorText: Эта разумная груда камней способна вызывать сейсмические толчки в пещерах, обрушивая камни на головы своих жертв.
    }

    EpiDermon: {
        DisplayName: Толстокожец
        BestiaryFlavorText: Доказательство зловещего влияния багрянца. Даже демоны не могут устоять перед ним.
    }

    FireAnt: {
        DisplayName: Муравей-солдат
        BestiaryFlavorText: Огромный муравей с жгучим укусом. Будьте благодарны, что вам не довелось наткнуться на его родное гнездо!
    }

    FlamekinCaster: {
        DisplayName: Огненный заклинатель
        BestiaryFlavorText: Необычное существо, черпающее силу из лавовых бассейнов, найденных в глубинах пещер, для призыва взрывоопасных огненных летучих мышей.
    }

    Freezer: {
        DisplayName: Замораживатель
        BestiaryFlavorText: Обитатели искажённого снежного биома охотятся с помощью леденящих кислот, вызывающих жжение и обморожение.
    }

    FrostFangWall: {
        DisplayName: Морозный клык
        BestiaryFlavorText: Этот ледяной паук стреляет льдом вместо паутины. Это связано не с его неспособностью плести паутину, а с его природной тематикой.
    }

    FrostWurmHead: {
        DisplayName: Морозный червь
        BestiaryFlavorText: Хотя снег и лёд копать легче, чем эбонит, эти ледяные пожиратели ничуть не менее смертоносны.
    }

    FrozenFace: {
        DisplayName: Замороженный лицемонстр
        BestiaryFlavorText: Мозг Ктулху предупреждал их: если они не перестанут гримасничать, их лица останутся навсегда искажёнными.
    }

    FrozenGross: {
        DisplayName: Замороженная мерзотина
        BestiaryFlavorText: Эти ледяные ужасы из глубин багряного льда несомненно являются одновременно замороженными и отвратительными.
    }

    GelatinousCube: {
        DisplayName: Желатиновый куб
        BestiaryFlavorText: Обжорливый сгусток слизи, зародившийся в гнилой атмосфере Темницы. Он утратил способность прыгать под тяжестью своих грехов.
    }

    GelatinousSludge: {
        DisplayName: Тина
        BestiaryFlavorText: Отпрыск желатинового куба, отделившийся от него. Он сохранил способность прыгать, избавившись от грехов своего родителя.
    }

    GildedBat: {
        DisplayName: Золотистая летучая мышь
        BestiaryFlavorText: Эта редкая разновидность летучих мышей обладает внушительными размерами и силой. Она способна летать с тяжёлым, ценным металлом на крыльях, а также наносить серьёзные травмы охотникам, осмелившимся её преследовать.
    }

    GildedLycan: {
        DisplayName: Золотистый ликан
        BestiaryFlavorText: Хотя оборотней традиционно считают уязвимыми к серебру, существование золотистых ликанов ставит это утверждение под сомнение.
    }

    GildedSlime: {
        DisplayName: Золотистый слизень
        BestiaryFlavorText: Этот слизень маскируется под более редкого золотого слизня, чтобы целиком проглотить жадных охотников за сокровищами.
    }

    GildedSlimeling: {
        DisplayName: Золотистая слизняшка
        BestiaryFlavorText: Золотистые слизни поглощают большое количество золота для получения блестящего окраса, поэтому их детёныши также содержат кусочки оставшейся руды.
    }

    GlitteringGolem: {
        DisplayName: Сверкающий голем
        BestiaryFlavorText: Массивный земляной элементаль, наделённый благословением. Его крупные кристаллы придают освящению особый блеск.
    }

    GoblinDrummer: {
        DisplayName: Гоблин-барабанщик
        BestiaryFlavorText: Громкий и яростный ритм барабанщиков возвещает о приближении армии гоблинов, вселяя в их собратьев боевой дух.
    }

    GoblinSpiritGuide: {
        DisplayName: Гоблин-проводник душ
        BestiaryFlavorText: Обладая эзотерическими проклятиями, эти высшие шаманы способны воскрешать недавно погибших гоблинов, чтобы те продолжали свои набеги.
    }

    GoblinTrapper: {
        DisplayName: Гоблин-ловец
        BestiaryFlavorText: Один из немногих гоблинов в мире, кто решился использовать колючие шары - традиционное оружие своего народа.
    }

    GoldDuck: {
        DisplayName: Золотая утка
        BestiaryFlavorText: "{$CommonBestiaryFlavor.GoldCritter}"
    }

    CoalescedEnergy: {
        DisplayName: Сгусток энергии
        BestiaryFlavorText: Энергетический барьер, созданный для отражения атак, направленных на ядро Энергетического шторма.
    }

    EncroachingEnergy.DisplayName: Надвигающаяся энергия
    EnergyBarrier.DisplayName: Энергетический барьер
    EnergyConduit.DisplayName: Энергетический проводник

    GraniteEnergyStorm: {
        DisplayName: Гранитный энергетический шторм
        BestiaryFlavorText: Неуправляемый эпицентр энергетического всплеска в гранитных пещерах, вызванный снятием проклятия со Скелетрона.
        BossChecklistIntegration.SpawnInfo: Используйте [i:ThoriumMod/UnstableCore] глубоко под землёй в гранитных пещерах или найдите и одолейте нестабильную энергетическую аномалию.
    }

    UnstableEnergyAnomaly: {
        DisplayName: Нестабильная энергетическая аномалия
        BestiaryFlavorText: Из земли вырывается шар энергии, который, кажется, может взорваться при малейшем воздействии.
    }

    GraniteEradicator: {
        DisplayName: Гранитный изничтожитель
        BestiaryFlavorText: Этот безумный элементаль яростно размахивает двумя парами заряжённых рук. Он не проиграл ни одного армрестлинга за последние семь лет.
    }

    GraniteFusedSlime: {
        DisplayName: Пропитанный гранитом слизень
        BestiaryFlavorText: Слизень, пронизанный хаотичной энергией гранитных пещер. А ещё он носит стильный комплект каменной брони.
    }

    GraniteSurger: {
        DisplayName: Гранитоменталь
        BestiaryFlavorText: Неконтролируемый элементаль земли, метающий магнитные гранитные осколки в нарушителей покоя гранитных пещер.
    }

    HealingDummy.DisplayName: Исцеляемый манекен

    HellBringerMimic: {
        DisplayName: Адский мимик
        BestiaryFlavorText: Мимики, одержимые душами проклятых, обретают невероятную силу. Они способны рождаться силой из обычных сундуков.
    }

    HoppingSpider: {
        DisplayName: Прыгучий паук
        BestiaryFlavorText: Этот маленький малыш обожает лакомиться спелеологами, которые неосторожно подходят слишком близко к его гнезду.
    }

    HorrificCharger: {
        DisplayName: Ужасающий налётчик
        BestiaryFlavorText: Маленькие охотники искажения, обладающие способностью к быстрому ускорению, бросаются на потенциальную добычу с безрассудной яростью.
    }

    IllusionGlass.DisplayName: Иллюзорное стекло

    Illusionist: {
        DisplayName: Иллюзионист
        BestiaryFlavorText: Колдун, чей возраст превосходит возраст самой Темницы. С помощью иллюзий он заставил древнего тирана обречь своё царство на гибель, наложив на него страшное проклятие.
        BossChecklistIntegration.SpawnInfo: Появляется случайным образом в Темнице. Для повторного призыва используйте [i:ThoriumMod/IllusionaryGlass], которое продаёт Растерянный зомби.
    }

    IllusionistMirror.DisplayName: Зеркало Иллюзиониста

    InfernalHound: {
        DisplayName: Инфернальная гончая
        BestiaryFlavorText: Любит обжигать всех, кого видит, своими лавовыми поцелуями. Настоящий друг обречённых.
    }

    LeFantome: {
        DisplayName: Призрак
        BestiaryFlavorText: Отверженный террарийцами из-за своего облика, этот музыкант в маске наделяет своих союзников-упырей силой с помощью завораживающей песни.
    }

    Lich: {
        DisplayName: Лич
        BestiaryFlavorText: Трупный ученик осквернителя жизни, всегда ищущий новые души для своей коллекции.

        BossChecklistIntegration: {
            SpawnInfo: Используйте [i/s{0}:{1}] на Древней филактерии на кладбище за Темницей.
            EntryName: "{$NPCs.Lich.DisplayName}"
        }
    }

    PhylacteryofaThousandSouls: {
        DisplayName: Филактерия тысячи душ
        BestiaryNameOverride: Филактерия тысячи душ
        BestiaryFlavorText: Источник вечной жизни Лича. В нём заключено не менее тысячи душ, но Лич давно сбился со счёта.
    }

    LifeCrystalMimic: {
        DisplayName: Мимик-кристалл жизни
        BestiaryFlavorText: Сила Террарии обладает своеобразным чувством юмора.
    }

    LihzardMimic: {
        DisplayName: Яхщеровый мимик
        BestiaryFlavorText: Вторгшийся вид мимиков, проникший в Храм. Яхщеры, похоже, не возражают...
    }

    LihzardPotMimic1: {
        DisplayName: Яхщеровый горшок
        BestiaryFlavorText: Обманчивая ловушка, расставленная для потенциальных браконьеров таинственного Храма.
    }

    LivingHemorrhage: {
        DisplayName: Живое кровоизлияние
        BestiaryFlavorText: Жуткая тератома, сотканная из самой плоти багрянца. Оно не собирается просто так сдаваться.
    }

    Lycan: {
        DisplayName: Ликан
        BestiaryFlavorText: Более массивная форма оборотня, становящаяся всё более агрессивной по мере приближения к смерти. Возможно, он был бодибилдером до укуса.
    }

    MahoganyEnt: {
        DisplayName: Энт из красного дерева
        BestiaryFlavorText: Одушевлённая масса красного дерева, чья цель - защищать джунгли от тех, кто угрожает их флоре.
    }

    MartianScout: {
        DisplayName: Марсианский разведчик
        BestiaryFlavorText: Этот пришелец прибыл исследовать окружающую среду и стать предвестником грядущих событий.
    }

    MartianSentry: {
        DisplayName: Марсианский страж
        BestiaryFlavorText: Защитная машина, сопровождающая марсианских разведчиков.
    }

    MoltenMortar: {
        DisplayName: Раскалённая мортира
        BestiaryFlavorText: Сверхмутировавшая магматическая улитка, получившая способность метать горящие обломки в свою добычу.
    }

    MossWasp: {
        DisplayName: Мшистая оса
        BestiaryFlavorText: Этот шершень перенасыщен цветочной энергией, что приводит к значительному увеличению его агрессии и скорости.
    }

    MudMan: {
        DisplayName: Грязевой человек
        BestiaryFlavorText: Первобытная форма жизни, рождённая из джунглевой грязи и знающая лишь одно: её дом должен быть защищён.
    }

    MyceliumMimic: {
        DisplayName: Мицелиевый мимик
        BestiaryFlavorText: Питание светящимися грибами наделяет мимиков повышенными способностями. Их можно насильно заставить появиться из обычных сундуков.
    }

    Myna: {
        DisplayName: Майна
        BestiaryFlavorText: Невинная и редкая птица, которая может стать вашим верным спутником, если вам удастся её поймать.
    }

    NecroPot: {
        DisplayName: Некрогоршок
        BestiaryFlavorText: Темница хранит в себе огромное количество духовной энергии. Неудивительно, что часть этой энергии решила вселиться в один или два горшка.
    }

    Nestling: {
        DisplayName: Птенец
        BestiaryFlavorText: Вид пернатых, предпочитающих жить вместе с гарпиями, заботиться о птенцах и швырять камни в любопытных террарийцев.
    }

    OpalBunny: {
        DisplayName: Опаловый кролик
        BestiaryFlavorText: "{$CommonBestiaryFlavor.GemBunny}"
    }

    OpalSquirrel: {
        DisplayName: Опаловая белка
        BestiaryFlavorText: "{$CommonBestiaryFlavor.Squirrel}"
    }

    PeculiarMirror: {
        DisplayName: Необычное зеркало
        BestiaryFlavorText: На вид это обычное, но изысканное зеркало из Темницы. Наверняка, если подойти к нему поближе, ничего плохого не случится. Или всё-таки случится?
        Button: Дотронуться
        WarningFallback: Что-то приближается!
    }

    Aquaius: {
        DisplayName: Акваус, Бесконечный прилив
        BestiaryNameOverride: Акваус
        BestiaryFlavorText: Бесконечный прилив реальности, Акваус воплощает силы, противоборствующие друг другу во Вселенной. Он будет судить тех, кого сочтёт достойными своего внимания.
    }

    AquaiusBubble.DisplayName: Пузырь Аквауса
    ImpendingDread.DisplayName: Надвигающийся ужас
    InnerDespair.DisplayName: Внутреннее отчаяние
    LucidBubble.DisplayName: Ясный пузырь

    Omnicide: {
        DisplayName: Омницид, Осквернитель жизни
        BestiaryNameOverride: Омницид
        BestiaryFlavorText: Порабощающий жизнь разрушитель реальности, Омницид воплощает в себе все преобразования во Вселенной. Он будет судить тех, кого сочтёт достойными своего внимания.
    }

    DreamEater: {
        DisplayName: Пожиратель снов
        BestiaryFlavorText: Космический чистильщик. Угасающая реальность. Пожиратель снов. Эта сущность стремится уничтожить всё, что считает угрозой для космического порядка. Спаси мир, герой!
    }

    SlagFury: {
        DisplayName: Шлаковый яростень, Изначальное пламя
        BestiaryNameOverride: Яростный шлак
        BestiaryFlavorText: Первый огонь бытия, Шлаковый яростень является воплощением всей энергии Вселенной. Он будет судить тех, кого сочтёт достойными своего внимания.

        BossChecklistIntegration: {
            EntryName: Первородные
            SpawnInfo: Используйте [i:ThoriumMod/DoomSayersCoin] и готовьтесь к худшему...
        }
    }

    UnstableAnger.DisplayName: Нестабильный гнев

    DistractingJellyfish: {
        DisplayName: Отвлекающая медуза
        BestiaryFlavorText: Синяя медуза, которая охотно принимает удары ради своей королевы.
    }

    QueenJellyfish: {
        DisplayName: Королева медуз
        BestiaryFlavorText: Некогда обычная медуза, но что-то из самых тёмных глубин вызвало у неё небывалый рост, силу и агрессию.
        BossChecklistIntegration.SpawnInfo: Используйте [i:ThoriumMod/JellyfishResonator] днём в океане.
    }

    SpittingJellyfish: {
        DisplayName: Плюющаяся медуза
        BestiaryFlavorText: Жёлтая медуза, которая выпускает пузырьки в врагов ради своей королевы.
    }

    ZealousJellyfish: {
        DisplayName: Ревностная медуза
        BestiaryFlavorText: Красная медуза, которая с яростью таранит врагов ради своей королевы.
    }

    RagingMinotaur: {
        DisplayName: Разъярённый минотавр
        BestiaryFlavorText: Свирепые быки бродят по запутанным коридорам Темницы, несясь с такой силой, что могут сбить с ног любого, кому не повезло оказаться на их пути.
    }

    ScissorStalker: {
        DisplayName: Преследователь с ножницами
        BestiaryFlavorText: Бесполезно пытаться спрятаться от этого убийцы с ножницами. Когда он найдёт вас, вы будете уверены, что он может телепортироваться.
    }

    BioCore: {
        DisplayName: Био-ядро
        BestiaryFlavorText: Защитный зонд, уничтожающий любое существо, которое мешает флагману выполнять свою цель.
    }

    CryoCore: {
        DisplayName: Крио-ядро
        BestiaryFlavorText: "{$NPCs.BioCore.BestiaryFlavorText}"
    }

    PyroCore: {
        DisplayName: Пиро-ядро
        BestiaryFlavorText: "{$NPCs.BioCore.BestiaryFlavorText}"
    }

    StarScouter: {
        DisplayName: Звёздный разведчик
        BestiaryFlavorText: Наблюдательный аппарат с далёкой планеты. Его средства защиты являются чрезвычайно высокотехнологичными по меркам этого мира.
        BossChecklistIntegration.SpawnInfo: Используйте [i:ThoriumMod/StarCaller] высоко в небе.
    }

    SeaShantySinger: {
        DisplayName: Певец морских баллад
        BestiaryFlavorText: Пираты - это сорванцы и хулиганы, но когда звучит морская баллада, они становятся ещё более воинственными!
    }

    ShadowflameRevenant: {
        DisplayName: Отражение теневого пламени
        BestiaryFlavorText: Воскрешённый боевой дух павшего гоблина. Их жажда добычи не угасает даже после смерти.
    }

    Shambler: {
        DisplayName: Скиталец
        BestiaryFlavorText: В прошлом угнетённые узники, эти закованные в кандалы скелеты готовы переложить свой груз на плечи тех, кто их победит.
    }

    SnowBall: {
        DisplayName: Снежный шар
        BestiaryFlavorText: Эти ребята превратили обычную снежную битву в настоящее сражение.
    }

    SnowEater: {
        DisplayName: Пожиратель снега
        BestiaryFlavorText: Даже ледяной холод не может остановить этих злобных существ, которые всегда рады полакомиться слабыми.
    }

    SnowFlinxMatriarch: {
        DisplayName: Снежный флинкс-матриарх
        BestiaryFlavorText: Необычный предводитель необычного существа. В своей шерсти он обычно прячет детёнышей, а также различные предметы. Как это необычно.
    }

    SnowSinga: {
        DisplayName: Снеговик-певун
        BestiaryFlavorText: На первый взгляд, этот мафиози празднует, но на самом деле он вдохновляет своих подельников отправить вас на тот свет.
    }

    SoulCorrupter: {
        DisplayName: Извращатель душ
        BestiaryFlavorText: Доказательство зловещего влияния искажения. Даже демоны не могут устоять перед ним.
    }

    SpaceSlime: {
        DisplayName: Космический слизень
        BestiaryFlavorText: Как оказалось, слизни существуют и на других планетах. Кто бы мог подумать!
    }

    Spectrumite: {
        DisplayName: Спектрумит
        BestiaryFlavorText: Разросшийся кристаллический осколок, ставший стражем, призванным изгонять незваных террарийцев из освящения.
    }

    Spiritualist: {
        DisplayName: Спиритуалист
        BestiaryFlavorText: Спиритуалист убеждён, что основа силы кроется во внутреннем спокойствии. Террарийцы, желающие научиться исцелять своих союзников, могут многому у него научиться.

        TownNPCMood: {
            Content: Моя душа в равновесии, друг.
            NoHome: Дом - для меня несусветная роскошь, но если ты его предложишь, я буду крайне признателен.
            FarFromHome: Не всё потеряно для того, кто странствует, друг.
            LoveSpace: Здесь прекрасно и спокойно, друг.
            DislikeCrowded: Я ощущаю от других лёгкие эманации дискомфорта. Думаю, им нужно больше пространства.
            HateCrowded: Здесь определённо тесно. Нам необходимо больше места, чтобы расти духовно и личностно.
            LikeBiome: Ах, что за великолепное место, наполненное духовной энергией.
            DislikeBiome: ем глубже я спускаюсь под землю, тем сильнее ощущаю тёмную энергию... Это мне не по душе.
            HateBiome: Что произошло с духами в этих местах?.. Это отвратительно!
            LoveNPC: "{NPCName} делает великолепные стрижки. Это здорово помогает мне самовыражаться!"
            LikeNPC: "{NPCName} и я всю ночь обсуждали философию. Его мудрость действительно впечатляет."
            DislikeNPC: Хотя {NPCName} решил поддержать нас, он демон, а демоны известны своей лживостью, друг...
            HateNPC: "{NPCName} - человек, заботящийся лишь о себе... Мы с ним никогда не найдём общего языка."
            LikeNPC_Princess: "{NPCName} своей жизнерадостной невинностью поднимает всем настроение."
            Princess_LovesNPC: "{NPCName} обладает такой умиротворяющей аурой!"
        }

        Census.SpawnCondition: Одолейте [c/4dffb8:Погребённого чемпиона].
        Button2: Ангел-хранитель
    }

    StrangeBulb: {
        DisplayName: Загадочный бутон
        BestiaryFlavorText: Причудливое растение, которое ещё не достигло зрелости. Возможно, это даже к лучшему...
    }

    SunPriestess: {
        DisplayName: Жрица солнца
        BestiaryFlavorText: Яхщер, наделённый силой солнца. Является отличным источником света в тёмных залах Храма.
    }

    TarantulaWall: {
        DisplayName: Тарантул
        BestiaryFlavorText: Высокозащищённая разновидность арахнидов, выпускающая острые шипы при угрозе. Возможно, содержит ДНК дикобраза.
    }

    TempleGuardian: {
        DisplayName: Защитник Храма
        BestiaryFlavorText: Солнечный автоматон, созданный для наблюдения за залами загадочного храма и их охраны с чрезвычайной решимостью.
    }

    TheInnocent: {
        DisplayName: Непорочный
        BestiaryFlavorText: огда-то это безобидное создание мирно обитало в лесах Террарии, пока распространение тёмного искажения не добралось до него.
    }

    TheStarved: {
        DisplayName: Изголодавший
        BestiaryFlavorText: Это слюнявое существо утратило рассудок, одержимое бесконечным и мнимым голодом.
    }

    StormHatchling: {
        DisplayName: Штормовой птенец
        BestiaryFlavorText: Электрически заряжённое проявление юной Громовой птицы.
    }

    TheGrandThunderBird: {
        DisplayName: Великая громовая птица
        BestiaryFlavorText: Благословлённая владычеством над бурями, эта величественная птица парит в небесах пустыни. Кажется, она испытывает вас...
        BossChecklistIntegration.SpawnInfo: Используйте [i:ThoriumMod/GrandFlareGun] вместе с [i:ThoriumMod/StormFlare] днём в пустыне.
    }

    Tracker: {
        DisplayName: Следопыт
        BestiaryFlavorText: Следопыт принадлежит к ордену воинов, посвятивших себя поиску и уничтожению редких существ. Если вы поможете ему, он непременно отблагодарит вас.

        TownNPCMood: {
            Content: Малыш, мне особенно не на что жаловаться.
            NoHome: Если у меня будет дом, мы сможем приступить к делу и начать охоту на настоящие угрозы.
            FarFromHome: Эй, малыш. Береги себя, тут опасно.
            LoveSpace: Куча места, где я могу размахивать топором, никого не задевая, - чудесно!
            DislikeCrowded: Я начинаю ощущать лёгкую клаустрофобию...
            HateCrowded: С моими габаритами и так сложно ходить, а тут ещё и куча народа!
            LikeBiome: Ах, люблю снег - он навевает воспоминания о доме. Мой народ обожает северный холод.
            DislikeBiome: Нелегко выслеживать монстров, когда живёшь в настолько безопасном месте.
            HateBiome: Знаешь, я бы сказал 'давай перейдём к делу', но кажется, здесь СЛИШКОМ опасно...
            LoveNPC: Если кто-то здесь может побороться со мной в армрестлинге, то это {NPCName}. Обожаю этого парня!
            LikeNPC: Если кто-то знает своё дело, то это {NPCName}.
            DislikeNPC: "{NPCName} без умолку жалуется, что пачкает свою мантию, вместо того чтобы выполнять работу. Не фанат такого."
            HateNPC: "{NPCName} не понимает, насколько важно стоять и сражаться. Аж тошно."
            LikeNPC_Princess: Именно ради таких, как {NPCName}, мы делаем то, что делаем.
            Princess_LovesNPC: "Когда {NPCName} катает меня на спине, я ощущаю себя такой высокой!"
        }

        Census.SpawnCondition: Одолейте {$NPCName.EyeofCthulhu}.
        Button: Потратить медали
        Button2: Доступные контракты
    }

    UFO: {
        DisplayName: Н.Л.О.
        BestiaryFlavorText: Небольшой зонд, посланный инопланетной силой для разведки поверхности планет, которые те считают достойными завоевания.
    }

    UnderworldPot1: {
        DisplayName: Горшок преисподней
        BestiaryFlavorText: Этот мимик думал, что в безлюдной и пустой Темнице он наконец-то сможет найти покой и уединение. Но теперь он чувствует себя просто обманутым.
    }

    VileFloater: {
        DisplayName: Парящий нечестивец
        BestiaryFlavorText: Злокачественные образования, обретшие разум благодаря тёмным чарам, извергают ядовитую слюну на всех, кто по неосторожности оказался рядом.
    }

    WeaponMaster: {
        DisplayName: Оружейный мастер
        BestiaryFlavorText: Оружейный мастер - это демонический изгнанник, примкнувший к силам добра. Не дайте его суровому виду обмануть вас - он настоящий добряк.

        TownNPCMood: {
            Content: ...Я в порядке.
            NoHome: Я и сам справляюсь, хотя предпочёл бы иметь дом...
            FarFromHome: Обо мне не беспокойся...
            LoveSpace: Ничего не имею против других, но наслаждаюсь своим домом. Мне просто приятно.
            DislikeCrowded: Вокруг слишком много людей...
            HateCrowded: Пожалуйста, скажи мне, что у тебя есть другое место, где я могу жить...
            LikeBiome: Я прекрасно понимаю, что мне нельзя приближаться к преисподней... Будто это меня остановит.
            DislikeBiome: Это место навевает плохие воспоминания, которые я предпочёл бы забыть.
            HateBiome: Мерзкое место. Лучше тебе иметь при себе хорошее оружие...
            LoveNPC: Ах, {NPCName}. Знакомым лицам всегда рады. Передай ему привет.
            LikeNPC: "{NPCName} своей компанией навевает спокойствие. Мы идём схожими путями..."
            DislikeNPC: "{NPCName} прячет свою истинную личность от других. Не люблю это отсутствие честности..."
            HateNPC: Гха... Даже когда {NPCName} просто рядом, одно его присутствие обжигает мою кожу.
            LikeNPC_Princess: "{NPCName} такая жизнерадостная, что может вызвать улыбку даже на МОЁМ лице."
            Princess_LovesNPC: "{NPCName} такой милый. Он создаёт для меня маленькие огоньки, когда мне холодно!"
        }

        Census.SpawnCondition: Одолейте [c/4dffb8:Падшего Созерцателя].
        Button2: Нанять демона ({^0:8 золотых;10 золотых})
    }

    WindElemental: {
        DisplayName: Элементаль ветра
        BestiaryFlavorText: Свободные магические потоки, витающие высоко в воздухе, иногда принимают облик этих раздражительных существ. Они могут весьма неприятно поразить мощным разрядом террарийцев, не подозревающих об их присутствии.
    }
}

Prefixes: {
