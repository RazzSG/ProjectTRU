    Rambling.DisplayName: Бессвязный
    Refined.DisplayName: Настроенный
    Supersonic.DisplayName: Сверхзвуковой
    Vibrant.DisplayName: Вибрирующий

    Engrossing: {
        DisplayName: Захватывающий
        Tooltip: "{0} {^0:секунда;секунды;секунд} к длительности усиления"
    }

