            Критические удары высвобождают дополнительный вой сирены в направлении курсора
            '''
    }

    TheIncubator: {
        DisplayName: Инкубатор
        Tooltip:
            '''
            Призывает зловещий монолит, который постоянно призывает глубинщиков
