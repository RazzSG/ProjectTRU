Items: {
    AbyssalShadow: {
        DisplayName: Глубинная тень
        Tooltip: ""
    }

    AbyssalShadow2: {
        DisplayName: Глубинная тень
        Tooltip:
            '''
            Призывает существо, давно забытое временем
            Можно использовать только в морских глубинах
            '''
    }

    AbyssalShell: {
        DisplayName: Глубинный панцирь
        Tooltip:
            '''
            Нажатие клавиши '{$Keybinds.Encase.DisplayName}' помещает вас в непроницаемый панцирь
            Внутри панциря вы не можете использовать предметы или лечебные зелья, регенерация здоровья значительно снижена, а наносимый вами урон почти нулевой
            Выход из панциря существенно снижает скорость передвижения, сопротивление урону и наносимый урон в течение короткого времени
            После выхода из панциря вы сможете повторно воспользоваться им через 20 секунд
            '''
    }

    ForgottenOneMask: {
        DisplayName: Маска Забытого
        Tooltip: ""
    }

    ForgottenOneTrophy: {
        DisplayName: Трофей Забытого
        Tooltip: ""
    }

    MantisShrimpPunch: {
        DisplayName: Удар креветки-богомола
