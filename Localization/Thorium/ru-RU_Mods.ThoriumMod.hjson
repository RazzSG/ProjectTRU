    JungleFlower.MapEntry: Цветок джунглей
    LargeCoral.MapEntry: Коралл
    LivingLeafBush.MapEntry: Лиственный куст
    LodeStone.MapEntry: Магнетит
    MarkedGraveTile.MapEntry: Помеченная могила
    MarkedGraveTileTrue.MapEntry: "{$Tiles.MarkedGraveTile.MapEntry}"
    OceanCrystal.MapEntry: Акватический кристалл
    ThoriumOre.MapEntry: Торий
    AquaticDepthsBiomeChest.MapEntry_Locked: Запертый сундук акватических глубин
    DesertBiomeChest.MapEntry_Locked: Запертый пустынный сундук
    UnderworldChest.MapEntry_Locked: Запертый сундук преисподней
    ValadiumChunk.MapEntry: Валадий
    
    WorldEngineTile: {
        MapEntry: Мировой механизм
        NoJourneyMode: Вы не можете использовать это в режиме Путешествия, используйте вместо этого его ползунок сложности.
        Consume: Расходует [i/s{0}:{1}] для изменения сложности мира
        ChangeMode: Переключает сложность в {0}
    }

    AncientPhylactery: {
        NightRequirement: Похоже, оно ждёт наступления ночи...
        MechBossRequirement: Похоже, что оно дремлет...
    }
    
    WorldEngineTile.MapEntry: "{$Items.WorldEngine.DisplayName}"
    FurnitureVanillaCup.MapEntry: Декоративая ванильная чашка
}

Keybinds: {
    ArmorAbility.DisplayName: Способность брони
    AccessoryAbility.DisplayName: Способность аксессуара
    ThrowingTechnique.DisplayName: Метательная техника
    Encase.DisplayName: Обволакивание
}

MonsterContracts: {
    AlmostContract: {
        Title: Продолжение следует...
        Description: Сначала завершите все оставшиеся контракты...
    }

    BoneLeeContract: {
        Title: Конец следопыта
        Description: Парень, у меня есть для тебя особый контракт. Ты должен взяться за это всерьёз, так что выслушай меня. Много лет назад я и мой напарник Ли исследовали мир вместе. Мы были непобедимым дуо, но совершили фатальную ошибку, недооценив один особенно сложный контракт. В отчаянной попытке спасти меня он был сражён в залах Темницы, где, вероятно, гниёт до сих пор. Я никогда не прощу себя за это... Пожалуйста, отправься в Темницу и даруй его измученной душе покой.
        DescriptionCompleted: Ты оказал мне такую услугу, которую невозможно отплатить даже за тысячу жизней. Как бы мне хотелось встретиться с Ли лицом к лицу и извиниться... Уверен, ты уже давно превзошёл нас в силе. Быть униженным выскочкой, как ты, - это действительно отрезвляет. В качестве благодарности у меня есть коллекция оружия, которым Ли часто пользовался. Уверен, он был бы польщён, если бы ты использовал это оружие в бою. Береги себя там!
    }

    CursedContract: {
        Title: Зачарованное противостояние
        Description: Наверняка ты знаешь, что неконтролируемая духовная магия может привести к различным последствиям, включая одержимость оружия и доспехов. Сама идея одержимости пугает, но когда одержимыми оказываются мощные артефакты, ситуация становится ещё более опасной... Будь начеку, чтобы не встретить агрессивно зачарованные оружия, скрывающиеся глубоко под землёй.
    }

    DangerContract: {
        Title: Изучение основ
        Description: Итак, парень, я думаю, нам стоит начать с чего-нибудь простого... Я выследил группу диких существ глубоко под землёй. В своих подземных приключениях ты можешь столкнуться с грозными существами, известными как речные раки, саламандры и гигантские ракушечники. Убийство нескольких из них сделало бы мир намного безопаснее и позволило бы мне спокойно спать по ночам.
        DescriptionCompleted: Неплохо справился, парень. Надеюсь, ты не потратил слишком много времени на эту охоту. Ты наверняка заметил, что из них выпали 'Медали покорителя'. На эти медали ты можешь купить у меня различные предметы. Как правило, они относятся к выслеженному существу, так что обязательно загляни ко мне после выполнения любого контракта.
    }

    DoctorContract: {
        Title: След пропавшего расхитителя
        Description: Многие искатели приключений отваживались пройти сквозь густые заросли джунглей, но лишь немногие вернулись. Я отправил своего друга, Доктора Бонса, на миссию в джунгли некоторое время назад, но он так и не вернулся... Не мог бы ты ночью обследовать поверхность джунглей и поискать какие-либо следы его присутствия?
    }

    GildedContract: {
        Title: Час расплаты
        Description: В недрах Террарии появились светящиеся существа, освещающие путь к разрушению. Золотистая летучая мышь, золотистый ликан и золотистая слизь озаряют окрестности и представляют немалую угрозу. Было бы лучше, если бы их численность хоть немного сократилась...
    }

    HagContract: {
        Title: Измождённые торгаши
        Description: Многие пытаются найти кратчайшие пути к обретению могущества, зачастую взывая к элементам. Хотя элементы и могут исполнить их желания, за их помощь приходится платить высокую цену. В мире существуют так называемые Колдуньи, которые странствуют по миру, пытаясь вернуть свою проданную молодость. Они обычно встречаются в преисподней, джунглях, океане и небе. Сделай нам одолжение - отыщи и убей одну из них.
    }

    HardmodeContract: {
        Title: Продолжение следует...
        Description: Победите ужасающую Стену плоти, чтобы продолжить...
    }

    IceContract: {
        Title: Крушитель льда
        Description: На этот раз лучше надеть что-то потеплее, парень. Этот автоматон, собранный из самого холодного льда, какой только можешь себе представить, появляется только во время сильных метелей. Его смертельные морозные лучи могут превратить тебя в ледяную глыбу, если ты не будешь осторожен, так что не прекращай двигаться и прячься за укрытиями!
    }

    MimicContract: {
        Title: Золото дураков
        Description: Не знаю, чем ты там занимался, парень, но всё стало гораздо неспокойнее. После того как освободившиеся духи заполнили этот мир, теперь нельзя ничему доверять! Хуже того, похоже, что какие-то наиболее алчные духи завладели коллекцией сундуков глубоко под землёй, превращая их в мимиков. Будь внимателен, если где-то поблизости окажутся сундуки - они могут оказаться совсем не тем, чем кажутся...
    }

    MinotaurContract: {
        Title: Чудовище лабиринта
        Description: В Темнице и без того полно опасностей, вроде скелетов и слизней, но с появлением Разъярённого минотавра ситуация становится ещё более непростой. Этот зверь способен мчаться с невероятной скоростью, оставляя врага ослеплённым и парализованным, если тот не будет внимателен. Будь бдительным и не дай ему застать тебя врасплох, парень.
    }

    MothContract: {
        Title: Понадобится лампа побольше
        Description: Не заблуждайся, парень, то существо, которое скрывается в подземных джунглях, - это несомненно создание чудовищной природы, а не источник красоты. Его сущность - живое свидетельство нашей человеческой гордыни. Это... мотылёк!
    }

    MothronContract: {
        Title: Истребление чудовищ
        Description: Когда луна полностью заслоняет солнце, ужас, живущий внутри нас, высвобождается в этот мир. Мой самый большой страх принял облик мотылька-мутанта! Но помни, парень, не мы выбираем свои страхи...
    }

    NymphContract: {
        Title: Девица бедствий
        Description: У тебя доброе сердце, парень. Не дай этому контракту погубить тебя... В глубинах снежных пещер скрывается существо, маскирующееся под беззащитную молодую девушку. Но как только ты подойдёшь достаточно близко, то поймёшь, что она вовсе не беззащитна. Прикончи её, если найдёшь!
    }

    PigronContract: {
        Title: Захрючен до смерти
        Description: Свинроны - это довольно причудливый гибрид существ, состоящий на 50% из свиньи, на 50% из дракона и на 100% из злобы. Ты можешь встретить их там, где оледенелые пещеры сталкиваются с заражением. Будь осторожен в их присутствии, ибо пустые животы свинронов издают очень громкие звуки.
    }

    PinkyContract: {
        Title: Пинки, Вестник конца
        Description: Я никогда раньше не слышал о существе с такой ужасающей силой... Оно розовое, злобное и путешествует по миру в сопровождении мощной бури слизи. Его необходимо уничтожить!
    }

    PirateShipContract: {
        Title: Просьба пьяного моряка
        Description: Слышал ли ты сказки о пиратах и их ненасытной жажде золота? Они улавливают запах золотых монет за многие километры, а у тебя, судя по всему, их довольно много. Я бы держал ухо востро, потому что они обязательно нападут. Заставь их пожалеть об этом, потопив один из их Летучих голландцев.
    }

    RecluseContract: {
        Title: Не совсем крошка-паучок
        Description: Ну что ж, парень, на этот раз у меня для тебя двойной контракт. Похоже, многие из наших жителей страдают от арахнофобии. Пошли слухи о 'Коричневом отшельнике', бродящем в паучьих пещерах, но, похоже, единственный способ выманить его из укрытия - это ТАКЖЕ устранить какого-то оледенелого 'Гигантского паука', который рыщет по тундре во время сильных метелей. Если ты сможешь справиться с обоими, жители этого места будут чувствовать себя гораздо безопаснее.
    }

    RuneContract: {
        Title: Обрезка рун
        Description: После победы над Стеной плоти высвободилась неконтролируемая энергия, которая дала некоторым неприятным существам огромный прирост силы. Один разбойник-скелет овладел силой древних запечатанных духов и теперь терроризирует подземелье как Руномант. Его сила нестабильна и непредсказуема; мы не можем допустить, чтобы он остался в живых!
    }

    SandContract: {
        Title: Черта в песке
        Description: Личность элементалей сильно зависит от среды, в которой они формируются. С учётом того, что песчаные бури бывают грубыми, опасными и неприятными, ты можешь только представить, почему мы решили уничтожить несколько песчаных элементалей. Смотри в оба, чтобы какой-нибудь зубастый монстр не откусил тебе голову, парень!
    }

    TimContract: {
        Title: Заклинатель теней
        Description: Я сумел выследить в глубинах нашего мира довольно неуловимого тёмного заклинателя по имени... {$NPCName.Tim}. Несмотря на имя, он обладает значительной силой, но у него есть одна существенная слабость. По-видимому, он очень гордится своим нарядом и считает его выдающимся. Может быть, стоит надеть одеяние из драгоценных камней, чтобы привлечь его?..
    }

    WyvernContract: {
        Title: На гребне перемен
        Description: Ветры перемен скоро настигнут нас, но боюсь, они не принесут ничего хорошего... Зловредное гнездо виверн нашло путь на ближайшие небесные острова, парящие прямо над нашими головами. Я считаю, что всем будет лучше, если мы избавимся хотя бы от части из них.
    }
}

Common: {
    Concatenate: "{0} {1}"
    ConcatenateNoSpace: "{0}{1}"
    Empty: ""

    Tooltips: {
        TheBlackItem: С каждым попаданием по цели накапливается увеличивающийся урон, и враги изнуряются при достижении 50 стаков
        DevItem: "'Отлично подходит для подражания внешности разработчиков Thorium!'"
        ShoulderGuardianLimit: Одновременно можно призвать только одного плечевого стража
        BannerPlacement: Размещает одно знамя на земле
        BigInstrument:
            '''
            При ошибках в ритме ударов бонусы значительно снижаются и требуют 5 единиц вдохновения
            Бонусы сохраняются при переключении оружия, но медленно угасают, если оно не используется
            Оружие автоматически нацеливается на ближайшего врага
            '''

        CookFood: {
            OutOfCombat: Можно съесть только вне боя
            WillMakeFull: При поедании блюд {$NPCs.Cook.DisplayName}а вы насытитесь на {0}
            EatWhileFull: Вы не сможете съесть блюдо {$NPCs.Cook.DisplayName}а, будучи сытым
        }

        Sheath: Если держать меч в руках и не использовать его в течение {1} {^1:секунды;секунд}, то при следующей атаке он нанесёт критический удар в размере {0}%
        InvalidMeleeItemForSheath: Это оружие несовместимо с ножнами
        
        Bard: {
            InstrumentTag: -{0} инструмент-
            ClassTag: -Бард-
            InspirationCost: Использует {0} {^0:очко;очка;очков} вдохновения
        }
    }

    TreasureBag: Мешок с сокровищами ({0})
    ThePrimordials: Первородные
    MusicBox: Музыкальная шкатулка ({0})
}

DeathText: {
    MartyrChalice: "{0} жертвует собой ради высшего блага."
    TheGauntlet: "{0} рассыпается в пыль..."
    AmmutsebaSash: "{0} поглощается тьмой..."
    ShadeMasterMaskSet: "{0} цепляется за жизнь до последней возможности."
    LastStand: "{0} выкладывается до последнего, но не выживает."
    HungeringBlossom: "{0} поглощается тьмой..."
    Destabilized: "{0} облучается с головы до пят."
    GraveLimb: "{0} не 'постиг' суть ситуации."
    Liquefied: "{0} превращается в жидкость."
    GravitySurge: "{0} не выдерживает гранитной энергии."
}

ThrowerTechniques: {
    DisplayName: Техника: {0}
    TooltipBase: Нажмите клавишу '{$Keybinds.ThrowingTechnique.DisplayName}': {0}
    CostTooltip: Использует {0} {^0:очко;очка;очков} техники
    UseToEnable: Устанавливает активную технику при использовании | Наносите метательный урон для накопления очков
    UseToDisable: Техника активна | Нажмите повторно, чтобы отключить | Наносите метательный урон для накопления очков

    AbsoluteZero: {
        DisplayName: Абсолютный нуль
        Description: На короткое время замораживает всех врагов вокруг курсора
    }

    BlindingDash: {
        DisplayName: Ослепляющий рывок
        Description: Совершает рывок вперёд, оглушая ближайших врагов на своём пути
    }

    BloodLotus: {
        DisplayName: Кровавый лотос
        Description:
            '''
            Вы замираете на месте и выпускаете поток ножей в ближайшего врага
            Каждый нож восстанавливает вам до 10% здоровья от нанесённого урона
            '''
    }

    CobraBite: {
        DisplayName: Укус кобры
        Description:
            '''
            Бросает разброс токсичных клыков, которые накладывают дебафф «{$BuffName.Venom}» на поражённых врагов
            Имеется гарантированный шанс нанести критический удар врагам, подвержённым дебаффу «{$BuffName.Poisoned}» или «{$BuffName.Venom}»
            '''
    }

    Decoy: {
        DisplayName: Приманка
        Description:
            '''
            Призывает вражескую приманку
            Приманка попытается привлечь внимание ближайших врагов
            '''
    }

    GravityWell: {
        DisplayName: Гравитационная воронка
        Description: Призывает гравитационную воронку в позиции курсора, которая засасывает ближайших врагов
    }

    HiddenBlade: {
        DisplayName: Скрытое лезвие
        Description: Выпускает наносящее урон лезвие в направлении курсора
    }

    LastStand: {
        DisplayName: Последний шанс
        Description:
            '''
            Автоматически срабатывает при получении смертельного урона, давая вам {0} {^0:секунду;секунды;секунд} неуязвимости
            Во время неуязвимости увеличивает скорость и урон метательных атак на {1}%, но по истечении времени действия вы умираете
            '''
    }

    MeteorStomp: {
        DisplayName: Метеоритный топот
        Description:
            '''
            Швыряет себя вниз, отталкивая врагов на своём пути
            Защищает от урона при падении, если используется для приземления на блок
            '''
    }

    StickyExplosive: {
        DisplayName: Липкая взрывчатка
        Description: Бросает липкую бомбу, которая взрывается после небольшой задержки
    }

    ShadowClone: {
        DisplayName: Теневой клон
        Description: Призывает теневого клона-ниндзя, который кратковременно атакует ближайших врагов
    }

    ShadowDance: {
        DisplayName: Танец теней
        Description: Телепортирует на позицию курсора
    }

    SmokeBomb: {
        DisplayName: Дымовая бомба
        Description: Бросает дымовую бомбу, которая на короткое время делает вас неуязвимым
    }

    SoulPulse: {
        DisplayName: Волна души
        Description: Выпускает волну души, оглушая ближайших врагов и увеличивая урон, который они получают
    }

    Sprint: {
        DisplayName: Спринт
        Description: На короткое время значительно увеличивает скорость передвижения
    }

    StonePalm: {
        DisplayName: Каменная длань
        Description: Бросает каменную руку, которая на мгновение блокирует входящие вражеские снаряды
    }
}

Configs: {
