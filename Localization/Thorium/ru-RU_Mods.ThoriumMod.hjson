        Tooltip: Выпускает расширяющуюся звуковую волну
    }

    MidnightBassBooster: {
        DisplayName: Полночный басовый усилитель
        Tooltip: Высвобождает оглушительно громкие звуковые импульсы
    }

    MixTape: {
        DisplayName: Микстейп
        Tooltip:
            '''
            Ваш симфонический урон на короткое время опаляет поражённых врагов
            Симфонические критические удары вызывают извержение раскалённых музыкальных нот
            '''
    }

    Mouthpiece: {
        DisplayName: Мундштук
        Tooltip:
            '''
            Увеличивает скорость симфонической игры на инструменте на {0}%
            Атаки ваших духовых инструментов теперь стремятся быстрее нацеливаться на врагов
            Если атака уже нацелена на врага, она делает это быстрее
            '''
    }

    MusiciansHandbook: {
        DisplayName: Справочник музыканта
        Tooltip:
            '''
            'Подходит для тех, кто действительно хочет научиться играть музыку'
            Ваши инструменты не расходуют вдохновение, не наносят урона и не могут быть сыграны неправильно
            Ваш бонус к симфонической скорости игры на инструменте зависит от того, в каком слоте экипирован справочник в аксессуарах
            '''
        InstrumentPlaySpeed: Ваши музыкальные инструменты играют на {0}% быстрее
    }

    MusicNotes: {
