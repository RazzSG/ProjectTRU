            ThrownItem: {
                ALittleHelp: Помогите... Кто-нибудь?
                ComeBack: Ты ещё вернёшься... со временем.
            }
    
            Storage: {
                CantSee: Здесь ничего не видно.
                WhatAboutReaping: Что с жатвой?
                StirsWrath: Это только разжигает мой гнев.
                MuchToKill: Ещё столько всего нужно убить!
            }
    
            PickedUp: {
                ReapingBegun: Жатва началась!
                ILive: Я живу, чтобы сеять смерть!
            }
        }
    }
    
    FreshBrain: {
        DisplayName: Свежие мозги
        Tooltip:
