Configs: {
    ReforgeClientConfig: {
        DisplayName: Клиентская конфигурация Reforge

        OceanShape: {
            Label: Форма океана
            Tooltip:
                '''
                Определяет алгоритм генерации океана.
                По умолчанию используется тип «Кусочная_V».
                Генерация «Кусочная_V» рекомендуется для прохождений с модом Spirit.
                '''
        }

        SurfaceWaterTransparency: {
            Label: Прозрачность воды на поверхности
            Tooltip:
                '''
                При включении этой настройки делает воду в океане прозрачной.
                Не влияет на другие биомы.
                '''
        }
    }

    OceanShape: {
        Tooltip: ""
        Default: {
            Label: Стандартная
            Tooltip: ""
        }
    
        SlantedSine: {
            Label: Наклонная синусоида
            Tooltip: ""
        }
    
        Piecewise: {
            Label: Кусочная
            Tooltip: ""
        }
    
        Piecewise_M: {
            Label: Кусочная_M
            Tooltip: ""
        }
    
        Piecewise_V: {
            Label: Кусочная_V
            Tooltip: ""
        }
    }

    ReforgedServerConfig: {
        DisplayName: Серверная конфигурация Reforge

        VentCritters: {
            Label: Живность возле гидротермальных источников
            Tooltip:
                '''
                При включении этой настройки вокруг гидротермальных источников появляется живность.
                Это не влияет на частоту появления обычных врагов, но учитывается в общем лимите НИПов.
                '''
        }

        MaxFloatingItemCount: {
            Label: Лимит плавающих предметов
            Tooltip: Определяет максимальное количество плавающих предметов, которые могут одновременно существовать в мире.
        }
    }
}

Generation: {
    Discoveries: Добавление новых открытий...
    Stargrass: Выращивание звёздной травы...
    HerosMemorial: Установка памятника герою...
    Butterfly: Скрытие святилищ бабочек...
    FishingCoves: Добавление рыболовных мест...
    PopulateOcean: Заселение океана...
    Gravel: Размещение гравия...
    SavannaTerrain: Создание плато...
    SavannaObjects: Заселение саванны...
    Ecotones: Картографирование переходных зон...
    Caves: Украшение пещер...
    NeonMosses: Светящийся мох...
    Pottery: Раскидывание горшков...
    Scarecrow: Размещение пугал...
    
    Signs: {
        Underground: {
            Common: {
                0: <wavy>В горшках скрыта тайна...
                1: <wavy>Текст слишком выцвел, чтобы его можно было прочитать.
                2: <colorful:255,80,80>Табличка исписана неразборчивыми каракулями, оставленными какой-то подозрительной жидкостью.
                3: <wavy>......ый торговец
                4: <wavy>Старая табличка почти рассыпалась в прах.
                5: <wavy>Грубо нарисованный скелет манит к себе.
                6: <wavy>Если ты это читаешь, значит, я уже мёртв.
                7: Если ты это читаешь — у меня всё отлично!
                8: <wavy>Осторожно: черви
                9: На табличке написан какой-то бред, с трудом поддающийся пониманию. Читать дальше бессмысленно.
                10: Вся табличка исписана дварфскими письменами. Вы не можете ничего разобрать.
            }
    
            Rare: {
                0: <wavy>Соберите все мои страницы...
                1: Похоже, здесь нет ни одного слизняка. —Художник табличек
                2:
                    '''
                    <wavy>0
                    дней с момента инцидента в пещере
                    '''
            }
        }
    }
}

