ActiveSkills: {
    GrantsSkill: Даёт активное умение:
    GrantsSkillsPlural: Даёт активные умения:
    KeybindMenu: Нажмите {0}, чтобы назначить клавишу для умений
    Unequipped: Не экипировано! Использование невозможно!
    Unbound: Не назначено!
    BoundTo: Назначено на {0}!

    SpecialDashEffect: {
        DisplayName: Пчелиный рывок
        Tooltip: Выполняет короткий и быстрый пчелиный рывок в направлении курсора
    }
    
    BetsyDashEffect: {
        DisplayName: Рывок огненного шара
        Tooltip:
            '''
            Выполняет короткий и неуязвимой рывок огненного шара в направлении курсора
            Имеет общее время перезарядки с пчелиным рывком
            '''
    }
    
    DiveEffect: {
        DisplayName: Пикирующий удар
        Tooltip:
            '''
            Активируйте в воздухе для быстрого падения вниз
            По умолчанию срабатывает при двойном нажатии ВНИЗ, если не назначена другая клавиша для умений
            '''
    }
    
    GoldKeyEffect: {
        DisplayName: Золотой панцирь
        Tooltip:
            '''
            Заключает вас в золотой защитный панцирь
            Вы не сможете двигаться или атаковать, но будете неуязвимы к любому урону
            Нажмите клавишу ещё раз для досрочного выхода из панциря
            '''
    }
    
    ParryEffect: {
        DisplayName: Папирующий блок
        Tooltip:
            '''
            Удерживайте клавишу, чтобы встать в защитную стойку
            Примите стойку незадолго до удара, чтобы парировать атаку
            По умолчанию срабатывает при нажатии ПКМ, если не назначена другая клавиша для умений
            '''
    }
    
    StardustEffect: {
        DisplayName: Стазис звёздной пыли
        Tooltip:
            '''
            Останавливает время на несколько секунд
            Пока время остановлено, ваши миньоны продолжают атаковать
            '''
    }
    
    DebuffInstallKeyEffect: {
        DisplayName: Укрепление дебаффом
        Tooltip: Накладывает на вас дебаффы, которые дают различные эффекты в зависимости от используемого аксессуара
    }
    
    FrigidGemstoneKeyEffect: {
        DisplayName: Холодное заклинание
        Tooltip:
            '''
            Призывает блок льда в указанную позицию курсора
            В хардмоде накладывает дебафф «{$BuffName.Frostburn}»
            '''
    }
    
    BombKeyEffect: {
        DisplayName: Кромковая бомба
        Tooltip:
            '''
            Требует заряд, получаемый при увороте от атак
            Замораживает большинство врагов и снарядов
            '''
    }
    
    BulbKeyEffect: {
        DisplayName: Магическое очищение
        Tooltip:
            '''
            Снимает с вас большинство дебаффов, но обладает длительным временем перезарядки
            Кроме того, усиливает эффект постепенного урона для находящихся рядом врагов в 2 раза
            Время перезарядки уменьшается быстрее, если вы не атакуете
            '''
    }
    
    AmmoCycleEffect: {
        DisplayName: Смена боеприпасов
        Tooltip: Переключает используемые боеприпасы (работает из инвентаря или в слотах для украшений)
    }
    
    GladiatorBanner: {
        DisplayName: Знамя гладиатора
        Tooltip:
            '''
            Размещает воодушевляющее знамя, которое действует в течение 15 секунд
            Находясь рядом со знаменем, вы получаете невосприимчивость к отбрасыванию, а также увеличение сопротивления урону и наносимого урона на 8%
            Новое знамя можно разместить только после окончания действия предыдущего
            '''
    }
    
    PalmwoodEffect: {
        DisplayName: Пальмово-древесный страж
        Tooltip: Размещает пальмового стража, который бросает орехи во врагов
    }
    
    ForbiddenEffect: {
        DisplayName: Запретная буря
        Tooltip:
            '''
            Призывает древнюю бурю в место курсора, наносящую магический урон и урон призывателя
            Все снаряды, пролетающие через бурю, наносят на 20% больше урона
            Коснувшись бури, вы восстановите время полёта крыльев
            Новую бурю можно призывать повторно после того, как текущая коснётся земли
            '''
    }
    
    SpiritTornadoEffect: {
        DisplayName: Духовный смерч
        Tooltip:
            '''
            Призывает древний смерч, наносящий магический урон и урон призывателя
            Все снаряды, пролетающие через торнадо, наносят на 40% больше урона
            Торнадо слегка следует за курсором мыши
            '''
    }
}

